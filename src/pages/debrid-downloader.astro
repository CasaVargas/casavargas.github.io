---
import AppPage from '../layouts/AppPage.astro';
import { apps } from '../data/apps';

const app = apps.find((a) => a.slug === 'debrid-downloader')!;

const title = 'DebridDownloader — Open Source Debrid Download Manager';
const description =
  'A fast native desktop client for Real-Debrid, TorBox and Premiumize. Multi-threaded downloads, keyboard-first, full theme support. Built with Tauri, React and Rust. GPL-3.0, free and open source.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DebridDownloader',
  description,
  url: 'https://github.com/CasaVargas/DebridDownloader',
  operatingSystem: 'macOS, Windows, Linux',
  applicationCategory: 'UtilitiesApplication',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: {
    '@type': 'Organization',
    name: 'CasaVargas LLC',
    url: 'https://casavargas.app',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
};

const features = [
  {
    title: 'Multi-threaded downloads',
    desc: 'Saturate your connection with parallel download chunks, pulling maximum throughput from your debrid provider.',
  },
  {
    title: 'Real-Debrid, TorBox and Premiumize',
    desc: 'Works with all three providers, handling magnet links, torrents and direct URLs through their APIs.',
  },
  {
    title: 'Keyboard-first',
    desc: 'Navigate entirely with keyboard shortcuts — add links, manage downloads and change settings without touching the mouse.',
  },
  {
    title: 'Tauri and Rust',
    desc: 'Native performance with a small footprint. Tauri gives a real desktop app rather than a bundled browser, and the download engine is pure Rust.',
  },
  {
    title: 'Configurable trackers',
    desc: 'Add and manage custom trackers, with full control over how torrents are resolved before they reach your debrid provider.',
  },
  {
    title: 'Free and open source',
    desc: 'GPL-3.0 licensed. Read the code, fork it, contribute. No telemetry, no ads, no premium tier — and sponsorship is optional.',
  },
];
---

<AppPage
  app={app}
  title={title}
  description={description}
  ogImage="/DebridDownloader.png"
  tagline="Desktop download manager"
  intro="A fast, open-source desktop client for Real-Debrid, TorBox and Premiumize. Multi-threaded downloads, a keyboard-first interface, configurable trackers and full theme support — built with Tauri, React and Rust for a native experience on every platform."
  features={features}
  schema={schema}
  cta={{
    heading: 'Grab it from GitHub',
    body: 'GPL-3.0, free and open source. macOS, Windows and Linux.',
    label: 'GitHub',
    url: 'https://github.com/CasaVargas/DebridDownloader',
    secondary: { label: 'Sponsor', url: 'https://github.com/sponsors/prjoni99' },
  }}
/>
