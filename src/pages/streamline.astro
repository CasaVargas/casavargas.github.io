---
import AppPage from '../layouts/AppPage.astro';
import { apps } from '../data/apps';
import slHome from '../assets/streamline/home.png';
import slGrid from '../assets/streamline/live-tv-grid.png';
import slList from '../assets/streamline/live-tv-list.png';
import slDetail from '../assets/streamline/program-detail.png';
import slPlayer from '../assets/streamline/player-info.png';
import slVod from '../assets/streamline/vod.png';

const app = apps.find((a) => a.slug === 'streamline')!;

const title = 'Streamline — Native IPTV Player for Apple TV & Mac';
const description =
  'Streamline is a pure SwiftUI IPTV player for every Apple platform — Apple TV, Mac, iPhone, iPad and Vision Pro. TMDB metadata, a full EPG, multi-view PiP and fast channel switching.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Streamline',
  description,
  url: 'https://getstreamline.tv',
  operatingSystem: 'iOS, iPadOS, tvOS, macOS, visionOS',
  applicationCategory: 'MultimediaApplication',
  author: {
    '@type': 'Organization',
    name: 'CasaVargas LLC',
    url: 'https://casavargas.app',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/PreOrder',
  },
};

const features = [
  {
    title: 'One codebase, every Apple platform',
    desc: 'Pure SwiftUI across iPhone, iPad, Apple TV, Mac and Vision Pro — with a 10-foot interface on the TV and a pointer-and-keyboard one on the Mac, not a phone app stretched to fit.',
  },
  {
    title: 'TMDB metadata enrichment',
    desc: 'Channels and on-demand libraries come back with real artwork, cast, synopses and ratings pulled from TMDB, so a raw playlist turns into something browsable.',
  },
  {
    title: 'Full electronic programme guide',
    desc: 'A complete EPG with what is on now and next, so you can browse the schedule rather than flipping channels blind.',
  },
  {
    title: 'Multi-view picture-in-picture',
    desc: 'Keep several streams on screen at once — useful when more than one game matters on the same afternoon.',
  },
  {
    title: 'Fast channel switching',
    desc: 'Tuned so switching channels feels closer to cable than to a buffering web player.',
  },
  {
    title: 'Live sports',
    desc: 'Built with live sport in mind, where fast switching, an accurate guide and multi-view all matter at the same time.',
  },
];
---

<AppPage
  app={app}
  title={title}
  description={description}
  ogImage="/streamline/icon.png"
  tagline="Premium IPTV player"
  intro="Streamline is the IPTV player Apple would build. Pure SwiftUI across every Apple platform, with TMDB metadata enrichment, a full EPG, multi-view picture-in-picture, and channel switching faster than cable."
  features={features}
  shots={[slHome, slGrid, slList, slDetail, slPlayer, slVod]}
  schema={schema}
  cta={{
    heading: 'Coming soon',
    body: 'Follow along at getstreamline.tv for the release.',
    label: 'getstreamline.tv',
    url: 'https://getstreamline.tv',
  }}
/>
