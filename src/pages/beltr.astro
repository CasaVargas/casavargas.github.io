---
import AppPage from '../layouts/AppPage.astro';
import { apps } from '../data/apps';

const app = apps.find((a) => a.slug === 'beltr')!;

const title = 'Beltr — AI Karaoke for Mac, Windows & Linux';
const description =
  'Beltr turns your own music folder into a karaoke catalog. On-device AI separates the vocals, phones join by QR as wireless mics, and it plays CDG and MP3+G as-is. $19.99 once, no subscription.';

// price/availability reflect beltr.app: $19.99 one-time, 5 songs free to try.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Beltr',
  description,
  url: 'https://beltr.app',
  operatingSystem: 'macOS, Windows, Linux',
  applicationCategory: 'MultimediaApplication',
  author: {
    '@type': 'Organization',
    name: 'CasaVargas LLC',
    url: 'https://casavargas.app',
  },
  offers: {
    '@type': 'Offer',
    price: '19.99',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
};

const features = [
  {
    title: 'On-device vocal separation',
    desc: 'Add any MP3, FLAC or WAV and Beltr starts on it automatically. Separation takes a minute or two for a typical song — quicker on Apple Silicon, longer on an older CPU. Nothing is uploaded; the audio never leaves your machine.',
  },
  {
    title: 'Your library is the catalog',
    desc: 'Point Beltr at a music folder and every song in it becomes searchable by artist, album and genre. There is no separate karaoke catalog to buy from and nothing to prepare in advance.',
  },
  {
    title: 'Phones join by QR',
    desc: 'Start a room and Beltr puts a four-character code and a QR on the TV. Phones scan it to become wireless mics and remotes — no app to install, no pairing, no accounts.',
  },
  {
    title: 'Plays the formats you already own',
    desc: 'CDG and MP3+G discs, .kar and .mid files and Thai NCN songs play as-is, with lyrics and timing read straight from the file — legacy encodings and CJK fonts included. It exports back out to MP3+G, CDG and .kar too.',
  },
  {
    title: 'Multi-microphone support',
    desc: 'Connect several microphones for duets and group sessions, with independent volume per mic so a quiet singer and a loud one stay balanced.',
  },
  {
    title: 'Bought once',
    desc: '$19.99, one time. Five songs free with no card to try it, a 14-day refund if it is not for you, and no subscription — it runs on your computer, so there are no servers to rent and no reason to bill you monthly.',
  },
];

const steps = [
  {
    title: 'Connect a folder',
    desc: 'Point Beltr at your music folder, or import files directly. Beltr arrives with a song already prepared, so you can sing before you have imported anything.',
  },
  {
    title: 'It does the work',
    desc: 'Beltr strips the vocals, pulls the synced lyrics, maps the pitch and reads the key — on your own machine, one song at a time, entirely on its own. Expect a minute or two per song.',
  },
  {
    title: 'Start a room and sing',
    desc: 'A code and QR go up on the TV. Phones scan to join as mics and remotes, and the instrumental plays with lyrics on screen.',
  },
];
---

<AppPage
  app={app}
  title={title}
  description={description}
  ogImage="/beltr-logo-text.svg"
  tagline="Karaoke engine for your own music library"
  intro="Beltr turns songs you already own into karaoke. On-device AI separates the vocals, pulls the synced lyrics and maps the pitch — then phones join by QR as wireless mics. Nothing uploads, and there is no catalog to buy from."
  features={features}
  steps={steps}
  schema={schema}
  cta={{
    heading: 'Ready to sing?',
    body: 'Five songs free, no card. Mac, Windows and Linux.',
    label: 'Get Beltr',
    url: 'https://beltr.app',
  }}
/>
