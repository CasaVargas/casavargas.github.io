---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Facts from '../components/ui/Facts.astro';
import Shot from '../components/ui/Shot.astro';
import Composition from '../components/ui/Composition.astro';
import { bySlug } from '../data/work';
import books from '../assets/deckle/books-done.jpg';
import daily from '../assets/deckle/daily-today.png';
import delivery from '../assets/deckle/daily-delivery.png';
import weather from '../assets/deckle/paper/weather.jpg';
import reading from '../assets/deckle/paper/reading.jpg';

// Deckle's product page: it has no domain of its own. Deckle is the app for your
// e-ink reader (PLAN.md §16): the Daily leads, books second (§14). Every claim comes
// from the Deckle README, docs/devices.md, the changelog and its `roadmap` issues. The
// paper imagery is a demo edition built by Deckle's own code, with a fictional town;
// never invented news about a real place. Pre-alpha: never "works with every Kindle"
// or "every reader"; Kobo, PocketBook and reMarkable are simulated-only until
// docs/devices.md says otherwise. Kindle Previewer is Amazon's, for Kindle books only,
// and never bundled. No DRM talk. No em dashes.
const item = bySlug('deckle');

const repo = 'https://github.com/CasaVargas/deckle';
const download = `${repo}/releases/latest`;
const issue = (n: number) => `${repo}/issues/${n}`;

const facts: [string, string][] = [
  ['Price', 'Free and open source, GPL-3.0-or-later'],
  ['Runs on', 'macOS 14 or later (Apple silicon and Intel), Windows 11'],
  ['Needs', 'An e-ink reader. Kindle books also need Kindle Previewer 4, free from Amazon; a Kobo, PocketBook or reMarkable needs nothing else.'],
  ['Status', 'Pre-alpha, version 0.6.0. Verified on a Kindle Scribe (2024) and a Kindle Paperwhite, other Kindles pending. Kobo, PocketBook and reMarkable are checked only against simulated devices so far.'],
];

const readers: [string, string][] = [
  ['Kindle', 'The paper and your books over USB, or the paper by email over Wi-Fi. Verified on a Scribe (2024) and a Paperwhite.'],
  ['Kobo', 'The paper, long reads and Inbox books as KEPUB, in a Deckle folder the first time it is plugged in. No Kindle Previewer.'],
  ['PocketBook', 'The same, as EPUB.'],
  ['reMarkable 2, Paper Pro, Paper Pro Move', 'The paper as a PDF laid out for its screen, crossword and all, to write on, uploaded over its USB web interface. No account.'],
  ['Boox, and any reader that takes a folder', 'An export folder (Dropbox, a USB drive) gets each edition as an EPUB or PDF, plugged in or not.'],
  ['iPad', 'An export folder in iCloud Drive reaches the Files app, with the photos in color.'],
];

const paper = [
  { title: 'The front page is the cover', body: 'Deckle sets a front page every morning, with the masthead, the date, the weather and the lead headlines, and makes it the cover. Your Kindle’s library tile is today’s paper.' },
  { title: 'Whole stories, with photos', body: 'Every story comes in full, pulled from the publisher the way Reader View does, with its photos turned grayscale for e-ink. Nothing sends you to a browser. A story behind a paywall stays a headline.' },
  { title: 'Your town, your feeds', body: 'The weather from Open-Meteo, local news from a Google News search and any local paper’s feed, then each RSS or Atom feed you add as its own section, in the order you choose.' },
  { title: 'The back pages', body: 'A horoscope Deckle writes itself, On this day from Wikipedia, and the Powerball and Mega Millions numbers, if you want them.' },
  { title: 'Tomorrow’s paper, so far', body: 'The Daily tab opens on the next edition: a press bar with a countdown and a Stop the presses button, a live sketch of the front page that fills in as you save articles and your feeds post, a page plan you drag to reorder, and the week’s reads.' },
  { title: 'A puzzle and an almanac', body: 'A five by five mini crossword whose theme answers are yesterday’s headlines, a word ladder, and a weather page with sunrise and sunset worked out on your Mac, the usual first frost, the moon and the meteor shower of the night.' },
  { title: 'From Your Shelf', body: 'A page drawn from your own Kindle: the books you are in the middle of, a past highlight, and the words you looked up this week. It stays on your Mac, and one button forgets it.' },
  { title: 'Every edition kept', body: 'The Morgue keeps each edition in a folder you can see, with the stories’ text, for a year. Browse a month of front pages, search them, see how far you read, and send an old one back to the Kindle.' },
  { title: 'Nothing to sign up for', body: 'No keys, no accounts, no subscription. A source that fails prints “unavailable today” and the paper still comes out.' },
  { title: 'A real newspaper on e-ink', body: 'Sections in order, an index inside, and navigation from section to story, so it reads like a paper, not a pile of links.' },
  { title: 'An editor, if you want one', body: 'Off by default. Turned on, an AI model you choose groups the same story told by several feeds, writes a short brief for each section and the horoscope. Its text is labeled, and the stories themselves are never touched.' },
];

const storeBook = [
  { title: 'Enhanced Typesetting', body: 'The typesetting store books get, produced by Amazon’s own converter, Kindle Previewer, which Deckle drives for you.' },
  { title: 'A cover that stays', body: 'Sideloaded covers tend to turn grey once a Kindle goes online. Deckle picks, per Kindle, how to keep yours.' },
  { title: 'X-Ray and Word Wise', body: 'The people and terms in the book, with optional descriptions from an AI model you choose, and Word Wise hints pointing at the Kindle’s own dictionary.' },
  { title: 'Page numbers and real metadata', body: 'Approximate page numbers from the text, and missing titles, authors and series filled from Open Library if you turn that on.' },
];

const coverRule: [string, string][] = [
  ['Kindles that show as a USB drive', 'Features and the cover: Deckle writes its own cover thumbnail and restores it on every send.'],
  ['Kindles that only speak MTP (Scribe 2024, Colorsoft, Paperwhite 2024)', 'The cover wins, unless the book matches a real Amazon edition. Then you can have both.'],
  ['Exported to a folder', 'The cover wins.'],
];

const network: [string, string, string][] = [
  ['The paper’s sources: Open-Meteo, a Google News search, your feeds and saved links, Wikipedia’s On this day', 'Each edition you build', 'Off until set up'],
  ['The paper by email, through your own mail account', 'Each morning paper', 'Off'],
  ['A check for a newer Deckle, on GitHub; nothing installs without a click', 'When the app starts', 'On'],
  ['Word Wise dictionary, 12 MB, from Deckle’s own releases', 'Once, the first time a book gets Word Wise', 'On'],
  ['Descriptions for X-Ray, from Anthropic or any OpenAI-compatible endpoint, including a local Ollama', 'Each book with features', 'Off'],
  ['The paper’s optional editor, through the same kind of endpoint', 'Each edition, once turned on', 'Off'],
  ['Wikipedia summaries for X-Ray terms', 'Each book with features', 'Off'],
  ['Amazon edition lookup and missing book details, through Open Library', 'Books sent', 'Off'],
];

const onKindle = [
  { title: 'Upgrade what is already there', body: 'Deckle reads the AZW3 and MOBI books on your Kindle and, when it finds the original in your calibre library or a folder you name, rebuilds it with Enhanced Typesetting, page numbers, X-Ray and Word Wise. The Kindle’s own copy is kept with its highlights, and Put back undoes it. Store books and anything with DRM are never touched.' },
  { title: 'A shelf you can read', body: 'Every book on the Kindle with its cover, a progress bar and when you last opened it, filtered by Reading, Finished, Sideloaded and more, and searchable.' },
  { title: 'Make room', body: 'See the space split by kind, then clear finished books over 10 MB, second copies of a book and old papers.' },
  { title: 'Back up and restore', body: 'Copy every DRM-free book and its highlights and reading position to your computer, and put a backup on any Kindle later. Amazon’s own books are left out.' },
  { title: 'A library beside the queue', body: 'The Books tab shows your library, with covers from calibre and your folders, search, series grouped with the gaps called out, and what a given Kindle does not have yet. Before you send, click a book to see what Deckle will do, a before and after of the typography, and a cover you can swap.' },
];

const moreBooks = [
  { title: 'PDFs, reflowed', body: 'A text PDF becomes a Kindle book that reflows: columns read in order, running heads and page numbers dropped, broken words joined, tables and equations kept as pictures cut from the page. A scan is refused, with the reason.' },
  { title: 'Word documents, text files and web articles', body: 'Drop a .docx, a .txt or a link on the window and it is built and sent like an EPUB, its row showing the title and author it imports with.' },
  { title: 'Your notes as a book', body: 'A Markdown file, or a flat folder of notes, becomes one book: headings, tables, local images and the links between notes, with a chapter per file.' },
  { title: 'Bind several files into one book', body: 'EPUBs, Word documents, PDFs and web articles made into one book, in the order you choose, with a contents list that runs through every part. Good for a course packet.' },
  { title: 'Three book styles', body: 'Novel, Academic or Manual, chosen per book: the paragraph style, pop-up notes, pages and X-Ray set the way that kind of book reads, with a before and after of the first page.' },
  { title: 'Looked-up words to Anki', body: 'Every English word you looked up on the Kindle, as flashcards with a short definition, the sentence and the book.' },
];

// Mirrors the Deckle changelog's Unreleased list (PLAN.md §15). Delete items as they ship.
const building = [
  'Many papers from one Mac: a paper per reader in the house, each with its own title, sections, schedule and days',
  'Large print: a layout for big type, with one photo a story and the forecast one day a line',
  'Several Kindles in one home: name each one and send a book to “Mom’s Kindle”, where it waits until that Kindle connects',
  'DRM-free Kindle books (.mobi, .azw3) rebuilt as real KFX, with page numbers, X-Ray and Word Wise',
  'RTF, OpenDocument and FictionBook files as books, the way Word documents already are',
];

const considering = [
  { n: 20, title: 'Comics, manga and picture books, kept fixed-layout' },
  { n: 25, title: 'Structure recovery for messy Word documents and PDFs' },
  { n: 29, title: 'Optional AI extras: a summary, a glossary, a series recap' },
  { n: 19, title: 'Scanned PDFs, read by OCR and reflowed' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Deckle',
  description: item.tagline,
  url: 'https://casavargas.app/deckle/',
  downloadUrl: download,
  codeRepository: repo,
  operatingSystem: 'macOS, Windows',
  applicationCategory: 'UtilitiesApplication',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: { '@type': 'Organization', name: 'Casa Vargas LLC', url: 'https://casavargas.app' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Layout
  title="Deckle | The app for your e-ink reader"
  description="Deckle is the free, open-source app for your e-ink reader. Every morning it builds a real newspaper on your own computer, from your town's news and weather, your feeds and your saved reading, and puts it on your Kindle, Kobo, PocketBook or reMarkable. It also turns the books you own into Kindle books that read like the store's. Mac and Windows."
  ogImage="/og/deckle.png"
>
  <JsonLd data={schema} />
  <Nav />

  <main id="main" class="dk">
    <section class="dk-open" aria-labelledby="dk-title">
      <div class="lamp" aria-hidden="true"></div>
      <div class="wrap dk-open__inner">
        <p class="dk-mark">
          <Image src={item.icon!} alt="" widths={[64, 128]} sizes="64px" format="webp" quality={84} loading="eager" fetchpriority="high" class="dk-mark__icon" />
          <span class="dk-mark__name">Deckle</span>
        </p>

        <h1 id="dk-title" class="statement">
          <span class="statement__line">The app for</span>
          <span class="statement__line">your e-ink reader.</span>
        </h1>

        <div class="dk-open__body">
          <p class="standfirst">
            Every morning Deckle sets a real newspaper on your own computer, from your
            town’s news and weather, your feeds and the articles you saved, and has it
            waiting on your Kindle, Kobo, PocketBook or reMarkable before you’re up. It
            also turns the books you own into Kindle books that read like the store’s.
            No account, no subscription, nothing sent anywhere.
          </p>
          <p class="dk-actions">
            <a class="dk-button" href={download} rel="noopener">Download Deckle</a>
            <a class="textlink" href={repo} rel="noopener">Source on GitHub</a>
          </p>
        </div>

        <Facts rows={facts} class="dk-open__facts" />
      </div>
    </section>

    <div class="wrap dk-lead">
      <Composition plate={item.plate!} eager />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-readers">
      <div>
        <h2 id="dk-readers" class="dk-h2">One paper, every e-ink screen</h2>
        <p class="dk-side">Deckle reads the reader you plug in and gives it the paper in the form it wants.</p>
      </div>
      <div class="dk-prose">
        <Facts rows={readers} class="dk-rule dk-rule--readers" />
        <p>
          Only Kindle books go through Kindle Previewer. The paper for a Kobo, PocketBook
          or reMarkable, and anything sent to a folder, needs nothing from Amazon.
        </p>
        <p>
          For a reader app of your own, an export folder can also hold each edition as
          data: a documented, versioned bundle with every story’s text, photos, the weather
          as numbers and the crossword with its answers. The spec is CC-BY-4.0 and the
          schema is MIT.
        </p>
        <p class="dk-note">
          Honest status: the Kobo, PocketBook and reMarkable paths are checked only against
          simulated drives and a stand-in server so far. A real one of each is still on the
          test list; a report from yours is welcome.
        </p>
      </div>
    </section>

    <div class="wrap dk-figure">
      <Shot shot={{ src: delivery, kind: 'window', alt: 'Deckle’s Daily tab, Delivery room: where the paper goes, with the Kindle, a reMarkable Paper Pro, an iPad folder in iCloud Drive and automatic Kobo and PocketBook support. Shown with a fictional setup.' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-paper">
      <div>
        <h2 id="dk-paper" class="dk-h2">A newspaper, not a feed</h2>
        <p class="dk-side">E-ink is the closest a screen gets to paper. Deckle gives it a paper worth reading.</p>
      </div>
      <dl class="dk-features">
        {paper.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="wrap dk-pages">
      <Shot shot={{ src: weather, kind: 'reader', alt: 'The weather page of The Morning Deckle on an e-reader: today, the days ahead and the moon' }} sizes="(max-width: 900px) 46vw, 24vw" />
      <Shot shot={{ src: reading, kind: 'reader', alt: 'Your Reading in The Morning Deckle on an e-reader: an article saved the evening before, printed whole' }} sizes="(max-width: 900px) 46vw, 24vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-doorstep">
      <h2 id="dk-doorstep" class="dk-h2">On the doorstep by 5:30</h2>
      <div class="dk-prose">
        <p>
          Pick a time and Deckle builds the paper every morning. Plug the reader in and
          today’s edition goes straight over, or let a Kindle get it over Wi-Fi by email
          through your own mail account. Only the newest three stay on the reader, so
          yesterday’s papers don’t pile up.
        </p>
        <p>
          A Mac asleep at 5:30 builds the paper when it wakes. The paper always keeps its
          front page as the cover, on every reader. The
          <a class="textlink" href={`${repo}/blob/main/docs/daily.md`} rel="noopener">Daily reference</a>
          has every setting.
        </p>
      </div>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-save">
      <h2 id="dk-save" class="dk-h2">Save it for tomorrow</h2>
      <div class="dk-prose">
        <p>
          Find something worth reading during the day and save it: with the bookmarklet in
          your browser, by dropping the link into Deckle’s Inbox folder, or from your iPhone
          with a Shortcut that saves to iCloud Drive. It prints in tomorrow’s paper as
          <strong>Your Reading</strong>, whole and with its photos. A long piece becomes its
          own book and rides along with the paper.
        </p>
      </div>
    </section>

    <div class="wrap dk-figure">
      <Shot shot={{ src: daily, kind: 'window', alt: 'Deckle’s Daily tab, in dark mode: Tomorrow’s paper, so far, a live sketch of the next front page beside the page plan and the week’s reads, with the Today, Editions, Reading, Delivery and The paper rooms down the left. Shown with a fictional town.' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section dk-act" aria-labelledby="dk-books">
      <div>
        <h2 id="dk-books" class="dk-h2">And every book you own, finished properly</h2>
        <p class="dk-side">The other half of Deckle, and where it started.</p>
      </div>
      <div class="dk-prose">
        <p>
          Books you load onto a Kindle yourself are second-class. Every fix exists as a
          separate plugin or forum recipe, and they fight each other. Deckle does all of it
          in one window: drop the books in, plug the Kindle in, press Send. A Kobo or
          PocketBook takes the books you drop in Deckle’s Inbox as they are.
        </p>
        <dl class="dk-features dk-features--tight">
          {storeBook.map((f) => (
            <div>
              <dt>{f.title}</dt>
              <dd>{f.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <div class="wrap dk-figure dk-figure--left">
      <Shot shot={{ src: books, kind: 'window', alt: 'Deckle’s Books tab: five public-domain novels finished for a connected Kindle, each with its X-Ray and Word Wise counts' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-more">
      <div>
        <h2 id="dk-more" class="dk-h2">More than EPUB</h2>
        <p class="dk-side">If you can read it, you can send it.</p>
      </div>
      <dl class="dk-features dk-features--tight">
        {moreBooks.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-cover">
      <h2 id="dk-cover" class="dk-h2">Covers and features pull in opposite directions</h2>
      <div class="dk-prose">
        <p>
          A Kindle only loads X-Ray and Word Wise for books it files as store books, and it
          gives a store book it doesn’t recognise a grey cover. Personal documents keep their
          cover but get neither feature. Deckle reads each Kindle when it connects and makes
          the choice for that device:
        </p>
        <Facts rows={coverRule} class="dk-rule" />
        <p>
          Word documents, plain text, web articles and finished KFX files go through the
          same pipeline. Choose a library folder and Deckle keeps every book you send as
          plain folders, and the Kindle tab shows what is on the device and what Deckle can
          now build better.
        </p>
      </div>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-kindle">
      <div>
        <h2 id="dk-kindle" class="dk-h2">And the books already on your Kindle</h2>
        <p class="dk-side">Deckle looks at what is there before it sends anything.</p>
      </div>
      <dl class="dk-features dk-features--tight">
        {onKindle.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-network">
      <div>
        <h2 id="dk-network" class="dk-h2">What goes over the network</h2>
        <p class="dk-side">Nothing about you, ever. No account, no subscription, no telemetry.</p>
      </div>
      <div class="dk-prose">
        <div class="dk-table-wrap">
          <table class="dk-table">
            <thead class="ui">
              <tr><th scope="col">What</th><th scope="col">When</th><th scope="col">Default</th></tr>
            </thead>
            <tbody>
              {network.map(([what, when, def]) => (
                <tr><td>{what}</td><td>{when}</td><td>{def}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="dk-note">
          A Kindle may itself ask Amazon about a book sent with features, because it carries an
          ASIN. That is the Kindle’s doing; sending as a personal document avoids it. A paper
          sent by email goes through Amazon, which typesets it its own way.
        </p>
      </div>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-install">
      <h2 id="dk-install" class="dk-h2">Install</h2>
      <div class="dk-prose">
        <ol class="dk-steps">
          <li>
            <h3>For a Kindle, install Kindle Previewer 4</h3>
            <p>
              It is <a class="textlink" href="https://kdp.amazon.com/en_US/help/topic/G202131170" rel="noopener">free from Amazon</a>.
              Deckle drives it to typeset Kindle books and the Kindle’s paper, and never
              bundles it. A Kobo, PocketBook or reMarkable skips this step.
            </p>
          </li>
          <li>
            <h3>Download Deckle</h3>
            <p>
              From the <a class="textlink" href={download} rel="noopener">latest release</a>.
              On a Mac, open the <code>.dmg</code> and drag Deckle to Applications; it is signed
              and notarized by Apple. On Windows, run the code-signed <code>-setup.exe</code>,
              which installs for your user with no admin. A new
              certificate can still bring up SmartScreen: choose More info, then Run anyway.
            </p>
            <p class="dk-note">
              From version 0.3.0 on, Deckle updates itself: the footer says when a new
              version is out, and Settings, About, Update installs it. Coming from 0.2.x,
              install the latest by hand once; on Windows, uninstall a 0.2.x <code>.msi</code> first.
            </p>
          </li>
          <li>
            <h3>Set up your paper, plug in your reader</h3>
            <p>
              Name the paper and pick your town and feeds on the Daily tab, then turn on the
              morning schedule. For books, drop EPUBs on the window and press Send to Kindle.
              Close calibre and Android File Transfer first: only one program at a time can
              talk to an MTP Kindle.
            </p>
          </li>
        </ol>

        <p>Everything the app does, the command line does too:</p>
        <pre class="dk-code"><code>deckle digest init
deckle digest run --to device
deckle digest schedule --at 05:30
deckle run book.epub --to device</code></pre>
        <p class="dk-note">
          Linux is unsupported for now: Kindle Previewer only runs on Mac and Windows, and
          the app is built for those. To build from source you need Rust, Node 22 and pnpm; the
          <a class="textlink" href={`${repo}#readme`} rel="noopener">README</a> has the details.
        </p>
      </div>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-bench">
      <div>
        <h2 id="dk-bench" class="dk-h2">On the bench</h2>
        <p class="dk-side">
          What is on main and not yet released, and what the open issues are weighing. No
          dates promised; every feature is designed in the open before it is built.
          <a class="textlink" href={`${repo}/issues?q=is%3Aopen+label%3Aroadmap`} rel="noopener">The whole roadmap</a>.
        </p>
      </div>
      <div class="dk-bench">
        <div>
          <h3 class="dk-bench__head ui">Being built right now</h3>
          <ul>
            {building.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="dk-bench__head ui">Being considered</h3>
          <ul>
            {considering.map((r) => <li><a class="textlink" href={issue(r.n)} rel="noopener">{r.title}</a></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-credits">
      <h2 id="dk-credits" class="dk-h2">Credits</h2>
      <div class="dk-prose">
        <p>
          Deckle stands on research and code from the MobileRead community: jhowell’s KFX Input
          and Output and kfxlib, of which Deckle’s KFX writer is a Rust port; jloutsch’s kfxgen;
          xxyzz’s WordDumb and Proficiency; seapy’s kindle-cli; calibre’s Kindle driver; and
          KindleUnpack, whose KF8 path the AZW3 rebuild follows. Word Wise definitions come
          from Wiktionary through kaikki.org, and word frequencies from wordfreq, both
          CC BY-SA 4.0. PDFs are read with PDFium. The paper’s weather comes from Open-Meteo
          and On this day from Wikipedia.
        </p>
        <p class="dk-note">
          The demo paper on this page is fictional: Linden Falls and its stories were made up
          for it. Its photos are public domain. Kindle Previewer is Amazon’s and is never
          bundled. Kindle is a trademark of Amazon.com, Inc.; Kobo, PocketBook, reMarkable
          and Boox belong to their makers. Deckle is not affiliated with any of them.
        </p>
      </div>
    </section>

