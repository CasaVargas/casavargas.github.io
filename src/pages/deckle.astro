---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Facts from '../components/ui/Facts.astro';
import Shot from '../components/ui/Shot.astro';
import { bySlug } from '../data/work';

import dailyToday from '../assets/deckle/app/daily-today.jpg';
import dailySections from '../assets/deckle/app/daily-sections.jpg';
import dailyDelivery from '../assets/deckle/app/daily-delivery.jpg';
import booksLibrary from '../assets/deckle/app/books-library.jpg';
import booksDrawer from '../assets/deckle/app/books-drawer.jpg';
import kindleShelf from '../assets/deckle/app/kindle-shelf.jpg';
import settingsOnline from '../assets/deckle/app/settings-online.jpg';
import front from '../assets/deckle/paper/front.jpg';
import story from '../assets/deckle/paper/story.jpg';
import weather from '../assets/deckle/paper/weather.jpg';
import puzzle from '../assets/deckle/paper/puzzle.jpg';

// Deckle's product page: it has no domain of its own (PLAN.md §13, §17). The paper leads,
// books second. Every claim comes from the Deckle README, docs/daily.md, docs/devices.md,
// the changelog and its `roadmap` issues, at the version below. The paper imagery is a demo
// edition built by Deckle's own code with a fictional town: never invented news about a real
// place. Pre-alpha: never "works with every Kindle" or "every reader"; Kobo, PocketBook and
// reMarkable are simulated-only until docs/devices.md says otherwise. Kindle Previewer is
// Amazon's, for Kindle books only, and never bundled. No DRM talk beyond "refused, never
// decrypted". No em dashes.
const item = bySlug('deckle');

// The release this page describes. Every screenshot is that release's UI.
const version = '0.7.0';

const repo = 'https://github.com/CasaVargas/deckle';
const download = `${repo}/releases/latest`;
const issue = (n: number) => `${repo}/issues/${n}`;
const pr = (n: number) => `${repo}/pull/${n}`;

const specs: [string, string][] = [
  ['Price', 'Free. GPL-3.0, no account, no telemetry'],
  ['Runs on', 'macOS 14+ and Windows 11'],
  ['Readers', 'Kindle, Kobo, PocketBook, reMarkable, or any folder'],
  ['Version', `${version}, pre-alpha`],
];

const paper = [
  { title: 'The front page is the cover', body: 'Masthead, date, weather and the lead headlines, set fresh each morning and made the book’s cover. The library tile on your reader is today’s paper.' },
  { title: 'Whole stories, with photos', body: 'Every story in full, pulled from the publisher the way Reader View does, photos turned grayscale for e-ink. Nothing sends you to a browser. A paywalled story stays a headline.' },
  { title: 'Your town, and what you follow', body: 'Weather from Open-Meteo, local news for your town, each RSS or Atom feed as its own section, and interests: “Rust” or “Carolina Panthers” searched every morning, kept only when a headline names it.' },
  { title: 'A puzzle and an almanac', body: 'A mini crossword whose theme answers are yesterday’s headlines, a word ladder, and a weather page with sunrise, sunset, the moon, the usual first frost and tonight’s meteor shower.' },
  { title: 'From Your Shelf', body: 'The books you are in the middle of, a past highlight and the words you looked up this week, read from your own Kindle. It stays on your computer, and one button forgets it.' },
  { title: 'Every edition kept', body: 'The Morgue keeps each paper in a plain folder for a year: a month of front pages to browse, full-text search, how far you read, and any old edition sent back to the reader.' },
];

const steps = [
  { title: 'Pick what goes in it', body: 'Your town, your feeds, the topics you follow and the articles you saved, in the order you want them. One list, saved as you go. A paper for each reader in the house, each with its own sections and days, if you want that.' },
  { title: 'Deckle sets it overnight', body: 'At the hour you choose, on your own computer. A Mac asleep at 5:30 builds the paper when it wakes. A source that fails prints “unavailable today” and the paper still comes out. Stop the presses skips a morning.' },
  { title: 'It is waiting when you wake', body: 'Plug the reader in and today’s edition goes straight over, or a Kindle gets it by email over Wi-Fi through your own mail account. Only the newest three stay on the reader.' },
];

const readers: [string, string][] = [
  ['Kindle', 'The paper and your books over USB, or the paper by email over Wi-Fi. Verified on a Scribe (2024) and a Paperwhite.'],
  ['Kobo', 'The paper, long reads and Inbox books as KEPUB. No Kindle Previewer.'],
  ['PocketBook', 'The same, as EPUB.'],
  ['reMarkable', 'The paper as a PDF laid out for its screen, crossword and all, to write on. Uploaded over its USB web interface, no account.'],
  ['Boox, iPad, anything', 'An export folder (iCloud Drive, Dropbox, a USB stick) gets each edition as EPUB or PDF, photos in color if you like.'],
];

const storeBook = [
  { title: 'Enhanced Typesetting', body: 'The typesetting store books get, from Amazon’s own Kindle Previewer, which Deckle drives for you.' },
  { title: 'A cover that stays', body: 'Sideloaded covers go grey once a Kindle is online. Deckle works out, per Kindle, how to keep yours.' },
  { title: 'X-Ray and Word Wise', body: 'The people and terms in the book, and Word Wise hints pointing at the Kindle’s own dictionary.' },
  { title: 'Page numbers', body: 'Real page numbers in the reader, and missing titles, authors and series filled from Open Library if you ask.' },
];

const coverRule: [string, string][] = [
  ['Kindles that show up as a USB drive', 'Features and the cover: Deckle writes its own cover thumbnail and puts it back on every send.'],
  ['MTP-only Kindles (Scribe 2024, Colorsoft, Paperwhite 2024)', 'The cover wins, unless the book matches a real Amazon edition. Then you get both.'],
  ['Exported to a folder', 'The cover wins.'],
];

const formats = [
  { title: 'Word, OpenDocument, RTF, FB2, text', body: 'Headings become the contents; tables and pictures come through, and footnotes become pop-up notes.' },
  { title: 'PDFs, reflowed', body: 'Columns read in order, running heads dropped, broken words joined. A scan is refused, with the reason.' },
  { title: 'DRM-free Kindle files', body: 'MOBI, AZW and AZW3 rebuilt as real KFX with page numbers, X-Ray and Word Wise. DRM-protected files are refused, never decrypted.' },
  { title: 'Markdown notes', body: 'A file or a folder of notes becomes one book: tables, local images, links between notes, a chapter a file.' },
  { title: 'Web articles', body: 'Paste a link and it is built like any other book, with its title and author.' },
  { title: 'Several files, one book', body: 'Bind PDFs, documents and articles in your order, with a contents list that runs through every part.' },
];

const onKindle = [
  { title: 'A shelf you can read', body: 'Every book on the Kindle with its cover, progress and when you last opened it, filtered and searchable. Unplugged, it shows the shelf as Deckle last saw it.' },
  { title: 'Upgrade what is there', body: 'Books calibre put on the Kindle are matched to their originals and rebuilt with everything above. The Kindle’s copy is kept with its highlights, and Put back undoes it.' },
  { title: 'Make room, back up', body: 'Space split by why: finished books, second copies, old papers. Back up every DRM-free book with its highlights and reading position.' },
  { title: 'Several Kindles, by name', body: 'Send a book to “Mom’s Kindle” while it is in her bag. It waits in the outbox until that Kindle connects.' },
];

const hood = [
  { title: 'KPF to KFX, in Rust', body: 'Kindle Previewer outputs a KPF, a zip around a SQLite database of Ion fragments. A Kindle wants a monolithic KFX. Deckle’s KFX writer is a Rust port of jhowell’s kfxlib, tested byte for byte against its output, so no Python is involved.' },
  { title: 'An MTP client of its own', body: 'macOS has no MTP stack, so Deckle speaks PTP/MTP over USB itself, with the Kindle’s quirks: the 32-bit ObjectInfo layout, zero-length packets after full data phases, and never creating a documents folder.' },
  { title: 'Word Wise holds no text', body: 'The sidecar stores only positions and sense ids into a dictionary already on the Kindle. Deckle matches the book against its own 174,000-sense lexicon from Wiktionary, so “Darcy” is never glossed as a unit of permeability.' },
  { title: 'Files, not a database', body: 'The library is Author/Title folders with a JSON file each. Every paper is kept as a folder. The settings are TOML you can edit. Uninstall Deckle and all of it is still yours, readable.' },
];

const network: [string, string, string][] = [
  ['The paper’s sources: Open-Meteo, a Google News search, your feeds and saved links, Wikipedia’s On this day', 'Each edition you build', 'Off until set up'],
  ['The paper by email, through your own mail account', 'Each morning', 'Off'],
  ['A check for a newer Deckle on GitHub; nothing installs without a click', 'When the app starts', 'On'],
  ['The Word Wise dictionary, 12 MB, from Deckle’s own releases', 'Once', 'On'],
  ['X-Ray descriptions and the paper’s editor, from Anthropic or any OpenAI-compatible endpoint, a local Ollama included', 'Each book or edition, once turned on', 'Off'],
  ['Wikipedia summaries for X-Ray', 'Each book with features', 'Off'],
  ['Book details and Amazon edition lookup, through Open Library', 'Books sent', 'Off'],
];

// What is open right now (PLAN.md §17). Delete items as they ship.
const building = [
  { title: 'A paper laid out like print: columns, rules and section fronts in the EPUB itself', href: pr(212) },
];

const considering = [
  { n: 20, title: 'Comics, manga and picture books, kept fixed-layout' },
  { n: 25, title: 'Structure recovery for messy Word documents and PDFs' },
  { n: 29, title: 'Optional AI extras: a summary, a glossary, a series recap' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Deckle',
  description: item.tagline,
  url: 'https://casavargas.app/deckle/',
  downloadUrl: download,
  codeRepository: repo,
  softwareVersion: version,
  operatingSystem: 'macOS, Windows',
  applicationCategory: 'UtilitiesApplication',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: { '@type': 'Organization', name: 'Casa Vargas LLC', url: 'https://casavargas.app' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Layout
  title="Deckle | A morning paper for your e-ink reader"
  description="Deckle is a free, open-source app that builds a real newspaper every morning on your own computer, from your town’s news and weather, your feeds and the articles you saved, and puts it on your Kindle, Kobo, PocketBook or reMarkable. It also turns the books you own into Kindle books that read like the store’s. Mac and Windows, no account."
  ogImage="/og/deckle.png"
>
  <JsonLd data={schema} />
  <Nav />

  <main id="main" class="dk">
    <!-- Opening: the one motion moment. -->
    <section class="dk-open" aria-labelledby="dk-title">
      <div class="lamp" aria-hidden="true"></div>
      <div class="wrap">
        <p class="dk-mark">
          <Image src={item.icon!} alt="" widths={[64, 128]} sizes="48px" format="webp" quality={84} loading="eager" fetchpriority="high" class="dk-mark__icon" />
          <span class="dk-mark__name">Deckle</span>
        </p>

        <h1 id="dk-title" class="statement">
          <span class="statement__line">A morning paper</span>
          <span class="statement__line">for your e-ink reader.</span>
        </h1>

        <div class="dk-open__body">
          <p class="standfirst">
            Every morning Deckle builds a real newspaper on your own computer, from your town’s
            news and weather, your feeds and the articles you saved, and has it waiting on your
            Kindle, Kobo, PocketBook or reMarkable before you are up. It also turns the books you
            own into Kindle books that read like the store’s. Free and open source, with nothing
            to sign up for.
          </p>
          <div class="dk-actions">
            <a class="dk-button" href={download} rel="noopener">Download for Mac or Windows</a>
            <a class="textlink" href={repo} rel="noopener">Source on GitHub</a>
          </div>
        </div>

        <dl class="dk-specs ui">
          {specs.map(([k, v]) => (
            <div><dt>{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <!-- The hero: the app, with the paper it made standing in front of it. -->
    <div class="wrap dk-hero">
      <Shot
        shot={{ src: dailyToday, kind: 'window', alt: 'Deckle’s Daily tab, Today: tomorrow’s paper so far, with the press bar and its countdown, a live sketch of the front page, the page plan and the week’s reads. Shown with a fictional town.' }}
        width={1400}
        sizes="(max-width: 900px) 84vw, 70vw"
        class="dk-hero__app"
      />
      <Shot
        shot={{ src: front, kind: 'reader', alt: 'The front page of The Morning Deckle on an e-reader: the masthead, the date, the weather and the lead headlines of a fictional town' }}
        sizes="(max-width: 900px) 34vw, 22vw"
        class="dk-hero__reader"
      />
    </div>

    <!-- Act one: the paper. -->
    <section class="wrap dk-section" aria-labelledby="dk-paper">
      <div class="dk-head">
        <h2 id="dk-paper" class="dk-h2">A newspaper, not a feed</h2>
        <p class="dk-lede">
          E-ink is the closest a screen gets to paper. Deckle gives it a paper worth reading:
          sections in order, an index inside, whole stories, and a last page you can finish.
        </p>
      </div>

      <figure class="dk-pages">
        <Shot shot={{ src: story, kind: 'reader', alt: 'A story page in The Morning Deckle: a headline, a grayscale photo and the story in full' }} sizes="(max-width: 900px) 30vw, 21vw" />
        <Shot shot={{ src: weather, kind: 'reader', alt: 'The weather and almanac page: the forecast, sunrise and sunset, and the moon' }} sizes="(max-width: 900px) 30vw, 21vw" />
        <Shot shot={{ src: puzzle, kind: 'reader', alt: 'The puzzle page: a five by five mini crossword built from yesterday’s headlines, and a word ladder' }} sizes="(max-width: 900px) 30vw, 21vw" />
        <figcaption class="ui">
          A demo edition, built by Deckle’s own code. Linden Falls and its stories are made
          up; the photos are public domain.
        </figcaption>
      </figure>

      <dl class="dk-features dk-features--3">
        {paper.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="wrap dk-section" aria-labelledby="dk-how">
      <div class="dk-head">
        <h2 id="dk-how" class="dk-h2">From your sources to your nightstand</h2>
        <p class="dk-lede">No server in the middle. The paper is fetched, set and kept on your machine.</p>
      </div>

      <div class="dk-split">
        <ol class="dk-steps">
          {steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
        <Shot shot={{ src: dailySections, kind: 'window', alt: 'The Daily tab, Sections: the paper’s sections in one list, in print order, with weather, local news, interests and feeds' }} width={1100} sizes="(max-width: 900px) 92vw, 52vw" />
      </div>

      <aside class="dk-callout" aria-labelledby="dk-save">
        <h3 id="dk-save">Save it for tomorrow</h3>
        <p>
          Find something worth reading during the day and save it: with the bookmarklet, by
          dropping a link in Deckle’s Inbox folder, or from your iPhone with a Shortcut. It
          prints in tomorrow’s paper as Your Reading, whole and with its photos. A long piece
          becomes its own book and rides along.
        </p>
      </aside>
    </section>

    <section class="wrap dk-section" aria-labelledby="dk-readers">
      <div class="dk-split">
        <div>
          <h2 id="dk-readers" class="dk-h2">One paper, every e-ink screen</h2>
          <p class="dk-lede">Deckle sees which reader you plug in and gives it the paper in the form it wants.</p>
          <Facts rows={readers} class="dk-rule dk-rule--readers" />
          <p class="dk-note">
            Honest status: Kobo, PocketBook and reMarkable are checked only against simulated
            devices and a stand-in server so far. A report from a real one is very welcome.
            Only Kindle books need Kindle Previewer.
          </p>
        </div>
        <Shot shot={{ src: dailyDelivery, kind: 'window', alt: 'The Daily tab, Delivery: where the paper goes, the readers in one group and the folders and email in another. Shown with a fictional setup.' }} width={1100} sizes="(max-width: 900px) 92vw, 52vw" />
      </div>
    </section>

    <!-- Act two: books. -->
    <section class="dk-act" aria-labelledby="dk-books">
      <div class="wrap">
        <div class="dk-head">
          <h2 id="dk-books" class="dk-h2 dk-h2--act">And the books you own, finished like the store’s</h2>
          <p class="dk-lede">
            A book you load onto a Kindle yourself is second-class: no Enhanced Typesetting, a
            cover that turns grey, no page numbers, no X-Ray, no Word Wise. Every fix exists as
            a separate plugin or forum recipe, and they fight each other. Deckle does all of it
            in one window. Drop the books in, plug the Kindle in, press Send.
          </p>
        </div>

        <div class="dk-wide">
          <Shot shot={{ src: booksLibrary, kind: 'window', alt: 'Deckle’s Books tab: a library of public-domain novels with their covers beside the To send queue, ready for a Kindle Paperwhite' }} width={1400} sizes="(max-width: 900px) 92vw, 80vw" />
        </div>

        <dl class="dk-features dk-features--4">
          {storeBook.map((f) => (
            <div>
              <dt>{f.title}</dt>
              <dd>{f.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="wrap dk-section" aria-labelledby="dk-cover">
      <div class="dk-split">
        <div>
          <h2 id="dk-cover" class="dk-h2">Covers and features pull in opposite directions</h2>
          <div class="dk-prose">
            <p>
              A Kindle loads X-Ray and Word Wise only for books it files as store books, and
              gives a store book it does not recognise a grey cover. Personal documents keep
              their cover but get neither feature. So Deckle reads each Kindle when it connects
              and makes the choice for that device:
            </p>
            <Facts rows={coverRule} class="dk-rule" />
            <p>
              Before you send, click any book to see exactly what Deckle will do to it, and the
              first page of chapter one before and after.
            </p>
          </div>
        </div>
        <Shot shot={{ src: booksDrawer, kind: 'screen', alt: 'The drawer for Pride and Prejudice before sending: typography fixed, its own cover, EBOK mode with Deckle’s thumbnail, X-Ray and Word Wise built, and the first page of chapter one after the typography pass' }} width={560} sizes="(max-width: 900px) 80vw, 30vw" class="dk-panel" />
      </div>
    </section>

    <section class="wrap dk-section" aria-labelledby="dk-more">
      <div class="dk-head">
        <h2 id="dk-more" class="dk-h2">If you can read it, you can send it</h2>
        <p class="dk-lede">EPUB is only the start. Everything goes through the same pipeline and comes out a proper Kindle book.</p>
      </div>
      <dl class="dk-features dk-features--3">
        {formats.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="wrap dk-section" aria-labelledby="dk-kindle">
      <div class="dk-split">
        <div>
          <h2 id="dk-kindle" class="dk-h2">And the books already on your Kindle</h2>
          <dl class="dk-features dk-features--stack">
            {onKindle.map((f) => (
              <div>
                <dt>{f.title}</dt>
                <dd>{f.body}</dd>
              </div>
            ))}
          </dl>
        </div>
        <Shot shot={{ src: kindleShelf, kind: 'window', alt: 'Deckle’s Kindle tab, Shelf: every book on a Kindle Paperwhite with its cover, progress and when it was last opened' }} width={1100} sizes="(max-width: 900px) 92vw, 52vw" />
      </div>
    </section>

    <!-- For the people who want to know how. -->
    <section class="dk-deep" aria-labelledby="dk-hood">
      <div class="wrap">
        <div class="dk-head">
          <h2 id="dk-hood" class="dk-h2">Under the hood</h2>
          <p class="dk-lede">
            A Rust workspace with a Tauri and React app on top, and a command line that does
            everything the app does. The <a class="textlink" href={`${repo}#how-it-works`} rel="noopener">README</a> and
            the <a class="textlink" href={`${repo}/tree/main/docs/formats`} rel="noopener">format notes</a> go further.
          </p>
        </div>

        <dl class="dk-features dk-features--2">
          {hood.map((f) => (
            <div>
              <dt>{f.title}</dt>
              <dd>{f.body}</dd>
            </div>
          ))}
        </dl>

        <div class="dk-split dk-split--code">
          <pre class="dk-code" aria-label="Command line examples"><code><span class="c"># tomorrow's paper, now, onto the plugged-in reader</span>
deckle digest run --to device
deckle digest schedule --at 05:30
deckle digest interests add "Rust" --query '"Rust" programming'

<span class="c"># a book, with X-Ray descriptions from a local model</span>
deckle run book.epub --to device --cde ebok --llm openai \
  --llm-endpoint http://localhost:11434/v1

deckle kindle upgrade --dry-run
deckle highlights export --to ~/Notes/Reading</code></pre>
          <div class="dk-prose">
            <p>
              <strong>Built with AI, in the open.</strong> Deckle is developed with Claude Code.
              Every feature starts as a written spec and plan in the repository, and what the AI
              writes is reviewed and tested against fixtures and real Kindles before it merges.
              The specs are in <a class="textlink" href={`${repo}/tree/main/docs/superpowers`} rel="noopener">docs/superpowers</a>.
            </p>
            <p class="dk-note">
              Linux is not supported: Kindle Previewer runs only on Mac and Windows. To build from
              source you need Rust, Node 22 and pnpm.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap dk-section" aria-labelledby="dk-network">
      <div class="dk-head">
        <h2 id="dk-network" class="dk-h2">What goes over the network</h2>
        <p class="dk-lede">Nothing about you, ever. Sending a book is offline. Everything else is listed here, and in the app.</p>
      </div>
      <div class="dk-split dk-split--table">
        <div class="dk-table-wrap">
          <table class="dk-table">
            <thead class="ui">
              <tr><th scope="col">What</th><th scope="col">When</th><th scope="col">Default</th></tr>
            </thead>
            <tbody>
              {network.map(([what, when, def]) => (
                <tr><td>{what}</td><td>{when}</td><td>{def}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="dk-note">
            A book sent with features carries an ASIN, so the Kindle itself may ask Amazon about
            it. That is the Kindle, not Deckle; sending cover-first avoids it.
          </p>
        </div>
        <Shot shot={{ src: settingsOnline, kind: 'window', alt: 'Deckle’s Settings, Online and privacy: everything that goes online, in one place, each with its switch' }} width={1100} sizes="(max-width: 900px) 92vw, 46vw" />
      </div>
    </section>

    <section class="wrap dk-section" aria-labelledby="dk-install">
      <div class="dk-head">
        <h2 id="dk-install" class="dk-h2">Install</h2>
      </div>
      <ol class="dk-install">
        <li>
          <h3>Download Deckle</h3>
          <p>
            From the <a class="textlink" href={download} rel="noopener">latest release</a>. The Mac
            <code>.dmg</code> is signed and notarized; the Windows <code>-setup.exe</code> is
            code-signed and installs without admin (a new certificate can still bring up
            SmartScreen: More info, then Run anyway). It updates itself from then on.
          </p>
        </li>
        <li>
          <h3>For Kindle books, add Kindle Previewer</h3>
          <p>
            It is <a class="textlink" href="https://kdp.amazon.com/en_US/help/topic/G202131170" rel="noopener">free from Amazon</a>,
            and the only thing that makes Enhanced Typesetting. Deckle drives it and never bundles
            it. The paper on a Kobo, PocketBook or reMarkable skips this.
          </p>
        </li>
        <li>
          <h3>Set up your paper, plug in</h3>
          <p>
            Pick your town and feeds on the Daily tab and turn on the morning schedule. For
            books, drop them on the window and press Send. Quit calibre and Android File Transfer
            first: only one program at a time can talk to an MTP Kindle.
          </p>
        </li>
      </ol>
    </section>

    <section class="wrap dk-section" aria-labelledby="dk-status">
      <div class="dk-split">
        <div>
          <h2 id="dk-status" class="dk-h2">Where it stands</h2>
          <div class="dk-prose">
            <p>
              Deckle is young and moving fast. The whole pipeline works from the app and the
              command line and is tested against fixtures and simulated devices. On real
              hardware it has been verified on a Kindle Scribe (2024) and a Kindle Paperwhite;
              the <a class="textlink" href={`${repo}/blob/main/docs/devices.md`} rel="noopener">device matrix</a> records
