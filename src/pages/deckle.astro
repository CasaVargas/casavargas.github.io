<style>
  .dk-open {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
  }

  /* The lamp, as on the homepage: the one motion moment on the page. */
  .lamp {
    position: absolute;
    z-index: -1;
    top: -40%;
    left: -14%;
    width: min(1250px, 115vw);
    aspect-ratio: 1.3;
    background: radial-gradient(closest-side, rgba(239, 159, 39, 0.17), rgba(239, 159, 39, 0.06) 55%, transparent);
    pointer-events: none;
    animation: lamp-on 2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .dk-open__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2rem);
    padding-block: clamp(2.5rem, 8vh, 6rem) clamp(3rem, 7vw, 5rem);
  }

  .dk-mark {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 clamp(1.75rem, 4vh, 2.75rem);
  }
  :global(.dk-mark__icon) {
    width: 56px;
    height: 56px;
    border-radius: 22.5%;
    box-shadow: 0 0 0 1px var(--well-ring);
  }
  .dk-mark__name {
    font-size: 1.5rem;
    font-weight: 450;
    letter-spacing: -0.01em;
  }

  .statement {
    grid-column: 1 / -1;
    margin: 0;
    font-weight: 290;
    font-size: clamp(3rem, 8.4vw, 8.25rem);
    line-height: 0.92;
    letter-spacing: -0.036em;
    text-wrap: balance;
  }
  .statement__line {
    display: block;
    animation: settle 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .statement__line + .statement__line {
    padding-left: 0.62em;
    animation-delay: 0.12s;
  }

  .dk-open__body {
    grid-column: 1 / span 6;
    margin-top: clamp(2.5rem, 6vh, 4rem);
    animation: settle 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both;
  }
  .standfirst {
    margin: 0;
    max-width: 27em;
    font-size: clamp(1.15rem, 1.55vw, 1.375rem);
    line-height: 1.55;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .dk-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
    margin: 2rem 0 0;
    font-size: 1.0625rem;
  }

  :global(.dk-open__facts) {
    grid-column: 8 / -1;
    align-self: end;
    margin-top: clamp(2.5rem, 6vh, 4rem) !important;
    animation: settle 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) 0.45s both;
