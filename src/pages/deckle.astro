  /* The solid button, as at the end of a case study. */
  .dk-button {
    display: inline-block;
    padding: 0.85rem 1.4rem;
    border-radius: 8px;
    background: var(--color-ink);
    color: var(--color-ground);
    font-family: var(--font-sans);
    font-size: 0.975rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .dk-button:hover { background: var(--color-amber); }

  .dk-lead { padding-bottom: clamp(3.5rem, 8vw, 6rem); }

  /* A feature card under its section: a cream sheet, set to one side like the
     screenshots, so the page keeps its alternation. */
  .dk-card { padding-bottom: clamp(3rem, 7vw, 5rem); }
  .dk-card :global(.card) { max-width: 56rem; margin-left: auto; }
  .dk-card--left :global(.card) { margin-left: 0; margin-right: auto; }

  /* Two cards side by side, each at the same 1200 × 630 proportion. */
  .dk-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
