---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Facts from '../components/ui/Facts.astro';
import Shot from '../components/ui/Shot.astro';
import Composition from '../components/ui/Composition.astro';
import { bySlug } from '../data/work';
import recaps from '../assets/deckle/recaps.png';
import daily from '../assets/deckle/app/daily-today.jpg';
import kindleShelf from '../assets/deckle/app/kindle-shelf.jpg';
import settingsOnline from '../assets/deckle/app/settings-online.jpg';
import delivery from '../assets/deckle/delivery.png';
import comic from '../assets/deckle/books-comic.png';
import koreader from '../assets/deckle/koreader.png';
import welcome from '../assets/deckle/welcome.png';
import weather from '../assets/deckle/paper/weather.jpg';
import puzzle from '../assets/deckle/paper/puzzle.jpg';
import search from '../assets/deckle/puzzles/search.png';
import crossword from '../assets/deckle/puzzles/crossword.png';
import sudoku from '../assets/deckle/puzzles/sudoku.png';

// Deckle's product page: it has no domain of its own. The Daily leads, books
// second (PLAN.md §13). Every claim comes from the Deckle README, docs/daily.md,
// docs/devices.md and CHANGELOG.md at 0.11.0 (2026-11-02). The paper imagery is a
// demo edition built by Deckle's own code, with a fictional town; never invented
// news about a real place. App shots are the real UI with mocked IPC and fictional
// data. Never "works with every Kindle": name only what docs/devices.md records.
// Kindle Previewer is Amazon's and never bundled. No DRM talk. No em dashes.
const item = bySlug('deckle');

const repo = 'https://github.com/CasaVargas/deckle';
const download = `${repo}/releases/latest`;
const docs = (path: string) => `${repo}/blob/main/${path}`;

const facts: [string, string][] = [
  ['Price', 'Free and open source, GPL-3.0-or-later'],
  ['Runs on', 'macOS 14 or later (Apple silicon and Intel), Windows 11, and Linux as a container that prints the paper and serves the app to a browser'],
  ['Readers', 'Kindle, Kindle Scribe, Kobo, PocketBook, reMarkable, anything running KOReader, and any folder for a Boox or an iPad'],
  ['Needs', 'Kindle Previewer 4, free from Amazon, for Kindle books only'],
  ['Status', 'Version 0.11.0. Verified on a Kindle Scribe (2024) and a Kindle Paperwhite; Kobo, PocketBook and reMarkable are checked against simulated devices so far.'],
];

const paper = [
  { title: 'The front page is the cover', body: 'Deckle sets a front page every morning, with the masthead, the date, the weather and the lead headlines, and makes it the cover. Your reader’s library tile is today’s paper. Ten masthead faces to choose from.' },
  { title: 'Whole stories, with photos', body: 'Every story comes in full, pulled from the publisher the way Reader View does, with its photos turned grayscale for e-ink and kept in colour for a Paper Pro or a tablet. Nothing sends you to a browser. A story behind a paywall runs as a brief.' },
  { title: 'Your town, your feeds, your interests', body: 'The weather from Open-Meteo, local news for your town and any other place you care about, each RSS or Atom feed as its own section, and interests: a topic searched every morning and kept only when a headline actually names it.' },
  { title: 'The back pages', body: 'A five by five mini crossword whose theme answers are yesterday’s headlines, a word search, a word ladder, an almanac with sunrise, the moon and tonight’s meteor shower, a horoscope, and On this day.' },
  { title: 'Tomorrow’s paper, so far', body: 'The Daily tab opens on the next edition: a press bar with a countdown and a Stop the presses button, a live sketch of the front page that fills in as you save articles, a page plan you drag to reorder, and the week’s reads.' },
  { title: 'From Your Shelf', body: 'A page drawn from your own reader: the books you are in the middle of, a past highlight, and the words you looked up this week. It stays on your computer, and one button forgets it.' },
  { title: 'Papers for the whole house', body: 'A paper per reader, each with its own sections, schedule, days and device, and a large-print layout for big type. Sign in to a paper you subscribe to and it prints in full as its own section.' },
  { title: 'Every edition kept', body: 'The Morgue keeps each edition in a folder you can see, with the stories’ text, for a year. Browse a month of front pages, search them, see how far you read, and send an old one back.' },
  { title: 'It learns, quietly', body: 'The paper notices which sections you actually reach, from the reading position your Kindle keeps or KOReader’s sync, and suggests changes and new interests. All on this machine.' },
  { title: 'An editor, if you want one', body: 'Off by default. Turned on, a model you choose (including a local one) folds the same story from several feeds into one, writes short section briefs and scores interest stories. Its text is labelled; the stories are never rewritten.' },
];

// The per-reader matrix, from the README's "What each reader gets" (0.11.0).
const readers = ['Kindle, USB', 'Kindle, email', 'Kindle Scribe', 'Kobo', 'PocketBook', 'reMarkable', 'KOReader, Wi-Fi', 'A folder'];
const matrix: [string, string[]][] = [
  ['The paper', ['KFX', 'EPUB, Amazon sets it', 'KFX over MTP', 'KEPUB', 'EPUB', 'PDF, colour on a Paper Pro', 'EPUB or KEPUB', 'EPUB, KEPUB, PDF or bundle']],
  ['Crossword and word search', ['yes, scored from your notes', 'yes', 'yes, no score', 'yes', 'yes', 'yes', 'yes', 'yes']],
  ['How far you read', ['yes', '', 'yes', 'with KOReader', 'with KOReader', '', 'yes, by sync', '']],
  ['Highlights read back', ['yes', '', 'not yet', 'yes', 'with KOReader', '', 'over USB or a synced folder', 'KOReader’s']],
  ['Books, finished', ['KFX, cover, pages', '', 'KFX, cover first', 'clean KEPUB', 'clean EPUB', 'EPUB', 'EPUB, over the calibre connection', 'KFX']],
  ['X-Ray and Word Wise', ['yes', '', 'with a real ASIN', 'Who’s who page', 'Who’s who page', 'Who’s who page', '', '']],
  ['AI recaps, Summary, Previously', ['yes', '', 'yes', 'yes', 'yes', 'yes', '', 'yes']],
  ['Comics, manga, scans', ['AZW3, fitted per model', '', 'AZW3, checked on device', 'fixed-layout EPUB', 'fixed-layout EPUB', 'image PDF, colour on a Paper Pro', '', 'AZW3']],
  ['Puzzle books', ['PDF, no ink', '', 'PDF, write on it', '', '', 'PDF, sized for it', '', 'PDF']],
  ['calibre connection, reading data, shelves', ['with KOReader', '', 'with KOReader', 'yes', 'with KOReader', '', 'yes', '']],
  ['The Kitchen Book', ['yes', '', 'yes', '', '', '', '', 'EPUB']],
];

const storeBook = [
  { title: 'Enhanced Typesetting', body: 'The typesetting store books get, produced by Amazon’s own converter, Kindle Previewer, which Deckle drives for you.' },
  { title: 'A cover that stays', body: 'Sideloaded covers tend to turn grey once a Kindle goes online. Deckle picks, per Kindle, how to keep yours.' },
  { title: 'X-Ray and Word Wise', body: 'The people and terms in the book, with optional descriptions from an AI model you choose, and Word Wise hints pointing at the Kindle’s own dictionary. On a Kobo, a PocketBook or a reMarkable the same people and terms become a Who’s who page at the back, each name’s first mention linked to it.' },
  { title: 'Recaps, without spoilers', body: 'Off by default. A short labelled recap at the end of each chapter, written from that chapter alone; a Summary page at the back; and for a later book in a series, a Previously page before chapter one, made only from the earlier books’ recaps. A book is never summarised twice.' },
];

const moreBooks = [
  { title: 'Word, OpenDocument, RTF, FictionBook, Markdown', body: 'Headings become the contents, and tables, pictures and footnotes come through. A flat folder of notes becomes one book, a chapter per file.' },
  { title: 'PDFs, reflowed', body: 'A text PDF becomes a book that reflows: columns read in order, running heads dropped, broken words joined, tables and equations kept as pictures. A document with no real headings gets its chapters recognised from size and weight, with no model and no network.' },
  { title: 'Bind several files into one book', body: 'EPUBs, Word documents, PDFs and web articles made into one book, in the order you choose, with a contents list that runs through every part.' },
  { title: 'A PDF as it is', body: 'A PDF, text file or Kindle document copied to the Kindle untouched, under its own name. On a Scribe, that is a document you can write on.' },
];

const comics = [
  { title: 'Any way you have it', body: 'A CBZ, a CBR, a folder of page images, a fixed-layout EPUB, or a scanned PDF with or without an invisible text layer. Two-page spreads are split at import, and the comic’s own metadata gives the title and series.' },
  { title: 'Fitted to the reader', body: 'On a Kindle a comic arrives as a fixed-layout AZW3, the way a bought comic does, with its pages fitted to that Kindle’s screen: nineteen models known by their serial number, the Colorsoft in colour. Thirty Kobo models are recognised the same way, and a Kobo or PocketBook gets a fixed-layout EPUB. A reMarkable gets an image PDF, in colour on a Paper Pro.' },
  { title: 'Reads right to left', body: 'A checkbox on the comic’s row, remembered per book, for manga. A comic that says so in its own metadata gets it without asking.' },
];

const koreaderFeatures = [
  { title: 'The paper over Wi-Fi, no cable', body: 'Deckle serves a catalog on your home network, behind one account with a password you choose. KOReader browses it and downloads today’s paper and your books. Nothing leaves the house.' },
  { title: 'A Deckle plugin for KOReader', body: 'It fetches the morning paper by itself when the reader wakes or joins Wi-Fi, checks the download, tidies its own old papers, and sets up progress sync with one tap.' },
  { title: 'Progress sync, served by Deckle', body: 'Point KOReader’s own sync at the same address and every reader reports how far you read, down to the section of the paper, so the readership report is exact.' },
  { title: 'Highlights and progress, read back', body: 'Deckle reads KOReader’s files beside each book, over USB or from a folder the reader syncs back, and never writes them. Highlights come out as Markdown; books in progress reach From Your Shelf.' },
  { title: 'Plugins, managed from Deckle', body: 'List, install, update, remove and roll back KOReader plugins from a zip, a folder or a GitHub release. Switch them on and off. A store lists reviewed plugins, each install checked byte for byte against the reviewed file.' },
  { title: 'Backup and restore', body: 'KOReader’s settings, reading data and plugins copied to your computer, and put back on the same reader or another.' },
];

const calibre = [
  { title: 'KOReader’s calibre connection, answered by Deckle', body: 'Tap Connect in KOReader and Deckle appears as calibre would. Your books, calibre’s books and the paper go to the reader over Wi-Fi, with no plugin and no calibre running. The app shows every reader that has connected, its books and free space, and a queue.' },
  { title: 'Reading data back into calibre', body: 'Progress, finished, last read, rating and highlights into calibre columns you choose, through calibre’s own tools, never by editing its database. Off by default, with a preview, and a value you changed in calibre is left alone.' },
  { title: 'Shelves from calibre rules', body: 'A tag, series, author, column or saved search becomes a shelf on a Kobo or a collection in KOReader, holding the books that are actually on the reader. Only shelves Deckle made are ever changed.' },
];

const onKindle = [
  { title: 'Upgrade what is already there', body: 'Deckle reads the AZW3 and MOBI books on your Kindle and, when it finds the original in your calibre library or a folder you name, rebuilds it with Enhanced Typesetting, page numbers, X-Ray and Word Wise. The Kindle’s own copy is kept with its highlights, and Put back undoes it. Store books and anything with DRM are never touched.' },
  { title: 'A shelf you can read', body: 'Every book on the Kindle with its cover, a progress bar and when you last opened it, filtered by Reading, Finished, Sideloaded and more, and searchable.' },
  { title: 'Make room, back up, restore', body: 'See the space split by kind, then clear finished books, second copies and old papers. Copy every DRM-free book and its highlights and reading position to your computer, and put a backup on any Kindle later.' },
  { title: 'Highlights out, words to Anki', body: 'Highlights and notes as one Markdown file per book, in a notes vault or iCloud Drive, sideloaded books included. The words you looked up, as flashcards with the sentence and the book.' },
];

const network: [string, string, string][] = [
  ['The paper’s sources: Open-Meteo, a Google News search, your feeds and saved links, Wikipedia’s On this day', 'Each edition you build', 'Off until set up'],
  ['The paper by email, through your own mail account', 'Each morning paper', 'Off'],
  ['A check for a newer Deckle, on GitHub; nothing installs without a click', 'When the app starts', 'On'],
  ['Word Wise dictionary, 12 MB, from Deckle’s own releases', 'Once, the first time a book gets Word Wise', 'On'],
  ['Descriptions for X-Ray, recaps, or the paper’s editor, from Anthropic or any OpenAI-compatible endpoint, including a local Ollama', 'Each book or edition', 'Off'],
  ['Wikipedia summaries for X-Ray terms', 'Each book with features', 'Off'],
  ['Amazon edition lookup and missing book details, through Open Library', 'Books sent', 'Off'],
  ['The KOReader plugin store, on GitHub', 'When you open the store', 'Off'],
  ['The reader catalog and calibre connection, on your own network only', 'When a reader asks', 'Off'],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Deckle',
  description: item.tagline,
  url: 'https://casavargas.app/deckle/',
  downloadUrl: download,
  codeRepository: repo,
  softwareVersion: '0.11.0',
  operatingSystem: 'macOS, Windows, Linux',
  applicationCategory: 'UtilitiesApplication',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: { '@type': 'Organization', name: 'Casa Vargas LLC', url: 'https://casavargas.app' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Layout
  title="Deckle | Your morning paper, printed on e-ink"
  description="Deckle is a free, open-source app that builds a real morning newspaper on your own computer, from your town's news and weather, your feeds and your saved reading, and puts it on your Kindle, Kobo, PocketBook, reMarkable or any reader running KOReader. It also finishes the books you own like the store's: Enhanced Typesetting, covers, X-Ray, Word Wise, comics fitted to the screen, and AI recaps without spoilers."
  ogImage="/og/deckle.png"
>
  <JsonLd data={schema} />
  <Nav />

  <main id="main" class="dk">
    <section class="dk-open" aria-labelledby="dk-title">
      <div class="lamp" aria-hidden="true"></div>
      <div class="wrap dk-open__inner">
        <p class="dk-mark">
          <Image src={item.icon!} alt="" widths={[64, 128]} sizes="64px" format="webp" quality={84} loading="eager" fetchpriority="high" class="dk-mark__icon" />
          <span class="dk-mark__name">Deckle</span>
        </p>

        <h1 id="dk-title" class="statement">
          <span class="statement__line">Your morning paper,</span>
          <span class="statement__line">printed on e-ink.</span>
        </h1>

        <div class="dk-open__body">
          <p class="standfirst">
            Every morning Deckle sets a real newspaper on your own computer, from your
            town’s news and weather, your feeds and the articles you saved, and has it
            waiting on your Kindle, Kobo, PocketBook or reMarkable before you’re up. It
            also finishes the books you own the way the store does, fits comics to the
            screen, and makes puzzle books you solve in ink.
          </p>
          <p class="dk-actions">
            <a class="dk-button" href={download} rel="noopener">Download Deckle</a>
            <a class="textlink" href="/deckle/whats-new/">What’s new in 0.11</a>
            <a class="textlink" href={repo} rel="noopener">Source on GitHub</a>
          </p>
        </div>

        <Facts rows={facts} class="dk-open__facts" />
      </div>
    </section>

    <div class="wrap dk-lead">
      <Composition plate={item.plate!} eager />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-paper">
      <div>
        <h2 id="dk-paper" class="dk-h2">A newspaper, not a feed</h2>
        <p class="dk-side">A feed reader is a pile of links. A paper has an order, a front page and a last page you can finish.</p>
      </div>
      <dl class="dk-features">
        {paper.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="wrap dk-pages">
      <Shot shot={{ src: weather, kind: 'reader', alt: 'The weather page of The Morning Deckle on an e-reader: today, the days ahead and the moon' }} sizes="(max-width: 900px) 46vw, 24vw" />
      <Shot shot={{ src: puzzle, kind: 'reader', alt: 'The puzzle page of The Morning Deckle on an e-reader: a five by five mini crossword built from yesterday’s headlines, and a word ladder' }} sizes="(max-width: 900px) 46vw, 24vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-doorstep">
      <div>
        <h2 id="dk-doorstep" class="dk-h2">On the doorstep by 5:30</h2>
        <p class="dk-side">Pick a time. The paper builds every morning and goes wherever you read.</p>
      </div>
      <div class="dk-prose">
        <p>
          A <strong>Kindle</strong> gets today’s edition over USB the moment it is plugged in,
          or by email over Wi-Fi through your own mail account. A <strong>Kobo</strong> gets a
          KEPUB and a <strong>PocketBook</strong> an EPUB, in a Deckle folder, the first time
          one is connected. A <strong>reMarkable</strong> gets a PDF laid out for its screen,
          crossword and all, over the USB cable or over SSH and Wi-Fi into a Deckle folder that
          Deckle keeps tidy. Anything running <strong>KOReader</strong> takes it over Wi-Fi from
          Deckle’s own catalog, or lets the Deckle plugin fetch it when the reader wakes. An
          <strong>export folder</strong> in iCloud Drive or Dropbox puts it on an iPad or a
          Boox. Only the newest three papers stay on a reader.
        </p>
        <p>
          A Mac asleep at 5:30 builds the paper when it wakes. Stop the presses skips a
          morning. A source that fails prints “unavailable today” and the paper still comes
          out. The <a class="textlink" href={docs('docs/daily.md')} rel="noopener">Daily reference</a>
          has every setting.
        </p>
      </div>
    </section>

    <div class="wrap dk-figure">
      <Shot shot={{ src: delivery, kind: 'window', alt: 'Deckle’s Daily tab, Delivery: the Kindle over USB and by email, a reMarkable Paper Pro reached over Wi-Fi, a Kobo found automatically, KOReader over Wi-Fi with its catalog and sync addresses, and the calibre connection with a reader that has connected. Shown with a fictional setup.' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-readers">
      <div>
        <h2 id="dk-readers" class="dk-h2">What each reader gets</h2>
        <p class="dk-side">
          Every cell is part of the free app. Kindle books and the Kindle’s paper need
          Kindle Previewer, which runs on Mac and Windows; a Kobo, PocketBook or reMarkable
          needs nothing extra. An empty cell means not on that reader.
        </p>
      </div>
      <div class="dk-matrix-wrap">
        <table class="dk-matrix ui">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Feature</span></th>
              {readers.map((r) => <th scope="col">{r}</th>)}
            </tr>
          </thead>
          <tbody>
            {matrix.map(([feature, cells]) => (
              <tr>
                <th scope="row">{feature}</th>
                {cells.map((c) => <td class:list={[{ 'is-empty': !c }]}>{c || ''}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-save">
      <h2 id="dk-save" class="dk-h2">Save it for tomorrow</h2>
      <div class="dk-prose">
        <p>
          Find something worth reading during the day and save it: with the bookmarklet in
          your browser, by dropping the link into Deckle’s Inbox folder, or from your iPhone
          with a Shortcut that saves to iCloud Drive. It prints in tomorrow’s paper as
          <strong>Your Reading</strong>, whole and with its photos. A long piece becomes its
          own book and rides along with the paper.
        </p>
      </div>
    </section>

    <div class="wrap dk-figure">
      <Shot shot={{ src: daily, kind: 'window', alt: 'Deckle’s Daily tab, Today: tomorrow’s paper so far, with the press bar and its countdown, a live sketch of the front page, the page plan and the week’s reads. Shown with a fictional town.' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section dk-act" aria-labelledby="dk-books">
      <div>
        <h2 id="dk-books" class="dk-h2">And every book you own, finished properly</h2>
        <p class="dk-side">The other half of Deckle, and where it started.</p>
      </div>
      <div class="dk-prose">
        <p>
          Books you load onto a Kindle yourself are second-class. Every fix exists as a
          separate plugin or forum recipe, and they fight each other. Deckle does all of it
          in one window: drop the books in, plug the reader in, press Send.
        </p>
        <dl class="dk-features dk-features--tight">
          {storeBook.map((f) => (
            <div>
              <dt>{f.title}</dt>
              <dd>{f.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <div class="wrap dk-figure dk-figure--left">
      <Shot shot={{ src: recaps, kind: 'window', alt: 'Deckle’s Settings, Reading aids: Word Wise with its hint slider and example, X-Ray with an AI model chosen, and Chapter recaps switched on with a book summary' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-more">
      <div>
        <h2 id="dk-more" class="dk-h2">More than EPUB</h2>
        <p class="dk-side">If you can read it, you can send it.</p>
      </div>
      <dl class="dk-features dk-features--tight">
        {moreBooks.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-comics">
      <div>
        <h2 id="dk-comics" class="dk-h2">Comics, manga and scanned books</h2>
        <p class="dk-side">A page of pictures goes to each reader as pictures, fitted to its screen.</p>
      </div>
      <dl class="dk-features dk-features--tight">
        {comics.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="wrap dk-figure">
      <Shot shot={{ src: comic, kind: 'window', alt: 'Deckle’s Books tab: a library of public-domain novels with Little Nemo in Slumberland among them, the comic in the To send queue with its fixed-layout note, and its menu open on the Reads right to left checkbox, for a Kindle Scribe' }} width={1000} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-puzzles">
      <div>
        <h2 id="dk-puzzles" class="dk-h2">Puzzle books you solve in ink</h2>
        <p class="dk-side">For a Kindle Scribe, a reMarkable, an iPad, or A5 paper.</p>
      </div>
      <div class="dk-prose">
        <p>
          A device test settled that only a PDF takes pen ink on a Kindle Scribe, so these are
          PDFs: a title page, one puzzle per page, the answers at the back. <strong>Word
          searches</strong> at any size from 8 to 20 squares, with your own words if you like.
          <strong>Crosswords</strong> from 5×5 to 15×15, filled from a 45,000-word clue list
          drawn from Wiktionary, and seeded with your own words and clues for a themed book.
          <strong>Sudoku</strong> in three difficulties, each with exactly one solution, the
          hard ones always solvable by logic and never a guess.
        </p>
        <p>
          The same options, seed and date make the same book, byte for byte, and every run
          prints the command that makes it again. Books go to a folder or straight to a
          plugged-in Kindle.
        </p>
      </div>
    </section>

    <div class="wrap dk-trio">
      <Shot shot={{ src: search, kind: 'reader', alt: 'A page of a Deckle word search book on an e-reader: a 12 by 12 grid of letters with the sixteen hidden words listed beneath' }} sizes="(max-width: 900px) 31vw, 20vw" />
      <Shot shot={{ src: crossword, kind: 'reader', alt: 'A page of a Deckle crossword book on an e-reader: an 11 by 11 numbered grid with the across clues in two columns beneath' }} sizes="(max-width: 900px) 31vw, 20vw" />
      <Shot shot={{ src: sudoku, kind: 'reader', alt: 'A page of a Deckle sudoku book on an e-reader: a nine by nine grid with the givens in a bold serif' }} sizes="(max-width: 900px) 31vw, 20vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-koreader">
      <div>
        <h2 id="dk-koreader" class="dk-h2">KOReader, served and managed</h2>
        <p class="dk-side">KOReader runs on jailbroken Kindles, Kobos, PocketBooks, Boox tablets and reMarkables. Deckle reads from it, serves it and manages it.</p>
      </div>
      <dl class="dk-features dk-features--tight">
        {koreaderFeatures.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="wrap dk-figure dk-figure--left">
      <Shot shot={{ src: koreader, kind: 'window', alt: 'Deckle’s Settings, KOReader page: a plugged-in Kobo running KOReader, the Deckle plugin installed, the reader’s plugins with switches, and the plugin store’s recommended list' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-calibre">
      <div>
        <h2 id="dk-calibre" class="dk-h2">The bridge to your calibre library</h2>
        <p class="dk-side">calibre stays the library of record. Deckle moves books out and reading data back, over Wi-Fi.</p>
      </div>
      <dl class="dk-features dk-features--tight">
        {calibre.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-kindle">
      <div>
        <h2 id="dk-kindle" class="dk-h2">And the books already on your Kindle</h2>
        <p class="dk-side">Deckle looks at what is there before it sends anything.</p>
      </div>
      <dl class="dk-features dk-features--tight">
        {onKindle.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="wrap dk-figure">
      <Shot shot={{ src: kindleShelf, kind: 'window', alt: 'Deckle’s Kindle tab, Shelf: every book on a Kindle Paperwhite with its cover, progress and when it was last opened' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-network">
      <div>
        <h2 id="dk-network" class="dk-h2">What goes over the network</h2>
        <p class="dk-side">Nothing about you, ever. No account, no subscription, no telemetry.</p>
      </div>
      <div class="dk-prose">
        <div class="dk-table-wrap">
          <table class="dk-table">
            <thead class="ui">
              <tr><th scope="col">What</th><th scope="col">When</th><th scope="col">Default</th></tr>
            </thead>
            <tbody>
              {network.map(([what, when, def]) => (
                <tr><td>{what}</td><td>{when}</td><td>{def}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="dk-note">
          The app lists all of it on one page, Settings, Online and privacy. A Kindle may itself
          ask Amazon about a book sent with features, because it carries an ASIN. That is the
          Kindle’s doing; sending as a personal document avoids it. A paper sent by email goes
          through Amazon, which typesets it its own way.
        </p>
      </div>
    </section>

    <div class="wrap dk-figure dk-figure--left">
      <Shot shot={{ src: settingsOnline, kind: 'window', alt: 'Deckle’s Settings, Online and privacy: everything that goes online, in one place, each with its switch' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-install">
      <h2 id="dk-install" class="dk-h2">Install</h2>
      <div class="dk-prose">
        <ol class="dk-steps">
          <li>
            <h3>Download Deckle</h3>
            <p>
              From the <a class="textlink" href={download} rel="noopener">latest release</a>.
              On a Mac, open the <code>.dmg</code> and drag Deckle to Applications; it is signed
              and notarized by Apple. On Windows, run the code-signed <code>-setup.exe</code>,
              which installs for your user with no admin. On Linux, the paper runs in a
              <a class="textlink" href={docs('docs/docker.md')} rel="noopener">container</a>
              that also serves the app to your browser.
            </p>
          </li>
          <li>
            <h3>For Kindle books, install Kindle Previewer 4</h3>
            <p>
              It is <a class="textlink" href="https://kdp.amazon.com/en_US/help/topic/G202131170" rel="noopener">free from Amazon</a>
              and the only thing that produces Enhanced Typesetting. Deckle drives it and never
              bundles it. The paper on a Kobo, PocketBook, reMarkable or KOReader needs nothing.
            </p>
          </li>
          <li>
            <h3>Say hello to the welcome</h3>
            <p>
              On first launch Deckle asks for your paper’s name and town, the morning time,
              and shows you the bookmarklet to drag to your browser. Then plug a reader in, or
              let KOReader find the catalog on your network.
            </p>
          </li>
        </ol>

        <p>Everything the app does, the command line does too:</p>
        <pre class="dk-code"><code>deckle digest init
deckle digest run --to device
deckle digest schedule --at 05:30
deckle run book.epub --to device
deckle run manga.cbz --to remarkable
deckle puzzles crossword --to device</code></pre>
        <p class="dk-note">
          Deckle updates itself: the footer says when a new version is out, and Settings, About,
          Update installs it. Quit calibre and Android File Transfer first; only one program at a
          time can talk to an MTP Kindle. To build from source you need Rust, Node 22 and pnpm; the
          <a class="textlink" href={`${repo}#readme`} rel="noopener">README</a> has the details.
        </p>
      </div>
    </section>

    <div class="wrap dk-figure">
      <Shot shot={{ src: welcome, kind: 'window', alt: 'Deckle’s welcome on first launch: tomorrow’s front page in miniature beside the first page, with the paper’s name, the day’s date and the press time' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-next">
      <div>
        <h2 id="dk-next" class="dk-h2">What’s next</h2>
        <p class="dk-side">Designed in the open before it is built, with no dates promised.</p>
      </div>
      <div class="dk-prose">
        <p>
          Every feature starts as a written design in the repository, and what shipped in each
          version is on the <a class="textlink" href="/deckle/whats-new/">What’s new</a> page.
          Ideas, bug reports and real-device results go to the
          <a class="textlink" href={`${repo}/issues`} rel="noopener">issues</a>; the
          <a class="textlink" href={docs('docs/devices.md')} rel="noopener">device matrix</a>
          records what has been checked on real hardware, model by model.
        </p>
      </div>
    </section>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-credits">
      <h2 id="dk-credits" class="dk-h2">Credits</h2>
      <div class="dk-prose">
        <p>
          Deckle stands on research and code from the MobileRead community: jhowell’s KFX Input
          and Output and kfxlib, of which Deckle’s KFX writer is a Rust port; jloutsch’s kfxgen;
          xxyzz’s WordDumb and Proficiency; seapy’s kindle-cli; KindleUnpack; and calibre’s Kindle
          driver and wireless protocol. Word Wise definitions come from Wiktionary through
          kaikki.org, and word frequencies from wordfreq, both CC BY-SA 4.0. PDFs are read with
          PDFium. The paper’s weather comes from Open-Meteo and On this day from Wikipedia.
        </p>
        <p class="dk-note">
          The demo paper on this page is fictional: Linden Falls and its stories were made up
          for it. Its photos are public domain, and the books shown are public-domain novels
          with Standard Ebooks’ public-domain covers; the comic is Winsor McCay’s Little Nemo, 1905.
          Kindle Previewer is Amazon’s and is never bundled. Kindle is a trademark of Amazon.com,
          Inc.; Kobo, PocketBook, reMarkable and Boox belong to their makers, and KOReader and
          calibre to their projects. Deckle is not affiliated with any of them.
        </p>
      </div>
    </section>

    <section class="dk-close" aria-label="Get Deckle">
      <div class="wrap dk-close__grid">
