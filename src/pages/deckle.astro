---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Facts from '../components/ui/Facts.astro';
import Shot from '../components/ui/Shot.astro';
import Card from '../components/ui/Card.astro';
import Composition from '../components/ui/Composition.astro';
import { bySlug } from '../data/work';
import daily from '../assets/deckle/app/daily-today.jpg';
import kindleShelf from '../assets/deckle/app/kindle-shelf.jpg';
import settingsOnline from '../assets/deckle/app/settings-online.jpg';
import delivery from '../assets/deckle/delivery.png';
import comic from '../assets/deckle/books-comic.png';
import koreader from '../assets/deckle/koreader.png';
import welcome from '../assets/deckle/welcome.png';
import weather from '../assets/deckle/paper/weather.jpg';
import puzzle from '../assets/deckle/paper/puzzle.jpg';
import search from '../assets/deckle/puzzles/search.png';
import crossword from '../assets/deckle/puzzles/crossword.png';
import sudoku from '../assets/deckle/puzzles/sudoku.png';
import cardReaders from '../assets/deckle/cards/02-any-eink-reader.png';
import cardBooks from '../assets/deckle/cards/03-books-like-the-store.png';
import cardBackPages from '../assets/deckle/cards/04-the-back-pages.png';
import cardInterest from '../assets/deckle/cards/05-a-crossword-about-anything.png';
import cardAi from '../assets/deckle/cards/06-ai-on-your-mac.png';
import cardPrivate from '../assets/deckle/cards/07-no-deckle-cloud.png';
import cardHouse from '../assets/deckle/cards/08-papers-for-the-whole-house.png';
import cardManga from '../assets/deckle/cards/09-manga-right-to-left.png';
import cardComics from '../assets/deckle/cards/10-comics-page-for-page.png';
import cardPicture from '../assets/deckle/cards/11-picture-books.png';
import cardInk from '../assets/deckle/cards/12-puzzle-books-in-ink.png';
import cardRecaps from '../assets/deckle/cards/13-recaps-without-spoilers.png';
import cardKoreader from '../assets/deckle/cards/14-koreader-hub.png';
import cardKindle from '../assets/deckle/cards/15-your-kindle-from-your-desk.png';
import cardSaved from '../assets/deckle/cards/16-save-it-read-it-tomorrow.png';
import cardCalibre from '../assets/deckle/cards/17-calibre-stays-the-library.png';
import cardKitchen from '../assets/deckle/cards/18-the-kitchen-book.png';

// Deckle's product page: it has no domain of its own. The fun comes first (a
// crossword about anything, puzzle books in ink, the back pages, comics, the AI
// on your own Mac), then the paper, then the housekeeping (books, the Kindle
// tab, KOReader, calibre, the Kitchen Book, privacy). Every claim comes from the
// Deckle README, docs/daily.md, docs/puzzle-books.md, docs/devices.md and
// CHANGELOG.md at 0.12.0 (2026-11-03). The feature cards are the ones in the
// marketing repo (deckle/feature-cards); their device drawings are code, their
// book titles invented, and cards 9 to 11 carry public domain art credited in
// small type. The paper imagery is a demo edition built by Deckle's own code,
// with a fictional town; never invented news about a real place. App shots are
// the real UI with mocked IPC and fictional data. Never "works with every
// Kindle": name only what docs/devices.md records. Kindle Previewer is Amazon's
// and never bundled. No DRM talk. No em dashes.
const item = bySlug('deckle');

const repo = 'https://github.com/CasaVargas/deckle';
const download = `${repo}/releases/latest`;
const docs = (path: string) => `${repo}/blob/main/${path}`;

const facts: [string, string][] = [
  ['Price', 'Free and open source, GPL-3.0-or-later'],
  ['Runs on', 'macOS 14 or later (Apple silicon and Intel), Windows 11, and Linux as a container that prints the paper and serves the app to a browser'],
  ['Readers', 'Kindle, Kindle Scribe, Kobo, PocketBook, reMarkable, anything running KOReader, and any folder for a Boox or an iPad'],
  ['Needs', 'Kindle Previewer 4, free from Amazon, for Kindle books only. Ollama, free, for the AI on your own computer'],
  ['Status', 'Version 0.12.0. Verified on a Kindle Scribe (2024) and a Kindle Paperwhite; Kobo, PocketBook and reMarkable are checked against simulated devices so far.'],
];

const themes = [
  { title: 'Your interests', body: 'The sections of your paper you follow, the week’s headline words as answers and the headline as the clue. Pick which interests, or take the whole week’s paper.' },
  { title: 'The words you looked up', body: 'Every word you tapped on the Kindle, clued with the definition you read.' },
  { title: 'Your cookbook, or your own list', body: 'The dishes and ingredients in your Kitchen Book, or a file of words and clues of your own: names, in-jokes, a birthday.' },
  { title: 'A subject the AI writes', body: 'Star Wars, Christmas, the Panthers. The AI picks the words and writes the clues, every one checked to fit the grid and never to name its answer. With the AI on, any crossword’s clues can be rewritten as trivia, cryptic, or for a kid.' },
];

const kinds = [
  { title: 'Crosswords and word searches', body: 'Crosswords from 5×5 to 15×15, filled from a 45,000-word clue list and seeded with the theme. Word searches at any size from 8 to 20 squares.' },
  { title: 'Sudoku', body: 'Three difficulties, each puzzle with exactly one solution, the hard ones always solvable by logic and never a guess.' },
  { title: 'Word ladders and cryptograms', body: 'Three ladders a page, the rungs by difficulty. Cryptograms from public domain quotes or your own, with letters given by difficulty and a key to work in.' },
  { title: 'Nonograms and mazes', body: 'Nonograms from Deckle’s own pictures, every one proven to solve by line logic, or your own photo as the first puzzle. Mazes from 6 to 40 a side, the path drawn in the answers.' },
];

const paper = [
  { title: 'The front page is the cover', body: 'Deckle sets a front page every morning, with the masthead, the date, the weather and the lead headlines, and makes it the cover. Your reader’s library tile is today’s paper. Ten masthead faces to choose from.' },
  { title: 'Whole stories, with photos', body: 'Every story comes in full, pulled from the publisher the way Reader View does, with its photos turned grayscale for e-ink and kept in colour for a Paper Pro or a tablet. Nothing sends you to a browser. A story behind a paywall runs as a brief.' },
  { title: 'Your town, your feeds, your interests', body: 'The weather from Open-Meteo, local news for your town and any other place you care about, each RSS or Atom feed as its own section, and interests: a topic searched every morning and kept only when a headline actually names it.' },
  { title: 'Tomorrow’s paper, so far', body: 'The Daily tab opens on the next edition: a press bar with a countdown and a Stop the presses button, a live sketch of the front page that fills in as you save articles, a page plan you drag to reorder, and the week’s reads.' },
  { title: 'From Your Shelf', body: 'A page drawn from your own reader: the books you are in the middle of, a past highlight, and the words you looked up this week. It stays on your computer, and one button forgets it.' },
  { title: 'Every edition kept', body: 'The Morgue keeps each edition in a folder you can see, with the stories’ text, for a year. Browse a month of front pages, search them, see how far you read, and send an old one back.' },
  { title: 'It learns, quietly', body: 'The paper notices which sections you actually reach, from the reading position your Kindle keeps or KOReader’s sync, and suggests changes and new interests. All on this machine.' },
  { title: 'An editor, if you want one', body: 'Off by default. Turned on, the AI from Settings, AI folds the same story from several feeds into one, writes short section briefs and scores interest stories. Its text is labelled; the stories are never rewritten.' },
];

// The per-reader matrix, from the README's "What each reader gets" (0.12.0).
const readers = ['Kindle, USB', 'Kindle, email', 'Kindle Scribe', 'Kobo', 'PocketBook', 'reMarkable', 'KOReader, Wi-Fi', 'A folder'];
const matrix: [string, string[]][] = [
  ['The paper', ['KFX', 'EPUB, Amazon sets it', 'KFX over MTP', 'KEPUB', 'EPUB', 'PDF, colour on a Paper Pro', 'EPUB or KEPUB', 'EPUB, KEPUB, PDF or bundle']],
  ['Crossword and word search', ['yes, scored from your notes', 'yes', 'yes, no score', 'yes', 'yes', 'yes', 'yes', 'yes']],
  ['How far you read', ['yes', '', 'yes', 'with KOReader', 'with KOReader', '', 'yes, by sync', '']],
  ['Highlights read back', ['yes', '', 'not yet', 'yes', 'with KOReader', '', 'over USB or a synced folder', 'KOReader’s']],
  ['Books, finished', ['KFX, cover, pages', '', 'KFX, cover first', 'clean KEPUB', 'clean EPUB', 'EPUB', 'EPUB, over the calibre connection', 'KFX']],
  ['X-Ray and Word Wise', ['yes', '', 'with a real ASIN', 'Who’s who page', 'Who’s who page', 'Who’s who page', '', '']],
  ['AI recaps, Summary, Previously', ['yes', '', 'yes', 'yes', 'yes', 'yes', '', 'yes']],
  ['Comics, manga, scans', ['AZW3, fitted per model', '', 'AZW3, checked on device', 'fixed-layout EPUB', 'fixed-layout EPUB', 'image PDF, colour on a Paper Pro', '', 'AZW3']],
  ['Puzzle books', ['PDF, no ink', '', 'PDF, write on it', '', '', 'PDF, sized for it', '', 'PDF']],
  ['calibre connection, reading data, shelves', ['with KOReader', '', 'with KOReader', 'yes', 'with KOReader', '', 'yes', '']],
  ['The Kitchen Book', ['yes', '', 'yes', '', '', '', '', 'EPUB']],
];

const storeBook = [
  { title: 'Enhanced Typesetting', body: 'The typesetting store books get, produced by Amazon’s own converter, Kindle Previewer, which Deckle drives for you.' },
  { title: 'A cover that stays', body: 'Sideloaded covers tend to turn grey once a Kindle goes online. Deckle picks, per Kindle, how to keep yours.' },
  { title: 'X-Ray and Word Wise', body: 'The people and terms in the book, with optional descriptions from the AI, and Word Wise hints pointing at the Kindle’s own dictionary. On a Kobo, a PocketBook or a reMarkable the same people and terms become a Who’s who page at the back, each name’s first mention linked to it.' },
  { title: 'More than EPUB', body: 'Word, OpenDocument, RTF, FictionBook, Markdown and notes folders; text PDFs reflowed, with columns read in order and chapters recognised; several files bound into one book; a PDF copied untouched for a Scribe to write on.' },
];

const onKindle = [
  { title: 'Upgrade what is already there', body: 'Deckle reads the AZW3 and MOBI books on your Kindle and, when it finds the original in your calibre library or a folder you name, rebuilds it with Enhanced Typesetting, page numbers, X-Ray and Word Wise. The Kindle’s own copy is kept with its highlights, and Put back undoes it. Store books and anything with DRM are never touched.' },
  { title: 'A shelf you can read', body: 'Every book on the Kindle with its cover, a progress bar and when you last opened it, filtered by Reading, Finished, Sideloaded and more, and searchable.' },
  { title: 'Make room, back up, restore', body: 'See the space split by kind, then clear finished books, second copies and old papers. Copy every DRM-free book and its highlights and reading position to your computer, and put a backup on any Kindle later.' },
  { title: 'Highlights out, words to Anki', body: 'Highlights and notes as one Markdown file per book, in a notes vault or iCloud Drive, sideloaded books included. The words you looked up, as flashcards with the sentence and the book.' },
];

const koreaderFeatures = [
  { title: 'The paper over Wi-Fi, no cable', body: 'Deckle serves a catalog on your home network, behind one account with a password you choose. KOReader browses it and downloads today’s paper and your books. Nothing leaves the house.' },
  { title: 'A Deckle plugin for KOReader', body: 'It fetches the morning paper by itself when the reader wakes or joins Wi-Fi, checks the download, tidies its own old papers, and sets up progress sync with one tap.' },
  { title: 'Progress sync, served by Deckle', body: 'Point KOReader’s own sync at the same address and every reader reports how far you read, down to the section of the paper, so the readership report is exact.' },
  { title: 'Highlights and progress, read back', body: 'Deckle reads KOReader’s files beside each book, over USB or from a folder the reader syncs back, and never writes them. Highlights come out as Markdown; books in progress reach From Your Shelf.' },
  { title: 'Plugins, managed from Deckle', body: 'List, install, update, remove and roll back KOReader plugins from a zip, a folder or a GitHub release. Switch them on and off. A store lists reviewed plugins, each install checked byte for byte against the reviewed file.' },
  { title: 'Backup and restore', body: 'KOReader’s settings, reading data and plugins copied to your computer, and put back on the same reader or another.' },
];

const calibre = [
  { title: 'KOReader’s calibre connection, answered by Deckle', body: 'Tap Connect in KOReader and Deckle appears as calibre would. Your books, calibre’s books and the paper go to the reader over Wi-Fi, with no plugin and no calibre running. The app shows every reader that has connected, its books and free space, and a queue.' },
  { title: 'Reading data back into calibre', body: 'Progress, finished, last read, rating and highlights into calibre columns you choose, through calibre’s own tools, never by editing its database. Off by default, with a preview, and a value you changed in calibre is left alone.' },
  { title: 'Shelves from calibre rules', body: 'A tag, series, author, column or saved search becomes a shelf on a Kobo or a collection in KOReader, holding the books that are actually on the reader. Only shelves Deckle made are ever changed.' },
];

const network: [string, string, string][] = [
  ['The paper’s sources: Open-Meteo, a Google News search, your feeds and saved links, Wikipedia’s On this day', 'Each edition you build', 'Off until set up'],
  ['The paper by email, through your own mail account', 'Each morning paper', 'Off'],
  ['A check for a newer Deckle, on GitHub; nothing installs without a click', 'When the app starts', 'On'],
  ['Word Wise dictionary, 12 MB, from Deckle’s own releases', 'Once, the first time a book gets Word Wise', 'On'],
  ['The AI for X-Ray, recaps, the editor and puzzle clues: Ollama on this computer, so nowhere online, or Anthropic or any OpenAI-compatible service', 'Each book, edition or puzzle book', 'Off'],
  ['Wikipedia summaries for X-Ray terms', 'Each book with features', 'Off'],
  ['Amazon edition lookup and missing book details, through Open Library', 'Books sent', 'Off'],
  ['The KOReader plugin store, on GitHub', 'When you open the store', 'Off'],
  ['The reader catalog and calibre connection, on your own network only', 'When a reader asks', 'Off'],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Deckle',
  description: item.tagline,
  url: 'https://casavargas.app/deckle/',
  downloadUrl: download,
  codeRepository: repo,
  softwareVersion: '0.12.0',
  operatingSystem: 'macOS, Windows, Linux',
  applicationCategory: 'UtilitiesApplication',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: { '@type': 'Organization', name: 'Casa Vargas LLC', url: 'https://casavargas.app' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Layout
  title="Deckle | Your morning paper, printed on e-ink"
  description="Deckle is a free, open-source app that builds a real morning newspaper on your own computer and puts it on your Kindle, Kobo, PocketBook, reMarkable or any reader running KOReader. Type an interest and get a book of crosswords about it, clued by an AI on your own Mac. Puzzle books you solve in ink, comics and manga fitted to the screen, books finished like the store's, recaps without spoilers, and no cloud."
  ogImage="/og/deckle-hero.jpg"
>
  <JsonLd data={schema} />
  <Nav />

  <main id="main" class="dk">
    <section class="dk-open" aria-labelledby="dk-title">
      <div class="lamp" aria-hidden="true"></div>
      <div class="wrap dk-open__inner">
        <p class="dk-mark">
          <Image src={item.icon!} alt="" widths={[64, 128]} sizes="64px" format="webp" quality={84} loading="eager" fetchpriority="high" class="dk-mark__icon" />
          <span class="dk-mark__name">Deckle</span>
        </p>

        <h1 id="dk-title" class="statement">
          <span class="statement__line">Your morning paper,</span>
          <span class="statement__line">printed on e-ink.</span>
        </h1>

        <div class="dk-open__body">
          <p class="standfirst">
            Every morning Deckle sets a real newspaper on your own computer and has it
            waiting on your Kindle, Kobo, PocketBook or reMarkable before you’re up. Type an
            interest and it makes a book of crosswords about it, to solve in ink. It fits
            comics to the screen, finishes the books you own the way the store does, and
            runs its AI on your own Mac, with no account and no cloud.
          </p>
          <p class="dk-actions">
            <a class="dk-button" href={download} rel="noopener">Download Deckle</a>
            <a class="textlink" href="/deckle/whats-new/">What’s new in 0.12</a>
            <a class="textlink" href={repo} rel="noopener">Source on GitHub</a>
          </p>
        </div>

        <Facts rows={facts} class="dk-open__facts" />
      </div>
    </section>

    <div class="wrap dk-lead">
      <Composition plate={item.plate!} eager />
    </div>

    <!-- Act one: the fun part. -->

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-interest">
      <div>
        <h2 id="dk-interest" class="dk-h2">Type an interest. Get a crossword about it.</h2>
        <p class="dk-side">Star Wars. Christmas. The Panthers. Your kid’s dinosaurs. A whole book of them, themed on what you love, and sent to the Scribe to solve with a pen.</p>
      </div>
      <dl class="dk-features">
        {themes.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="wrap dk-card">
      <Card src={cardInterest} alt="Type an interest, get a crossword about it: the subject field reads Star Wars, the theme chips offer your interests, this week’s paper, words you looked up, your cookbook and your own list, the clue styles plain, trivia, cryptic and for a kid, and a Kindle Scribe shows a Star Wars crossword with Jedi and Yoda inked in" width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-ink">
      <div>
        <h2 id="dk-ink" class="dk-h2">Seven kinds of puzzle book, solved in ink</h2>
        <p class="dk-side">A PDF that takes pen on a Kindle Scribe or a reMarkable, sized for the screen, or for an iPad or A5 paper: a title page, one puzzle a page, the answers at the back.</p>
      </div>
      <div class="dk-prose">
        <dl class="dk-features dk-features--tight">
          {kinds.map((f) => (
            <div>
              <dt>{f.title}</dt>
              <dd>{f.body}</dd>
            </div>
          ))}
        </dl>
        <p class="dk-note dk-note--after">
          The Puzzles tab previews the first page as it will print while you change the size,
          difficulty, count and title. The same options make the same book again, so the whole
          family can race on one seed. Every book is kept with the options that made it; Send
          copies it to the plugged-in Kindle, or save a copy to a folder.
        </p>
      </div>
    </section>

    <div class="wrap dk-card dk-card--left">
      <Card src={cardInk} alt="Seven kinds of puzzle book, solved in ink: crossword, word search, sudoku, word ladder, cryptogram, nonogram from your own photo, and maze, with a Kindle Scribe showing a nonogram half shaded in pen" width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <div class="wrap dk-trio">
      <Shot shot={{ src: search, kind: 'reader', alt: 'A page of a Deckle word search book on an e-reader: a 12 by 12 grid of letters with the sixteen hidden words listed beneath' }} sizes="(max-width: 900px) 31vw, 20vw" />
      <Shot shot={{ src: crossword, kind: 'reader', alt: 'A page of a Deckle crossword book on an e-reader: an 11 by 11 numbered grid with the across clues in two columns beneath' }} sizes="(max-width: 900px) 31vw, 20vw" />
      <Shot shot={{ src: sudoku, kind: 'reader', alt: 'A page of a Deckle sudoku book on an e-reader: a nine by nine grid with the givens in a bold serif' }} sizes="(max-width: 900px) 31vw, 20vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-back">
      <div>
        <h2 id="dk-back" class="dk-h2">The paper ends like a paper</h2>
        <p class="dk-side">Every morning’s edition has back pages, and they are about yesterday.</p>
      </div>
      <div class="dk-prose">
        <p>
          A five by five <strong>mini crossword</strong> whose theme answers are yesterday’s
          headlines, a <strong>word search</strong> and a <strong>word ladder</strong> beside
          it, and yesterday’s answers printed small. An <strong>almanac</strong> with sunrise,
          the moon, the usual first frost and tonight’s meteor shower. A horoscope Deckle
          writes itself, a lottery if you want one, and <strong>On this day</strong>. On a
          Kindle, the notes you make on the puzzle page come back as a score.
        </p>
      </div>
    </section>

    <div class="wrap dk-card">
      <Card src={cardBackPages} alt="The back pages: the Mini crossword from yesterday’s headlines, the word search, the word ladder, the almanac, the horoscope and On this day, with a Kindle showing the puzzle page" width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <div class="wrap dk-pages">
      <Shot shot={{ src: weather, kind: 'reader', alt: 'The weather page of The Morning Deckle on an e-reader: today, the days ahead and the moon' }} sizes="(max-width: 900px) 46vw, 24vw" />
      <Shot shot={{ src: puzzle, kind: 'reader', alt: 'The puzzle page of The Morning Deckle on an e-reader: a five by five mini crossword built from yesterday’s headlines, and a word ladder' }} sizes="(max-width: 900px) 46vw, 24vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-comics">
      <div>
        <h2 id="dk-comics" class="dk-h2">Comics, manga and picture books, page for page</h2>
        <p class="dk-side">A CBZ, a CBR, a folder of pages, a fixed-layout EPUB or a scan goes to each reader as pictures, fitted to its screen. No reflow, no OCR, nothing re-cut.</p>
      </div>
      <div class="dk-prose">
        <p>
          On a Kindle a comic arrives as a fixed-layout AZW3, the way a bought comic does, with
          its pages fitted to that Kindle’s screen: nineteen models known by their serial
          number, the Colorsoft in colour. Thirty Kobo models are recognised the same way, and
          a Kobo or PocketBook gets a fixed-layout EPUB. A reMarkable gets an image PDF, in
          colour on a Paper Pro. Two-page spreads are split at import, and the comic’s own
          metadata gives the title and series.
        </p>
        <p>
          Manga marked right to left turns its pages the right way. For one that doesn’t say,
          there is a <strong>Reads right to left</strong> checkbox on the book’s row, remembered
          per book. A scanned picture book goes over the same way, every page as the artist
          laid it out.
        </p>
      </div>
    </section>

    <div class="wrap dk-pair">
      <Card src={cardManga} alt="Manga, the right way round: a page of Hokusai Manga on a Kindle Scribe, the Reads right to left checkbox on the book’s row, and the formats for each reader" width={800} sizes="(max-width: 900px) 100vw, 48vw" />
      <Card src={cardPicture} alt="Picture books for the smallest reader: Peter Rabbit pages on a Kindle and a Kobo, beside the kid’s own Saturday paper" width={800} sizes="(max-width: 900px) 100vw, 48vw" />
    </div>

    <div class="wrap dk-card dk-card--left">
      <Card src={cardComics} alt="Comics, page for page, even the Sunday ones: Winsor McCay’s Little Nemo in grey on a Kobo and in colour on a reMarkable Paper Pro, with the two shell commands that send it" width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <div class="wrap dk-figure">
      <Shot shot={{ src: comic, kind: 'window', alt: 'Deckle’s Books tab: a library of public-domain novels with Little Nemo in Slumberland among them, the comic in the To send queue with its fixed-layout note, and its menu open on the Reads right to left checkbox, for a Kindle Scribe' }} width={1000} sizes="(max-width: 900px) 100vw, 64vw" />
    </div>

    <section class="wrap dk-grid dk-section" aria-labelledby="dk-ai">
      <div>
        <h2 id="dk-ai" class="dk-h2">AI on your own Mac, for free</h2>
        <p class="dk-side">Off by default. One setting, Settings, AI, for everything the AI does: X-Ray, the paper’s editor, chapter recaps and puzzle clues.</p>
      </div>
      <div class="dk-prose">
        <p>
          <strong>On this Mac</strong> is a checklist that fills itself in: is Ollama running,
          with a Get Ollama button and a check every few seconds until it answers; is the model
          installed, with a Download button, a progress bar and a Stop; and Try it. Deckle picks
          the model for your machine’s memory, speaks Ollama’s own API so it can set the context
          the paper needs, and nothing you read leaves your computer. <strong>A service
          online</strong> takes Anthropic or any OpenAI-compatible endpoint and a key, with a
          price table beside it.
        </p>
        <p>
          With the AI on, a book can get <strong>recaps that can’t spoil</strong>: a labelled
          recap at the end of each chapter written from that chapter alone, a Summary page at
          the back, and for a later book in a series a Previously page before chapter one, made
          only from the earlier books’ recaps. A book is never summarised twice.
        </p>
      </div>
    </section>

    <div class="wrap dk-pair">
