---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Opening from '../components/home/Opening.astro';
import Plate from '../components/home/Plate.astro';
import Workshop from '../components/home/Workshop.astro';
import WorkIndex from '../components/WorkIndex.astro';
import Method from '../components/home/Method.astro';
import Studio from '../components/home/Studio.astro';
import LatestNotes from '../components/home/LatestNotes.astro';
import { featured, caseStudies } from '../data/work';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'CasaVargas LLC',
  url: 'https://casavargas.app',
  logo: 'https://casavargas.app/casavargas-logo-orange.png',
  email: 'hello@casavargas.app',
  founder: { '@type': 'Person', name: 'Jon Vargas' },
  address: { '@type': 'PostalAddress', addressRegion: 'NC', addressCountry: 'US' },
  description:
    'A one-person software studio making apps for the Mac, iPhone, iPad, Apple TV, Windows and Linux — paid for once, if at all.',
  sameAs: ['https://github.com/CasaVargas'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CasaVargas',
  url: 'https://casavargas.app',
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Work by CasaVargas',
  itemListElement: caseStudies.map((w, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: w.name,
    url: `https://casavargas.app/work/${w.slug}/`,
  })),
};
---

<Layout>
  <JsonLd data={organizationSchema} />
  <JsonLd data={websiteSchema} />
  <JsonLd data={itemListSchema} />

  <Nav />
  <main id="main">
    <Opening />

    <section class="wrap selected" aria-labelledby="selected-title">
      <header class="selected__head">
        <h2 id="selected-title" class="section-title">Selected work</h2>
        <a class="textlink ui selected__all" href="#index">See everything</a>
      </header>
      {featured.map((item) => <Plate item={item} />)}
      <Workshop />
    </section>

    <WorkIndex />
    <Method />
    <Studio />
    <LatestNotes />
  </main>
  <Footer />
</Layout>

<style>
  .selected { padding-top: clamp(1rem, 3vw, 2rem); }

  .selected__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .selected__all { color: var(--color-ink-2); }
</style>
