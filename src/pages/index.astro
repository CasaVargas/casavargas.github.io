---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Lead from '../components/home/Lead.astro';
import Apps from '../components/home/Apps.astro';
import About from '../components/home/About.astro';
import LatestNotes from '../components/home/LatestNotes.astro';
import { caseStudies } from '../data/work';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'CasaVargas',
  legalName: 'Casa Vargas LLC',
  url: 'https://casavargas.app',
  logo: 'https://casavargas.app/casavargas-logo-orange.png',
  email: 'hello@casavargas.app',
  founder: { '@type': 'Person', name: 'Jon Vargas' },
  foundingDate: '2025',
  address: { '@type': 'PostalAddress', addressRegion: 'NC', addressCountry: 'US' },
  description:
    'Apps for the Mac, iPhone, iPad, Apple TV, Windows and Linux. No subscriptions: each app is paid for once, and several are free and open source.',
  sameAs: ['https://github.com/CasaVargas'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CasaVargas',
  url: 'https://casavargas.app',
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Apps by CasaVargas',
  itemListElement: caseStudies.map((w, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: w.name,
    url: `https://casavargas.app/work/${w.slug}/`,
  })),
};
---

<Layout>
  <JsonLd data={organizationSchema} />
  <JsonLd data={websiteSchema} />
  <JsonLd data={itemListSchema} />

  <Nav />
  <main id="main">
    <div class="wrap intro">
      <h1>CasaVargas makes Mac, iPhone and desktop apps.</h1>
      <p>
        No subscriptions. Each app is paid for once, and several are free and
        open source.
      </p>
    </div>

    <Lead />
    <Apps />
    <About />
    <LatestNotes />
  </main>
  <Footer />
</Layout>

<style>
  .intro { padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(2rem, 5vw, 3rem); }

  h1 {
    margin: 0;
    max-width: 15em;
    font-size: clamp(2.25rem, 5.6vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .intro p {
    margin: 1.1rem 0 0;
    max-width: 30em;
    font-size: clamp(1.125rem, 1.8vw, 1.3125rem);
    line-height: 1.45;
    color: var(--color-ink-2);
  }
</style>
