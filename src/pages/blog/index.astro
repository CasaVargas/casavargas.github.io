---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Layout
  title="Notes — CasaVargas"
  description="Notes from a one-person software studio: native versus cross-platform, pricing without subscriptions, and how the apps are built."
>
  <Nav />

  <main id="main" class="wrap notes-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Notes' }]} />

    <header class="head">
      <h1>Notes</h1>
      <p class="lede">
        Writing from the studio: how the apps are built, and why they’re built that way.
      </p>
    </header>

    <ol class="list">
      {posts.map((post) => (
        <li class="entry">
          <time class="ui entry__date" datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
          <div>
            <h2 class="entry__title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p class="entry__desc">{post.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </main>

  <Footer />
</Layout>

<style>
  .notes-page { padding-block: clamp(2rem, 5vw, 3rem) clamp(4rem, 9vw, 7rem); }

  .head { margin: clamp(2rem, 5vw, 3.5rem) 0 clamp(2.5rem, 5vw, 4rem); }

  h1 {
    margin: 0;
    font-weight: 300;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .lede {
    margin: 1.4rem 0 0;
    max-width: 28em;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.4;
    color: var(--color-ink-2);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 0.4rem 3rem;
    padding-block: 1.8rem;
    border-bottom: 1px solid var(--color-line);
  }

  .entry__date { color: var(--color-ink-3); padding-top: 0.55rem; }

  .entry__title {
    margin: 0;
    font-weight: 400;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.012em;
  }
  .entry__title a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .entry__title a:hover { color: var(--color-amber); }

  .entry__desc {
    margin: 0.5rem 0 0;
    max-width: 38em;
    color: var(--color-ink-2);
  }

  @media (max-width: 760px) {
    .entry { grid-template-columns: 1fr; }
    .entry__date { padding-top: 0; }
  }
</style>
