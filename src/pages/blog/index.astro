---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const title = 'Notes — CasaVargas';
const description =
  'Articles on indie app development, native software, AI tools, and building without subscriptions.';
---

<Layout title={title} description={description}>
  <Nav />

  <main>
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Notes' }]} />

      <header class="head">
        <p class="eyebrow">Notes</p>
        <h1>Working in the open</h1>
        <p class="lede">
          Thoughts on building native software, AI tools, and running a one-person studio.
        </p>
      </header>

      {posts.length === 0 ? (
        <p class="empty">No posts yet. Check back soon.</p>
      ) : (
        <ol class="posts">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="post">
                <div class="post__meta">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                  {post.data.tags.slice(0, 3).map((tag) => <span class="chip">{tag}</span>)}
                </div>
                <h2>{post.data.title}</h2>
                <p class="post__desc">{post.data.description}</p>
                <span class="post__more">Read &rarr;</span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  main { padding: 7rem 0 6rem; }

  .wrap {
    max-width: 58rem;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .head { margin: 1.5rem 0 3rem; }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .lede {
    margin: 1.1rem 0 0;
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 34rem;
  }

  .empty { color: var(--color-text-tertiary); font-size: 0.9rem; }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .post {
    display: block;
    padding: 1.6rem;
    border-radius: 16px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .post:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
    box-shadow: 0 18px 44px -18px rgba(0, 0, 0, 0.8);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }
  .post__meta time {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-tertiary);
  }
  .chip {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: rgba(239, 159, 39, 0.12);
    color: var(--color-accent);
  }

  .post h2 {
    margin: 0 0 0.5rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
  }
  .post__desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--color-text-secondary);
  }
  .post__more {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    main { padding: 5.5rem 0 4rem; }
    .wrap { padding: 0 1.5rem; }
    .head { margin-bottom: 2rem; }
  }
</style>
