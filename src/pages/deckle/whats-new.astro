---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import Shot from '../../components/ui/Shot.astro';
import delivery from '../../assets/deckle/delivery.png';
import comic from '../../assets/deckle/books-comic.png';
import koreader from '../../assets/deckle/koreader.png';
import welcomeSave from '../../assets/deckle/welcome-save.png';
import search from '../../assets/deckle/puzzles/search.png';
import crossword from '../../assets/deckle/puzzles/crossword.png';
import sudoku from '../../assets/deckle/puzzles/sudoku.png';

// What's new in Deckle, release by release, in plain words. The source is the
// repo's CHANGELOG.md at the version named; nothing here is promised ahead of a
// tag. Same rules as /deckle/: fictional demo data in every shot, no DRM talk,
// Kindle Previewer is Amazon's, no em dashes.
const repo = 'https://github.com/CasaVargas/deckle';
const release = `${repo}/releases/tag/v0.11.0`;
const download = `${repo}/releases/latest`;

interface Item { title: string; body: string }
interface Theme { id: string; title: string; why?: string; items: Item[] }

const themes: Theme[] = [
  {
    id: 'remarkable',
    title: 'The reMarkable, wireless and with books',
    why: 'Until now a reMarkable only got the daily paper, only over the USB cable.',
    items: [
      { title: 'Send books to it.', body: 'A comic arrives as a PDF with one picture per page, sized to the tablet’s screen. Any other book arrives as an EPUB, with its Who’s who page and recaps if you asked for them. Books wait in a queue until the tablet answers, then go over on the next push, whether or not the paper is set up for it. There is a Send to reMarkable button on the app’s Inbox.' },
      { title: 'Delivery over SSH and Wi-Fi, into a Deckle folder.', body: 'Deckle can log in to the tablet directly instead of using its USB web page: Wi-Fi as well as cable, a Deckle folder so papers don’t clutter the home screen, and old papers cleaned up. You give Deckle the tablet’s password once, from its own Settings, Help, About; it is kept in your system keychain, and the tablet’s identity is remembered so nothing else can stand in for it. The tablet shows new files only after its reader restarts, which would interrupt you mid-note, so Deckle restarts it only after the tablet has sat idle for ten minutes, and tells you otherwise.' },
      { title: 'Deckle never changes a tablet setting.', body: 'Turning on SSH over Wi-Fi, or Developer Mode on a Paper Pro (which wipes the tablet), are steps you take yourself, and the docs say so.' },
      { title: 'Easier to reach.', body: 'An Address field points Deckle at a tablet on your Wi-Fi rather than only through the USB link, and the devices list shows the tablet when it answers. The docs explain how the tablet can pull the paper from Dropbox, Google Drive or OneDrive on its own, with no cloud account on Deckle’s side.' },
      { title: 'The Paper Pro Move gets colour.', body: 'It had been treated as a grey screen, so photos and comic pages arrived without colour. It has the same colour panel as the Paper Pro.' },
    ],
  },
  {
    id: 'comics',
    title: 'Comics, manga and scanned books on every reader',
    why: 'Deckle only handled text books before. Now a page of pictures goes to each reader as pictures, fitted to its screen.',
    items: [
      { title: 'Bring in a comic any way you have it.', body: 'A CBZ, a CBR, a folder of page images, a fixed-layout EPUB, or a scanned PDF with or without an invisible text layer. Drop it in the app, keep it in the library, or queue it from the Inbox. Two-page spreads are split at import.' },
      { title: 'Kindle.', body: 'Comics arrive as a fixed-layout AZW3, which the Kindle opens as it would a bought comic. Each Kindle model gets pages fitted to its own screen, nineteen models known by their serial number, the Colorsoft in colour. Checked on a Kindle Scribe.' },
      { title: 'Kobo and PocketBook.', body: 'Comics go as a fixed-layout EPUB, without the markup Deckle normally adds for a Kobo, which would break picture pages. Thirty Kobo models are recognised and fitted.' },
      { title: 'Reads right to left.', body: 'A checkbox on the comic’s row in the app, remembered per book, for manga. The command line has the same switch, and a comic that says so in its own metadata needs neither.' },
      { title: 'Send a PDF as it is.', body: 'The send command used to treat every file as a Kindle book. A PDF or other Kindle document is now copied over untouched under its own name, which on a Scribe is a document you can write on.' },
    ],
  },
  {
    id: 'puzzles',
    title: 'Puzzle books you solve in ink on a Kindle Scribe',
    why: 'A device test settled that only a PDF takes pen ink on the Scribe, so these are PDFs: a title page, one puzzle per page, answers at the back.',
    items: [
      { title: 'Word search books.', body: 'Pick the size and directions, or give your own words. Every puzzle is checked against a blocklist so nothing rude appears by accident.' },
      { title: 'Crossword books.', body: 'Any size from 5×5 to 15×15, filled from a new 45,000-word clue list drawn from Wiktionary. A grid that won’t fill falls back to rarer words and says so.' },
      { title: 'Themed crosswords from your own words.', body: 'Give a file of words and clues, and each puzzle seeds as many of them as will fit, marked as theme answers.' },
      { title: 'Sudoku books.', body: 'Easy, medium and hard, each with exactly one solution. A hard puzzle is always solvable by logic, never guessing.' },
      { title: 'Repeatable.', body: 'The same options, seed and date make the same book, byte for byte, and each run prints the command that makes it again. Books go to a folder, or straight to a plugged-in Kindle, and come sized for a Scribe, a reMarkable, an iPad or A5 paper.' },
    ],
  },
  {
    id: 'recaps',
    title: 'AI recaps for books, without spoilers',
    why: 'Optional, using the model you already set up for X-Ray (Anthropic, OpenAI, or a local server). Nothing is bundled and nothing is sent unless you turn it on.',
    items: [
      { title: 'Chapter recaps.', body: 'A short labelled recap at the end of each chapter, written from that chapter alone so it can’t spoil what’s ahead. For Kindle, Kobo, PocketBook, a reMarkable and any EPUB reader. Results are cached, so a book is never summarised twice.' },
      { title: 'A Summary page.', body: 'At the back of the book, the whole story including the ending, built from the chapter recaps rather than sending the book’s text again.' },
      { title: 'A Previously page.', body: 'For a later book in a series, what happened in the earlier ones, placed before chapter one. It is written only from the earlier books’ recaps, so it can’t spoil the one you’re starting.' },
      { title: 'In the app and on the command line.', body: 'Settings, Reading aids has the switch and each book a toggle. Asking for recaps without a model now stops up front rather than after the whole conversion.' },
    ],
  },
  {
    id: 'koreader',
    title: 'KOReader as a first-class reader',
    why: 'KOReader runs on jailbroken Kindles, Kobos, PocketBooks, Boox tablets and reMarkables. Deckle now reads from it, serves it, and manages it.',
    items: [
      { title: 'Highlights and progress from any reader running it.', body: 'Deckle reads KOReader’s files beside each book, over USB or from a folder the reader syncs back, never writes them, and installs nothing on the reader for it.' },
      { title: 'Today’s paper over Wi-Fi, no cable.', body: 'Deckle’s background watcher serves a catalog on your home network. KOReader on any e-reader browses it and downloads the paper and your books. One account, a password of your choosing, nothing leaves the house.' },
      { title: 'Progress sync, served by Deckle.', body: 'Point KOReader’s own sync at Deckle and every reader reports how far you read, down to the section of the paper.' },
      { title: 'A Deckle plugin for KOReader.', body: 'It fetches the morning paper on its own when the reader wakes or joins Wi-Fi, checks the download, and tidies its own old papers. One tap sets up progress sync.' },
      { title: 'Plugin management.', body: 'List, install, update, remove and roll back KOReader plugins from a zip, a folder or a GitHub release, over USB. Switch them on and off. Plugins are included in backup and restore of KOReader’s settings and reading data.' },
      { title: 'A plugin store.', body: 'A reviewed, pinned list of recommended plugins. Each install is checked byte for byte against the reviewed file.' },
      { title: 'Settings, KOReader in the app.', body: 'The plugged-in reader, the Deckle plugin, your plugins with switches, and the store.' },
      { title: 'Papers open as designed.', body: 'Each paper Deckle sends carries KOReader settings so it opens with the right margins and fonts, written once and never over your own.' },
    ],
  },
  {
    id: 'calibre',
    title: 'Deckle as the bridge to your calibre library',
    why: 'calibre stays the library of record. Deckle moves books out and reading data back, over Wi-Fi, and never edits calibre’s database.',
    items: [
      { title: 'KOReader’s calibre connection, answered by Deckle.', body: 'Tap Connect in KOReader and Deckle appears as calibre would. Books, calibre books and the paper go to the reader over Wi-Fi, with no plugin and no calibre running. The app shows every reader that has connected, its books and free space, and a queue.' },
      { title: 'Reading data back into calibre.', body: 'Progress, finished, last read and rating go into calibre columns you choose, through calibre’s own tools. Off by default, with a preview, and a value you changed in calibre is left alone.' },
      { title: 'Highlights into calibre.', body: 'Every highlight and note as Markdown in a column, and optionally into calibre’s own annotations.' },
      { title: 'Shelves from calibre rules.', body: 'A tag, series, author, column or saved search becomes a shelf on a Kobo or a collection in KOReader, holding the books that are actually on the reader. Only shelves Deckle made are ever changed.' },
    ],
  },
  {
    id: 'kobo',
    title: 'Kobo and PocketBook catch up with the Kindle',
    items: [
      { title: 'Who’s who.', body: 'The people, places and terms Deckle finds for a Kindle’s X-Ray now go inside the EPUB as a Who’s who page at the back. The first mention of each name in a chapter links to its entry, and back.' },
      { title: 'The paper to a Kobo over Dropbox.', body: 'Point an export folder at Dropbox’s Rakuten Kobo folder as KEPUB and the Kobo fetches the paper each morning when you tap Sync. Deckle still signs in to nothing.' },
    ],
  },
  {
    id: 'paper',
    title: 'The daily paper',
    items: [
      { title: 'A daily word search.', body: 'A 9×9 grid with eight to ten hidden words, beside the mini crossword, with yesterday’s answers, in every edition.' },
      { title: 'No repeat crosswords.', body: 'The mini once printed the same grid two days running, with the answers printed above it. A grid from the last sixty days is never reused.' },
      { title: 'Google News stories read in full again.', body: 'For a week, every story linked through Google News arrived as a stub. Dropped connections are retried and the reply is parsed properly.' },
      { title: 'Teasers stop at a sentence.', body: 'One teaser was a whole 37,000-character article. Teasers now end at a whole sentence within about 300 characters, and spaces around italics are kept.' },
      { title: 'No more “Full story unavailable offline.”', body: 'A story the paper couldn’t fetch whole still runs as a brief after the full stories, without that line.' },
      { title: 'Kindle readership works again.', body: 'The print layout’s section folios had hidden every section from the readership report.' },
    ],
  },
  {
    id: 'app',
    title: 'The app and the importers',
    items: [
      { title: 'A welcome on first launch.', body: 'Four short pages: your paper and its morning schedule, the bookmarklets, and where things live. Beside them sits tomorrow’s front page in miniature, in your paper’s name and masthead face; the first story you save lands on it as a clipping. Settings, About shows it again.' },
      { title: 'Bookmarklets you drag, not paste.', body: 'An install page opens in your browser with Save to paper and Save recipe as buttons you drag to the bookmarks bar, with notes for each browser. Copying still works.' },
      { title: 'Messy Word and PDF files get their structure back.', body: 'A document with no real headings gets chapters recognised from size, weight and “Chapter” lines, with no model and no network. Documents that already have structure convert as before.' },
    ],
  },
  {
    id: 'fixes',
    title: 'Fixes you’d otherwise hit',
    items: [
      { title: 'The watcher restarts after an update.', body: 'It used to keep running the old build until the next login, so a new bookmarklet hit an old watcher and got Not found.' },
      { title: 'Kindle Previewer runs one conversion at a time.', body: 'Two at once shared a scratch folder and both failed. Jobs now wait their turn.' },
      { title: 'Found on real readers.', body: 'KOReader’s own SSH plugin no longer gets Update and Remove buttons; a reader’s free space shows correctly instead of 0 MB; the paper goes over the calibre connection once, not on every connect.' },
      { title: 'Comics and scans.', body: 'A comic with a wide title banner no longer stretches every page to the banner’s shape on a Kindle, and a scan with an invisible OCR layer is treated as a scan, not as text to reflow.' },
    ],
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'What’s new in Deckle 0.11',
  datePublished: '2026-11-02',
  url: 'https://casavargas.app/deckle/whats-new/',
  about: { '@type': 'SoftwareApplication', name: 'Deckle', softwareVersion: '0.11.0', url: 'https://casavargas.app/deckle/' },
  author: { '@type': 'Organization', name: 'Casa Vargas LLC', url: 'https://casavargas.app' },
};
---

<Layout
  title="What’s new in Deckle 0.11 | Every reader, comics, puzzle books and KOReader"
  description="Deckle 0.11 sends books and the paper to a reMarkable over Wi-Fi, fits comics and manga to every reader, makes puzzle books you solve in ink on a Kindle Scribe, writes AI recaps without spoilers, serves and manages KOReader, and bridges your calibre library. In plain words, with screenshots."
  ogImage="/og/deckle.png"
>
  <JsonLd data={schema} />
  <Nav />

  <main id="main" class="wn">
    <header class="wrap wn-head">
      <p class="wn-crumb"><a class="textlink" href="/deckle/">Deckle</a></p>
      <h1 class="wn-title">What’s new in 0.11</h1>
      <p class="wn-lede">
        Released 2 November 2026, three days after 0.10. About sixty pull requests in ten
        themes, from a reMarkable that takes books over Wi-Fi to puzzle books you solve with
        a pen. Everything below is in the download; nothing is promised ahead of it.
      </p>
      <p class="wn-actions">
        <a class="wn-button" href={download} rel="noopener">Download 0.11</a>
        <a class="textlink" href={release} rel="noopener">The release on GitHub</a>
        <a class="textlink" href="/deckle/#dk-readers">What each reader gets</a>
      </p>
      <nav class="wn-nav ui" aria-label="Themes">
        {themes.map((t) => <a href={`#${t.id}`}>{t.title}</a>)}
      </nav>
    </header>

    {themes.map((t, i) => (
      <>
        <section class="wrap wn-theme" id={t.id} aria-labelledby={`${t.id}-h`}>
          <div class="wn-theme__side">
            <h2 id={`${t.id}-h`} class="wn-h2">{t.title}</h2>
            {t.why && <p class="wn-why">{t.why}</p>}
          </div>
          <dl class="wn-items">
            {t.items.map((it) => (
              <div>
                <dt>{it.title}</dt>
                <dd>{it.body}</dd>
              </div>
            ))}
          </dl>
        </section>

        {t.id === 'remarkable' && (
          <div class="wrap wn-figure">
            <Shot shot={{ src: delivery, kind: 'window', alt: 'Deckle’s Daily tab, Delivery: a reMarkable Paper Pro reached by its address over Wi-Fi beside the Kindle, a Kobo, KOReader over Wi-Fi and the calibre connection. Shown with a fictional setup.' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
          </div>
        )}
        {t.id === 'comics' && (
          <div class="wrap wn-figure wn-figure--left">
            <Shot shot={{ src: comic, kind: 'window', alt: 'Deckle’s Books tab with a public-domain comic beside the novels, its row open to the Reads right to left checkbox and the fixed-layout note' }} width={1000} sizes="(max-width: 900px) 100vw, 64vw" />
          </div>
        )}
        {t.id === 'puzzles' && (
          <div class="wrap wn-trio">
            <Shot shot={{ src: search, kind: 'reader', alt: 'A page of a Deckle word search book on an e-reader: a 12 by 12 grid of letters with the hidden words listed beneath' }} sizes="(max-width: 900px) 31vw, 20vw" />
            <Shot shot={{ src: crossword, kind: 'reader', alt: 'A page of a Deckle crossword book on an e-reader: an 11 by 11 numbered grid with the across clues in two columns beneath' }} sizes="(max-width: 900px) 31vw, 20vw" />
            <Shot shot={{ src: sudoku, kind: 'reader', alt: 'A page of a Deckle sudoku book on an e-reader: a nine by nine grid with the givens in a bold serif' }} sizes="(max-width: 900px) 31vw, 20vw" />
          </div>
        )}
        {t.id === 'koreader' && (
          <div class="wrap wn-figure">
            <Shot shot={{ src: koreader, kind: 'window', alt: 'Deckle’s Settings, KOReader page: a plugged-in Kobo running KOReader, the Deckle plugin installed, the reader’s plugins with switches, and the plugin store’s recommended list' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
          </div>
        )}
        {t.id === 'app' && (
          <div class="wrap wn-figure wn-figure--left">
            <Shot shot={{ src: welcomeSave, kind: 'window', alt: 'Deckle’s welcome, on its Save to paper page: the first saved story has landed as a clipping on the miniature front page beside the bookmarklet buttons' }} width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
          </div>
        )}
      </>
    ))}

    <section class="wrap wn-earlier" aria-labelledby="wn-earlier">
      <h2 id="wn-earlier" class="wn-h2">Earlier</h2>
      <dl class="wn-items wn-items--earlier">
        <div><dt>0.10, 30 October</dt><dd>Deckle on Linux: a container that prints the paper headless and serves the app to a browser, email-only papers without Kindle Previewer, and a new icon.</dd></div>
        <div><dt>0.9, 28 October</dt><dd>No more console windows on Windows, Save recipe on sites that block apps, and a plain word when a site refuses Deckle.</dd></div>
        <div><dt>0.8, 28 October</dt><dd>The Kitchen Book cookbook, a Daily that looks printed, and newspaper columns in the PDF edition.</dd></div>
        <div><dt>0.7, 26 October</dt><dd>A redesigned app, interests, many papers, papers you subscribe to, ten masthead faces.</dd></div>
      </dl>
      <p class="wn-note">
        The full history, version by version, is in the
        <a class="textlink" href={`${repo}/blob/main/CHANGELOG.md`} rel="noopener">changelog</a>.
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .wn-head {
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(2rem, 5vw, 3.5rem);
    max-width: calc(var(--page-max));
  }
  .wn-crumb { margin: 0 0 1.2rem; font-size: 1.0625rem; color: var(--color-ink-3); }
  .wn-title {
    margin: 0;
    font-weight: 290;
    font-size: clamp(2.75rem, 7vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
    animation: settle 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .wn-lede {
    max-width: 36em;
    margin: 1.75rem 0 0;
    font-size: clamp(1.15rem, 1.55vw, 1.375rem);
    line-height: 1.55;
    color: var(--color-ink-2);
    text-wrap: pretty;
    animation: settle 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both;
  }
  .wn-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
    margin: 2rem 0 0;
    font-size: 1.0625rem;
    animation: settle 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both;
  }
  .wn-button {
    display: inline-block;
    padding: 0.85rem 1.4rem;
    border-radius: 8px;
    background: var(--color-ink);
    color: var(--color-ground);
    font-family: var(--font-sans);
    font-size: 0.975rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .wn-button:hover { background: var(--color-amber); }

  /* The contents: one row of underlined links, the way the site does links. */
  .wn-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-2);
  }
  .wn-nav a {
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.22em;
  }
  .wn-nav a:hover { color: var(--color-amber); text-decoration-color: currentColor; }

  .wn-theme {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 1.5rem clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    background: linear-gradient(var(--color-line), var(--color-line)) center top / calc(100% - 2 * var(--gutter)) 1px no-repeat;
  }
  .wn-h2 {
    margin: 0;
    font-weight: 340;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .wn-why {
    margin: 1rem 0 0;
    max-width: 20em;
    color: var(--color-ink-3);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .wn-items {
    margin: 0;
    display: grid;
    gap: 1.4rem;
    max-width: 40em;
  }
  .wn-items dt {
    display: inline;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .wn-items dd {
    display: inline;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .wn-items dt::after { content: ' '; }

  .wn-figure { padding-bottom: clamp(3rem, 7vw, 5rem); }
  .wn-figure :global(.frame) { max-width: 56rem; margin-left: auto; }
  .wn-figure--left :global(.frame) { margin-left: 0; margin-right: auto; }

  .wn-trio {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(0.75rem, 2.5vw, 2.25rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  .wn-trio :global(.reader) { width: min(28%, 340px); }
  .wn-trio :global(.reader:nth-child(2)) { width: min(32%, 400px); transform: translateY(-1.5rem); }

  .wn-earlier {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3.5rem, 8vw, 6rem);
    background: linear-gradient(var(--color-line), var(--color-line)) center top / calc(100% - 2 * var(--gutter)) 1px no-repeat;
  }
  .wn-items--earlier { margin-top: 1.5rem; }
  .wn-items--earlier dt { display: block; }
  .wn-items--earlier dd { display: block; margin-top: 0.3rem; }
  .wn-note { margin: 2rem 0 0; font-size: 1rem; color: var(--color-ink-3); }

  @keyframes settle {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 860px) {
    .wn-theme { grid-template-columns: minmax(0, 1fr); }
    .wn-trio { gap: 0.6rem; }
    .wn-trio :global(.reader) { width: 31%; }
    .wn-trio :global(.reader:nth-child(2)) { width: 36%; transform: translateY(-0.75rem); }
  }
</style>
