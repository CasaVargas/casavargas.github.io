---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import Card from '../../components/ui/Card.astro';
import cardInterest from '../../assets/deckle/cards/05-a-crossword-about-anything.png';
import cardAi from '../../assets/deckle/cards/06-ai-on-your-mac.png';
import cardInk from '../../assets/deckle/cards/12-puzzle-books-in-ink.png';

// What's new in Deckle, release by release, in plain words. The source is the
// repo's CHANGELOG.md at the version named; nothing here is promised ahead of a
// tag. Same rules as /deckle/: fictional demo data in every shot, no DRM talk,
// Kindle Previewer is Amazon's, no em dashes.
const repo = 'https://github.com/CasaVargas/deckle';
const release = `${repo}/releases/tag/v0.12.0`;
const download = `${repo}/releases/latest`;

interface Item { title: string; body: string }
interface Theme { id: string; title: string; why?: string; items: Item[] }

const themes: Theme[] = [
  {
    id: 'puzzles',
    title: 'A Puzzles tab, and books about what you love',
    why: 'Puzzle books were a command. Now they are a tab, with four more kinds, and a crossword can be about your own interests.',
    items: [
      { title: 'Type an interest, get a crossword about it.', body: 'A theme for a crossword or word search: your interest sections (pick which) or the whole week’s paper, with the week’s headline words as answers and the headline as the clue; the words you looked up on the Kindle, clued with the definition you tapped; your cookbook’s dishes and ingredients; your own list; or a subject the AI writes about, words and clues both.' },
      { title: 'Clues in a style.', body: 'With the AI on, any crossword’s clues can be rewritten as trivia, cryptic, or for a kid, one request a puzzle, every clue checked so it never names its answer. A puzzle whose request fails keeps its plain clues.' },
      { title: 'Seven kinds.', body: 'Crossword, word search and sudoku, and now word ladders (three a page, the rungs by difficulty), cryptograms (public domain quotes or your own, letters given by difficulty, a key to work in), nonograms (Deckle’s pictures and shapes, every one solvable by line logic, or your own photo as the first puzzle) and mazes (6 to 40 a side, the path drawn in the answers).' },
      { title: 'The tab.', body: 'Pick a kind, size, difficulty, count, screen and title, and watch the first page as it will print. Every book is kept with the options that made it, so Make again gives the same book; Send copies it to the plugged-in Kindle and Save a copy puts it in a folder. The same on the command line: deckle puzzles crossword --theme interests --clues trivia.' },
    ],
  },
  {
    id: 'ai',
    title: 'An AI on your own Mac, with nothing to configure',
    why: 'Running a local model used to mean a terminal, a model name and a context size you had to know about. Now it is a checklist.',
    items: [
      { title: 'Settings, AI.', body: 'One page for where the AI runs, for X-Ray, chapter recaps, the paper’s editor and puzzle clues alike: Off, On this Mac, or A service online. On this Mac fills itself in: Ollama running (with a Get Ollama button and a check every few seconds until it answers), the model installed (Download, with a progress bar and a Stop), and Try it. Advanced lists every model Ollama has and takes an address for Ollama on another computer.' },
      { title: 'Ollama, spoken natively.', body: 'Deckle talks to Ollama’s own API instead of its OpenAI-compatible shim, so it sets the context size itself (the paper’s editor used to overflow Ollama’s default silently), turns thinking off, holds the model to a schema, and needs no key. The model is qwen3:4b, or qwen3:8b on a machine with 16 GB or more. On the command line, deckle llm check says what is missing and deckle llm pull downloads the model.' },
      { title: 'One setting for the paper too.', body: 'A paper’s editor now runs where Settings, AI says, so there is nothing to copy between Books and the Daily. A paper that names its own provider keeps it, under Advanced on its sheet.' },
      { title: 'In Docker.', body: 'An Ollama service beside Deckle behind the ai profile, so the web app’s checklist works in the container with the address left blank.' },
    ],
  },
  {
    id: 'welcome',
    title: 'The welcome shows the back pages',
    items: [
      { title: 'A fourth page in the first-launch tour.', body: 'The Mini with yesterday’s headlines as its answers, the word search, the word ladder, the almanac, the horoscope and On this day, how a Kindle’s notes mark the answers, the puzzle books to write on, From Your Shelf, and the AI model, with a link straight to Settings, AI.' },
    ],
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'What’s new in Deckle 0.12',
  datePublished: '2026-11-03',
  url: 'https://casavargas.app/deckle/whats-new/',
  about: { '@type': 'SoftwareApplication', name: 'Deckle', softwareVersion: '0.12.0', url: 'https://casavargas.app/deckle/' },
  author: { '@type': 'Organization', name: 'Casa Vargas LLC', url: 'https://casavargas.app' },
};
---

<Layout
  title="What’s new in Deckle 0.12 | A crossword about anything, and an AI on your own Mac"
  description="Deckle 0.12 adds a Puzzles tab with seven kinds of book to solve in ink, crosswords themed on your interests, the week’s paper, your looked-up words, your cookbook or a subject an AI writes, and a Settings, AI page that sets up a local model through Ollama by itself. In plain words."
  ogImage="/og/deckle-hero.jpg"
>
  <JsonLd data={schema} />
  <Nav />

  <main id="main" class="wn">
    <header class="wrap wn-head">
      <p class="wn-crumb"><a class="textlink" href="/deckle/">Deckle</a></p>
      <h1 class="wn-title">What’s new in 0.12</h1>
      <p class="wn-lede">
        Released 3 November 2026, the day after 0.11. A fifth tab makes puzzle books about what
        you love, and the AI that clues them runs on your own Mac from a page that sets itself
        up. Everything below is in the download; nothing is promised ahead of it.
      </p>
      <p class="wn-actions">
        <a class="wn-button" href={download} rel="noopener">Download 0.12</a>
        <a class="textlink" href={release} rel="noopener">The release on GitHub</a>
        <a class="textlink" href="/deckle/#dk-readers">What each reader gets</a>
      </p>
      <nav class="wn-nav ui" aria-label="Themes">
        {themes.map((t) => <a href={`#${t.id}`}>{t.title}</a>)}
      </nav>
    </header>

    {themes.map((t, i) => (
      <>
        <section class="wrap wn-theme" id={t.id} aria-labelledby={`${t.id}-h`}>
          <div class="wn-theme__side">
            <h2 id={`${t.id}-h`} class="wn-h2">{t.title}</h2>
            {t.why && <p class="wn-why">{t.why}</p>}
          </div>
          <dl class="wn-items">
            {t.items.map((it) => (
              <div>
                <dt>{it.title}</dt>
                <dd>{it.body}</dd>
              </div>
            ))}
          </dl>
        </section>

        {t.id === 'puzzles' && (
          <>
            <div class="wrap wn-figure">
              <Card src={cardInterest} alt="Type an interest, get a crossword about it: the subject field reads Star Wars, theme chips for your interests, this week’s paper, words you looked up, your cookbook and your own list, clue styles plain, trivia, cryptic and for a kid, and a Kindle Scribe showing the crossword inked in" width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
            </div>
            <div class="wrap wn-figure wn-figure--left">
              <Card src={cardInk} alt="Seven kinds of puzzle book, solved in ink: crossword, word search, sudoku, word ladder, cryptogram, nonogram from your own photo, and maze, with a Kindle Scribe showing a nonogram half shaded in pen" width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
            </div>
          </>
        )}
        {t.id === 'ai' && (
          <div class="wrap wn-figure">
            <Card src={cardAi} alt="AI on your own Mac: the Settings, AI page with Off, On this Mac and A service online, and the On this Mac checklist with Ollama running, the model downloaded and Try it" width={1100} sizes="(max-width: 900px) 100vw, 64vw" />
          </div>
        )}
      </>
    ))}

    <section class="wrap wn-earlier" aria-labelledby="wn-earlier">
      <h2 id="wn-earlier" class="wn-h2">Earlier</h2>
      <dl class="wn-items wn-items--earlier">
        <div><dt>0.11, 2 November</dt><dd>Books and the paper to a reMarkable over Wi-Fi, comics and manga fitted to every reader, the first puzzle books to solve in ink, AI recaps without spoilers, KOReader served and managed, the bridge to calibre, and a Who’s who page on a Kobo or PocketBook.</dd></div>
        <div><dt>0.10, 30 October</dt><dd>Deckle on Linux: a container that prints the paper headless and serves the app to a browser, email-only papers without Kindle Previewer, and a new icon.</dd></div>
        <div><dt>0.9, 28 October</dt><dd>No more console windows on Windows, Save recipe on sites that block apps, and a plain word when a site refuses Deckle.</dd></div>
        <div><dt>0.8, 28 October</dt><dd>The Kitchen Book cookbook, a Daily that looks printed, and newspaper columns in the PDF edition.</dd></div>
        <div><dt>0.7, 26 October</dt><dd>A redesigned app, interests, many papers, papers you subscribe to, ten masthead faces.</dd></div>
      </dl>
      <p class="wn-note">
        The full history, version by version, is in the
        <a class="textlink" href={`${repo}/blob/main/CHANGELOG.md`} rel="noopener">changelog</a>.
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .wn-head {
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(2rem, 5vw, 3.5rem);
    max-width: calc(var(--page-max));
  }
  .wn-crumb { margin: 0 0 1.2rem; font-size: 1.0625rem; color: var(--color-ink-3); }
  .wn-title {
    margin: 0;
    font-weight: 650;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .wn-lede {
    max-width: 36em;
    margin: 1.75rem 0 0;
    font-size: clamp(1.15rem, 1.55vw, 1.375rem);
    line-height: 1.55;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .wn-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
    margin: 2rem 0 0;
    font-size: 1.0625rem;
  }
  .wn-button {
    display: inline-block;
    padding: 0.85rem 1.4rem;
    border-radius: 8px;
    background: var(--color-ink);
    color: var(--color-ground);
    font-size: 0.975rem;
    font-weight: 600;
    text-decoration: none;
  }
  .wn-button:hover { background: var(--color-ink-2); }

  /* The contents: one row of underlined links, the way the site does links. */
  .wn-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-2);
  }
  .wn-nav a {
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.22em;
  }
  .wn-nav a:hover { color: var(--color-accent); text-decoration-color: currentColor; }

  .wn-theme {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 1.5rem clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    background: linear-gradient(var(--color-line), var(--color-line)) center top / calc(100% - 2 * var(--gutter)) 1px no-repeat;
  }
  .wn-h2 {
    margin: 0;
    font-weight: 650;
    font-size: clamp(1.375rem, 2.2vw, 1.625rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .wn-why {
    margin: 1rem 0 0;
    max-width: 20em;
    color: var(--color-ink-3);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .wn-items {
    margin: 0;
    display: grid;
    gap: 1.4rem;
    max-width: 40em;
  }
  .wn-items dt {
    display: inline;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .wn-items dd {
    display: inline;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .wn-items dt::after { content: ' '; }

  .wn-figure { padding-bottom: clamp(3rem, 7vw, 5rem); }
  .wn-figure :global(.frame),
  .wn-figure :global(.card) { max-width: 56rem; margin-left: auto; }
  .wn-figure--left :global(.frame),
  .wn-figure--left :global(.card) { margin-left: 0; margin-right: auto; }

  .wn-trio {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(0.75rem, 2.5vw, 2.25rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  .wn-trio :global(.reader) { width: min(28%, 340px); }
  .wn-trio :global(.reader:nth-child(2)) { width: min(32%, 400px); transform: translateY(-1.5rem); }

  .wn-earlier {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3.5rem, 8vw, 6rem);
    background: linear-gradient(var(--color-line), var(--color-line)) center top / calc(100% - 2 * var(--gutter)) 1px no-repeat;
  }
  .wn-items--earlier { margin-top: 1.5rem; }
  .wn-items--earlier dt { display: block; }
  .wn-items--earlier dd { display: block; margin-top: 0.3rem; }
  .wn-note { margin: 2rem 0 0; font-size: 1rem; color: var(--color-ink-3); }


  @media (max-width: 860px) {
    .wn-theme { grid-template-columns: minmax(0, 1fr); }
    .wn-trio { gap: 0.6rem; }
    .wn-trio :global(.reader) { width: 31%; }
    .wn-trio :global(.reader:nth-child(2)) { width: 36%; transform: translateY(-0.75rem); }
  }
</style>
