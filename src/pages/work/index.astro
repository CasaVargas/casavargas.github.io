---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WorkIndex from '../../components/WorkIndex.astro';
---

<Layout
  title="Apps | CasaVargas"
  description="Everything CasaVargas has shipped or is building: Beltr, OneScribe, DebridDownloader, and Cathode TV, Nimbus and AppPulse in development."
>
  <Nav />
  <main id="main">
    <div class="wrap crumbs-row">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Apps' }]} />
    </div>
    <WorkIndex
      as="h1"
      title="Apps"
      intro="Everything CasaVargas has shipped or is building, companion apps included. Each name opens a page on why it exists, what it does and how it’s built."
    />
  </main>
  <Footer />
</Layout>

<style>
  .crumbs-row { padding-top: clamp(2rem, 5vw, 3rem); padding-bottom: 1.5rem; }
  main :global(.index .section-title) { font-size: clamp(2.25rem, 5vw, 3.25rem); letter-spacing: -0.03em; line-height: 1.05; }
</style>
