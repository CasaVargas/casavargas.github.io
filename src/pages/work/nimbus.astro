---
import CaseStudy from '../../layouts/CaseStudy.astro';
import Composition from '../../components/ui/Composition.astro';
import NimbusStack from '../../components/figures/NimbusStack.astro';
import { bySlug } from '../../data/work';

// Facts from the Nimbus repo and its specs, 2026-11-08 (branches feat/ui-polish,
// feat/volumes-redesign, chore/open-source-readiness, merging for the open-source
// release). Never: a price (only the model), "sandboxed", "Mac App Store", "bundles
// rclone", performance targets, "never sees your password" as a blanket claim, the
// retired Tauri version, or roadmap items as if they exist. No em dashes.
const item = bySlug('nimbus');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Nimbus',
  description: item.tagline,
  url: 'https://casavargas.app/nimbus/',
  codeRepository: 'https://github.com/CasaVargas/Nimbus',
  operatingSystem: 'macOS',
  applicationCategory: 'UtilitiesApplication',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: { '@type': 'Organization', name: 'Casa Vargas LLC', url: 'https://casavargas.app' },
};
---

<CaseStudy
  slug="nimbus"
  title="Nimbus, cloud storage as Mac volumes, built on rclone | CasaVargas"
  description="How Nimbus is built: a native Mac app and Finder extension sharing one local rclone engine, a Disk-Utility-style pane per cloud, and rclone’s own config flow driving setup. A case study from CasaVargas."
  intro="Nimbus is an open-source Mac app for cloud storage. Each remote from S3, Google Drive, OneDrive, SFTP and the rest of rclone’s long list becomes a volume: a pane with its capacity, its Finder presence, its files and its transfers. It doesn’t reimplement any provider: it drives rclone and puts a native interface on top, including a Finder extension so your remotes show up where your files already are."
  problem="rclone is the most capable cloud-storage engine there is, but using it means a terminal and a config file. The usual alternative is one vendor app per cloud, each with its own sync folder and its own idea of how a Mac should behave. Nimbus keeps rclone’s reach and its open config format, and drops the command line."
  features={[
    { title: 'A remote is a volume', body: 'Select a cloud and one pane shows how full it is, whether it is in Finder, and its Files, Transfers, Finder and Settings tabs. Active transfers sit in a drawer at the bottom and as a progress capsule in the toolbar.' },
    { title: 'Your remotes, in Finder', body: 'A File Provider extension lists your volumes in Finder. Files download when you open them, and edits go back up. Or mount a remote as a network volume; those come back after a restart.' },
    { title: 'Browse like Finder', body: 'System document icons, column headers that sort, Finder’s selection rules, type-to-select, Quick Look, an inspector, and drag between clouds to copy.' },
    { title: 'Add a remote without the config file', body: 'A guided sheet asks only the questions rclone asks for that provider, and providers that use OAuth sign in through your browser. Existing rclone configs import as they are.' },
  ]}
  engineering={[
    { title: 'One engine, two clients', body: 'The app and its Finder extension talk to the same local rclone process through RcloneKit, a typed Swift client for rclone’s remote-control API. The engine’s port is shared through the app group, and no provider is ever reimplemented in Swift.' },
    { title: 'The rclone contract is tested, not assumed', body: 'Listing semantics and the configuration flow are pinned by tests that run the real rclone binary. The lesson written into the project: a mock proves the client’s shape, not the server’s contract.' },
    { title: 'Finder presence has one owner', body: 'Showing or hiding a volume in Finder flips the user’s intent first, then reconciles the File Provider domain in the background, and rolls back if registration fails. The sidebar switch, the header verb and the launch-time domain sync all go through the same code.' },
    { title: 'Quota from the call already being made', body: 'The status probe each remote gets on launch is rclone’s about call, which also returns used and total bytes. The capacity bars and the gauge come from that one response; providers that report no total get no gauge rather than a guess.' },
    { title: 'Finder-grade list on AppKit', body: 'The file table is a virtualized NSTableView hosting SwiftUI rows, so a ten-thousand-item folder scrolls like Finder while the rows stay declarative.' },
    { title: 'Rules the build enforces', body: 'The build fails on hard-coded font sizes, which protects Dynamic Type, and on any remote Swift package dependency.' },
  ]}
  record={[
    ['License', 'GPL-3.0-or-later'],
    ['Providers', 'More than 50, through rclone'],
    ['Tests', 'About 235 test functions across the app and RcloneKit'],
    ['Third-party packages', 'None'],
  ]}
  closing="Nimbus is open source and before 1.0. Signed builds will follow as a one-time purchase."
  schema={schema}
  ogImage="/og/work-nimbus.png"
>
  <Composition slot="lead" plate={item.plate!} eager />
  <NimbusStack slot="figure" />
</CaseStudy>
