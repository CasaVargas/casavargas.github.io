---
import CaseStudy from '../../layouts/CaseStudy.astro';
import Composition from '../../components/ui/Composition.astro';
import Shot from '../../components/ui/Shot.astro';
import { bySlug } from '../../data/work';
import downloads from '../../assets/debrid/downloads.jpg';

// Facts checked 2026-09-24 against the GitHub repo and releases. GPL-3.0, not
// MIT. Five build targets, Apple Silicon only on macOS. No "blazing-fast",
// "multi-threaded" or "accelerated". No piracy framing: screenshots use Linux
// installers, and the app ships with no search sources. See PLAN.md §8.
const item = bySlug('debrid-downloader');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DebridDownloader',
  description: item.tagline,
  url: 'https://github.com/CasaVargas/DebridDownloader',
  operatingSystem: 'macOS, Windows, Linux',
  applicationCategory: 'UtilitiesApplication',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: { '@type': 'Organization', name: 'CasaVargas LLC', url: 'https://casavargas.app' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<CaseStudy
  slug="debrid-downloader"
  title="DebridDownloader, an open-source desktop client for debrid services | CasaVargas"
  description="How DebridDownloader moves Real-Debrid, TorBox and Premiumize from a browser tab to a native desktop app, built with Tauri, Rust and React. A case study from CasaVargas."
  intro="DebridDownloader is a free, open-source desktop app for people who pay for Real-Debrid, TorBox or Premiumize. It replaces the browser tab: you add a link or a file, the service fetches it, and you download, stream or file the results without leaving the app. It runs on macOS, Windows and Linux."
  problem="Debrid services are run from a web dashboard. You add a link, wait, then click through file links one at a time and let the browser save each one. There is no queue to control, nothing files finished downloads where a media server expects them, and API tokens tend to end up pasted into scripts and extensions. DebridDownloader moves that workflow into a native app and keeps the credentials in the operating system’s keychain."
  features={[
    { title: 'Three services in one app', body: 'Connect Real-Debrid (with OAuth or a token), TorBox or Premiumize, and switch between them at any time.' },
    { title: 'A queue you control', body: 'Run one to ten downloads at once, with live speed and time remaining, an optional speed limit and a notification when each one finishes.' },
    { title: 'Stream before you download', body: 'Preview a video straight from your provider in a floating mini-player, without saving it first.' },
    { title: 'Files land where your library looks', body: 'Sort downloads into movie and TV folders using TMDB, trigger a library scan in Plex, Jellyfin or Emby, or send files to an rclone remote.' },
    { title: 'Handles links from the system', body: 'Set it as the default handler and new links add themselves. It stays in the tray and can start at login.' },
    { title: 'Keyboard first, secrets in the keychain', body: 'Command-K to search, arrow keys to move, Return to download. Tokens live in Keychain, Credential Manager or Secret Service, never in a settings file.' },
  ]}
  engineering={[
    { title: 'One trait, three services', body: 'A Rust async trait defines about a dozen operations, and each provider’s client translates its own API into shared types. The active provider can be swapped at runtime; commands clone it and release the lock before awaiting, so a slow network call never blocks a switch.' },
    { title: 'Progress is pushed, not polled', body: 'A Tokio semaphore caps how many downloads run at once. Each one streams to disk with its own cancellation handle, and progress reaches the React front end as events, at most every 100 ms. One speed limiter covers both local and rclone destinations.' },
    { title: 'A local streaming proxy', body: 'An Axum server on a random localhost port serves one URL per preview session and forwards range requests, so the player can seek inside a remote file.' },
    { title: 'Untrusted input goes through one door', body: 'Links arrive three ways: the system deep link, a hand-off from a second instance, and command-line arguments on a cold start. All three pass the same validator before anything reaches a provider.' },
    { title: 'Five targets from one workflow', body: 'A GitHub Actions matrix builds macOS on Apple Silicon, Windows on x64 and ARM64, and Linux on x64 and ARM64, with signed and notarized macOS builds and signed update bundles. Because Tauri uses the system web view, the installers stay under 9 MB.' },
  ]}
  record={[
    ['License', 'GPL-3.0'],
    ['Releases', '16, from version 1.0 in March 2026 to 1.6.4 in May 2026'],
    ['Installer size', '5.9 MB on Windows, 8.9 MB on macOS'],
    ['Contributors', 'Open to pull requests; version 1.6.4 included seven from an outside contributor'],
  ]}
  closing="DebridDownloader is free and open source. It needs an account with one of the three services."
  schema={schema}
>
  <Composition slot="lead" plate={item.plate!} eager />
  <div slot="figure" class="dd-figure">
    <Shot shot={{ src: downloads, kind: 'window', alt: 'The downloads view, shown with sample data: two installers in progress and a third queued' }} width={1100} sizes="(max-width: 900px) 100vw, 60vw" />
    <p class="dd-figure__caption">The downloads view, shown here with sample data.</p>
  </div>
</CaseStudy>

<style>
  .dd-figure { max-width: 52rem; margin-left: auto; }
  .dd-figure__caption {
    margin: 1rem 0 0;
    font-style: italic;
    color: var(--color-ink-2);
  }
</style>
