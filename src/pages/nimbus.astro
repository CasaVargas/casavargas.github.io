---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Shot from '../components/ui/Shot.astro';
import NimbusStack from '../components/figures/NimbusStack.astro';
import { bySlug } from '../data/work';
import homeDark from '../assets/nimbus/home-dark.png';
import volumeFiles from '../assets/nimbus/volume-files.png';
import volumeInspector from '../assets/nimbus/volume-inspector.png';
import volumeFinder from '../assets/nimbus/volume-finder.png';
import browserList from '../assets/nimbus/browser-list.png';
import browserGrid from '../assets/nimbus/browser-grid-tiles.png';
import finderThumbnails from '../assets/nimbus/finder-thumbnails.png';
import keepOnMac from '../assets/nimbus/keep-on-this-mac.png';
import companionBusy from '../assets/nimbus/companion-busy.png';
import companionSignIn from '../assets/nimbus/companion-sign-in.png';
import addCloud from '../assets/nimbus/add-cloud.png';
import settingsGeneral from '../assets/nimbus/settings-general-dark.png';
import settingsTransfers from '../assets/nimbus/settings-transfers.png';
import beltrTv from '../assets/beltr/tv-scoring.jpg';
import beltrJoin from '../assets/beltr/phone-join-bezel.webp';
import osBoarding from '../assets/onescribe/boarding-bezel.webp';

// Nimbus's product page, rebuilt 2026-11-08 in the shape of an Apple product
// page (one idea per band, a statement in two lines, screens set large, a
// bento of Finder features) in this site's own type and grounds. Every claim
// comes from the Nimbus README and the specs under docs/superpowers/specs at
// the state of 2026-11-08. The screenshots are real windows against a
// throwaway rclone config with made-up files: no account data.
// Rules (PLAN.md §8): no price (only the model), no "sandboxed", no "bundles
// rclone", no performance numbers, no Mac App Store, no roadmap item as if it
// exists, no em dashes.
const item = bySlug('nimbus');
const repo = 'https://github.com/CasaVargas/Nimbus';
const releases = `${repo}/releases`;
const download = `${repo}/releases/latest`;
// The release this page describes. The DMG is signed with a Developer ID
// certificate and notarized; Gatekeeper opens it without a warning.
const version = '0.9.1';
const dmg = `${repo}/releases/latest/download/Nimbus-${version}.dmg`;

const glance: [string, string][] = [
  ['50+', 'cloud providers, through rclone'],
  ['0', 'accounts, sign-ups or telemetry'],
  ['100%', 'native Swift 6 and SwiftUI'],
  ['1', 'engine: the rclone you already trust'],
];

const home = [
  { title: 'Plain language', body: '“Ready.” “Needs sign-in.” “Can’t reach this server right now.” No rclone vocabulary anywhere outside Settings › Advanced.' },
  { title: 'One banner at a time', body: 'When a cloud ends your session, Home says so and offers the sign-in button. Files already on your Mac stay safe; new changes wait until you’re back.' },
  { title: 'Worth a look', body: 'Gentle suggestions, like showing a cloud in Finder, with a one-click action and an × to dismiss. Never a nag.' },
];

const browse = [
  { title: 'The icons macOS uses', body: 'Files draw with the system’s own document icons and Finder’s folder, so a listing reads like one of Finder’s.' },
  { title: 'Finder’s selection rules', body: 'Click, shift-click, ⌘-click. Type a name to jump to it. Space for Quick Look. Column headers that sort.' },
  { title: 'Cloud status, quietly', body: 'A small cloud beside files not yet downloaded, a ring while one downloads, nothing at all for files already on disk.' },
  { title: 'Drag between clouds', body: 'Drop files from one volume onto another and Nimbus runs the copy through rclone and shows its progress.' },
];

const volume = [
  { title: 'A remote is a volume', body: 'Disk Utility shows you a drive: how full it is, what you can do to it, what is happening on it. Nimbus does that for a cloud, in one pane.' },
  { title: 'Capacity you can see', body: 'A bar under each volume in the sidebar and a used-and-free gauge in the pane, straight from the provider’s own quota.' },
  { title: 'Four tabs, one place', body: 'Files, Transfers, Finder and Settings, each scoped to that volume. Switching tabs never loses your place.' },
  { title: 'The inspector', body: 'Cloud status, size, dates, Keep on this Mac and the share link, for whatever you have selected.' },
];

const setup = [
  { title: 'rclone’s own questions', body: 'The flow is driven by rclone’s configuration state machine, so a new backend in rclone works in Nimbus with no app update.' },
  { title: 'Show all options when you want them', body: 'Power users get every advanced field. Everyone else never sees them.' },
  { title: 'Your existing config, as it is', body: 'Nimbus reads and writes the standard rclone config file. The rclone command line keeps working next to it, and an existing file imports with a preview.' },
  { title: 'Nothing half-finished', body: 'Cancel midway and no partial or unauthenticated remote is left behind.' },
];

const companion = [
  { title: 'Same truth everywhere', body: 'Home and the menu bar compute status from one shared, unit-tested model, so the two never disagree.' },
  { title: 'Open at login', body: 'Turn it on and Nimbus starts quietly in the menu bar, keeps your Finder volumes live and restores your network mounts.' },
  { title: 'Notifications, when they matter', body: 'A finished transfer, a failed one, a cloud that signed you out. Not a feed.' },
];

const transfers = [
  { title: 'Conflicts, asked once', body: 'Drag onto another cloud and Nimbus asks how to handle duplicates before anything moves.' },
  { title: 'Speed you control', body: 'A plain-language speed menu limits bandwidth so a big sync never takes over your connection.' },
  { title: 'History and notifications', body: 'What moved, where, when, and whether it worked. A notification when a long job ends.' },
];

const settings = [
  { title: 'Diagnostics in one click', body: 'Copy a sanitized system report or open the app’s logs in Console.' },
  { title: 'Light and dark', body: 'Every screen follows the system appearance, with no custom themes to fight it.' },
];

const hood = [
  { title: 'One engine, two clients', body: 'The app and its Finder extension talk to the same local rclone through RcloneKit, a typed Swift client for rclone’s remote-control API, over loopback. No provider is reimplemented in Swift.' },
  { title: 'Swift 6, strict concurrency, no packages', body: 'SwiftUI with AppKit where it draws better: the file table is a virtualized NSTableView hosting SwiftUI rows. There are no third-party Swift packages; a pre-build check fails the build if one appears.' },
  { title: 'Tested against the real rclone', body: 'The configuration flow and the listing semantics are pinned by tests that run the actual binary, so an rclone upgrade that changes behaviour fails loudly instead of silently.' },
  { title: 'Finder presence has one owner', body: 'Showing or hiding a volume in Finder records your intent first, reconciles the File Provider domain in the background, and rolls back if registration fails.' },
];

const network: [string, string, string][] = [
  ['rclone, to the providers you configured', 'When you browse, copy, sync or open a file', 'Your remotes only'],
  ['rclone, to the provider’s sign-in page', 'Once per OAuth provider, during setup', 'Through your browser'],
  ['Anything else', 'Never', 'There is nothing else'],
];

const compare: string[][] = [
  ['Price model', 'Free, source and signed builds alike', 'One-time license per major version', 'One-time license per major version*', 'Free, paid on the Mac App Store', 'Free'],
  ['Open source', 'Yes, GPL-3.0', 'No', 'No', 'Yes, GPL-3.0', 'Yes, MIT'],
  ['UI', 'Native SwiftUI and AppKit', 'Cocoa over a Java core', 'Electron*', 'Cocoa over a Java core', 'None'],
  ['Finder / mount', 'File Provider and NFS', 'File Provider and FUSE-style', 'Mounts*', 'No mounting', 'FUSE or NFS'],
  ['Providers', 'Everything rclone supports, 50+', 'Its own, about 20*', 'Its own*', 'Its own, about 20*', '50+'],
  ['Reuses your rclone config', 'Yes', 'No', 'No', 'No', 'n/a'],
];

// The two paid apps. Nimbus is free; these fund it. Prices and links match
// work.ts, which matches each product's own site or store listing.
const beltr = bySlug('beltr');
const onescribe = bySlug('onescribe');
const beltrBuy = 'https://beltr.app/?utm_source=casavargas.app&utm_medium=referral&utm_campaign=nimbus';
const onescribeBuy = onescribe.links[0].url;
const beltrHero = 'https://beltr.app/?utm_source=casavargas.app&utm_medium=referral&utm_campaign=nimbus-hero';

const reqs: [string, string][] = [
  ['Requires', 'macOS 15 Sequoia or later, Apple silicon or Intel'],
  ['Engine', 'rclone on your PATH: brew install rclone'],
  ['Verify', 'A .sha256 sits beside every DMG'],
  ['License', 'GPL-3.0-or-later. Free, source and signed builds alike'],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Nimbus',
  description: item.tagline,
  url: 'https://casavargas.app/nimbus/',
  codeRepository: repo,
  downloadUrl: download,
  softwareVersion: version,
  operatingSystem: 'macOS',
  applicationCategory: 'UtilitiesApplication',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: { '@type': 'Organization', name: 'Casa Vargas LLC', url: 'https://casavargas.app' },
};
---

<Layout
  title="Nimbus | Every cloud you use. One Mac app."
  description="Nimbus is an open-source, native Mac app for cloud storage. It turns S3, Google Drive, OneDrive, SFTP and fifty more services into volumes you browse, show in Finder and sync, with rclone as the engine. Swift 6, GPL-3.0, no account."
  ogImage="/og/nimbus.png"
>
  <JsonLd data={schema} />
  <Nav />

  <main id="main" class="nb">

    <!-- Opening: the one bold moment. -->
    <section class="nb-open" aria-labelledby="nb-title">
      <div class="lamp" aria-hidden="true"></div>
      <div class="wrap nb-open__inner">
        <Image src={item.icon!} alt="" widths={[128, 256]} sizes="112px" format="webp" quality={86} loading="eager" fetchpriority="high" class="nb-open__icon" />
        <p class="nb-kicker">Nimbus for Mac</p>
        <h1 id="nb-title" class="statement">
          <span class="statement__line">Every cloud you use.</span>
          <span class="statement__line">One Mac app.</span>
        </h1>
        <p class="standfirst">
          S3, Google Drive, OneDrive, Dropbox, SFTP and fifty more services become volumes on
          your Mac. Browse them like Finder. Show them in Finder. Copy and sync between them.
          No account. Nothing phoning home.
        </p>
        <div class="nb-actions">
          <a class="nb-button" href={download} rel="noopener">Download for Mac</a>
          <a class="textlink" href={repo} rel="noopener">View the source</a>
        </div>
        <p class="nb-fine ui">Version {version}. macOS 15 or later, Apple silicon and Intel. GPL-3.0. Signed and notarized.</p>
        <p class="nb-fine nb-studio">Free, from the studio behind <a class="textlink" href={beltrHero} rel="noopener">Beltr</a> and <a class="textlink" href={onescribeBuy} rel="noopener">OneScribe</a>.</p>
      </div>
      <div class="wrap nb-hero">
        <Shot
          shot={{ src: homeDark, kind: 'window', alt: 'Nimbus Home: one storage bar across every cloud, a row per cloud with a plain-language status, and a sign-in banner with the button that fixes it. Shown with made-up clouds.' }}
          width={1280}
          sizes="(max-width: 900px) 100vw, 82vw"
          eager
        />
      </div>
    </section>

    <!-- At a glance -->
    <section class="nb-glance" aria-label="At a glance">
      <dl class="wrap nb-glance__grid">
        {glance.map(([n, label]) => (
          <div><dt>{n}</dt><dd>{label}</dd></div>
        ))}
      </dl>
    </section>

    <!-- Home -->
    <section class="nb-band" aria-labelledby="nb-home">
      <div class="wrap">
        <header class="nb-head nb-head--center">
          <p class="nb-kicker">Home</p>
          <h2 id="nb-home" class="nb-h2">Is everything working?<br><em>One glance answers it.</em></h2>
          <p class="nb-lede">
            Nimbus opens on Home. One storage bar covers all your clouds. Every cloud gets a row
            with its capacity and a status in plain words, and when something needs you, the
            button that fixes it is right there.
          </p>
        </header>
        <dl class="nb-features nb-features--3">
          {home.map((f) => (
            <div><dt>{f.title}</dt><dd>{f.body}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Finder: the act -->
    <section class="nb-band nb-band--deep" aria-labelledby="nb-finder">
      <div class="wrap">
        <header class="nb-head nb-head--center">
          <p class="nb-kicker">Finder</p>
          <h2 id="nb-finder" class="nb-h2 nb-h2--act">It lives in Finder.<br><em>Right beside iCloud Drive.</em></h2>
          <p class="nb-lede">
            A File Provider extension lists each cloud in Finder’s sidebar. Files download when
            you open them, edits go back up, and macOS manages the local copies. Or mount a cloud
            the classic way as a network volume. Your choice, per volume.
          </p>
        </header>

        <Shot
          shot={{ src: volumeFinder, kind: 'screen', alt: 'A volume’s Finder tab in Nimbus with the switches for showing it in Finder’s sidebar or mounting it as a network volume.' }}
          width={1280}
          sizes="(max-width: 900px) 100vw, 82vw"
          class="nb-wide"
        />

        <div class="nb-bento">
          <article class="nb-tile nb-tile--2">
            <Shot shot={{ src: finderThumbnails, kind: 'screen', alt: 'A Finder window showing cloud photos and PDFs with real thumbnails before any file is downloaded.' }} width={900} sizes="(max-width: 900px) 92vw, 54vw" class="nb-tile__fig" />
            <h3>Thumbnails before download</h3>
            <p>Photos and PDFs in the cloud show real previews in Finder, rendered on demand and cached, so you can find the right file without pulling it down first.</p>
          </article>
          <article class="nb-tile">
            <Shot shot={{ src: keepOnMac, kind: 'screen', alt: 'The Keep on this Mac switch in the inspector.' }} width={240} sizes="240px" class="nb-tile__fig nb-tile__fig--small" />
            <h3>Keep on this Mac</h3>
            <p>Pin a file or folder and it stays downloaded. Finder’s own “Keep Downloaded” and “Remove Download” commands work too, and the pin glyph shows in the list.</p>
          </article>
          <article class="nb-tile">
            <h3>Copy Share Link</h3>
            <p>Right-click a file in Finder, or use the inspector, and Nimbus asks the cloud for a public link and puts it on your clipboard. Only for clouds that can.</p>
          </article>
          <article class="nb-tile nb-tile--2">
            <h3>Server-side changes just appear</h3>
            <p>Add, rename or delete something from another device or the web, and Finder picks it up. Every refresh in Nimbus (and ⌘R) signals the working set, and the extension diffs each known folder against its last listing. No re-import, no relaunch.</p>
          </article>
          <article class="nb-tile">
            <h3>Network volumes, restored</h3>
            <p>Prefer a mount? rclone serves the cloud over NFS and the system’s own client mounts it. Mounts come back after a restart and unmount cleanly on quit.</p>
          </article>
          <article class="nb-tile nb-tile--2">
            <h3>Edits go back up</h3>
            <p>Save a document in any app, make a folder, rename, move or trash, all from Finder. The extension carries each change to the cloud, and each volume in Finder’s sidebar carries Nimbus’s icon and the name you gave it.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Browser -->
    <section class="nb-band" aria-labelledby="nb-browse">
      <div class="wrap">
        <header class="nb-head nb-head--center">
          <p class="nb-kicker">Browser</p>
          <h2 id="nb-browse" class="nb-h2">Indistinguishable from Finder.<br><em>That was the whole point.</em></h2>
          <p class="nb-lede">
            Nimbus is SwiftUI and AppKit, not a web view in a frame. Selection, drag and drop,
            Quick Look, keyboard shortcuts and column sorting behave the way they do in Finder,
            because Finder was the bar.
          </p>
        </header>

        <div class="nb-split">
          <Shot shot={{ src: browserList, kind: 'screen', alt: 'The Nimbus file browser in list view with system file icons, column headers and Finder-style cloud status glyphs.' }} width={1280} sizes="(max-width: 900px) 100vw, 58vw" />
          <dl class="nb-features nb-features--stack">
            {browse.map((f) => (
              <div><dt>{f.title}</dt><dd>{f.body}</dd></div>
            ))}
          </dl>
        </div>

        <figure class="nb-wide nb-grid-shot">
          <Shot shot={{ src: browserGrid, kind: 'screen', alt: 'The Nimbus browser in icon view.' }} width={1280} sizes="(max-width: 900px) 100vw, 82vw" />
          <figcaption class="nb-caption">Icon view, with the same selection and Quick Look behaviour as the list.</figcaption>
        </figure>

        <div class="nb-split nb-split--reverse">
          <Shot shot={{ src: volumeInspector, kind: 'screen', alt: 'A volume in Nimbus with the inspector open on the right, showing a file’s cloud status and details.' }} width={1280} sizes="(max-width: 900px) 100vw, 58vw" />
          <dl class="nb-features nb-features--stack">
            {volume.map((f) => (
              <div><dt>{f.title}</dt><dd>{f.body}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Add Cloud -->
    <section class="nb-band nb-band--deep" aria-labelledby="nb-setup">
      <div class="wrap nb-split nb-split--text-first">
        <div>
          <p class="nb-kicker">Add Cloud</p>
          <h2 id="nb-setup" class="nb-h2">Sign in.<br><em>That’s the setup.</em></h2>
          <p class="nb-lede">
            Pick a service from the tiles. For Google Drive, OneDrive, Dropbox and friends,
            Nimbus opens the provider’s own sign-in page in your browser. Nimbus never sees your
            password. For servers like S3, SFTP and WebDAV, it asks exactly the questions that
            backend needs and nothing more.
          </p>
          <dl class="nb-features nb-features--stack">
            {setup.map((f) => (
              <div><dt>{f.title}</dt><dd>{f.body}</dd></div>
            ))}
          </dl>
        </div>
        <Shot shot={{ src: addCloud, kind: 'screen', alt: 'The Add Cloud sheet with service tiles for Google Drive, OneDrive, Dropbox and more, each with a one-line hint about how sign-in works.' }} width={600} sizes="(max-width: 900px) 92vw, 36vw" class="nb-sheet" />
      </div>
    </section>

    <!-- Menu bar -->
    <section class="nb-band" aria-labelledby="nb-menubar">
      <div class="wrap">
        <header class="nb-head nb-head--center">
          <p class="nb-kicker">Menu bar</p>
          <h2 id="nb-menubar" class="nb-h2">Close the window.<br><em>Nimbus keeps watch.</em></h2>
          <p class="nb-lede">
            Most of the time you’ll be in Finder, not in Nimbus. The menu bar glyph shows
            aggregate state, and one click opens a companion window with live transfers, every
            cloud, recent activity and quick actions.
          </p>
        </header>
        <div class="nb-companions">
          <figure class="nb-companion">
            <Shot shot={{ src: companionBusy, kind: 'screen', alt: 'The menu bar companion while copying three items to Dropbox, with a progress bar and the list of clouds.' }} width={340} sizes="340px" />
            <figcaption class="nb-caption">While something is moving</figcaption>
          </figure>
          <figure class="nb-companion">
            <Shot shot={{ src: companionSignIn, kind: 'screen', alt: 'The menu bar companion asking you to sign in to a cloud again, with the button to do it.' }} width={340} sizes="340px" />
            <figcaption class="nb-caption">When a cloud needs you</figcaption>
          </figure>
          <dl class="nb-features nb-features--stack nb-companions__copy">
            {companion.map((f) => (
              <div><dt>{f.title}</dt><dd>{f.body}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Copy & Sync -->
    <section class="nb-band nb-band--deep" aria-labelledby="nb-transfers">
      <div class="wrap nb-split nb-split--text-first">
        <div>
          <p class="nb-kicker">Copy and sync</p>
          <h2 id="nb-transfers" class="nb-h2">Any cloud to any cloud.<br><em>Or to this Mac.</em></h2>
          <p class="nb-lede">
            Copy or sync between any two volumes or local folders. Transfers show up in a drawer
            along the bottom while they run and as a progress capsule in the toolbar, like a
            Finder copy. Every volume keeps its own history.
          </p>
          <dl class="nb-features nb-features--stack">
            {transfers.map((f) => (
              <div><dt>{f.title}</dt><dd>{f.body}</dd></div>
            ))}
          </dl>
        </div>
        <Shot shot={{ src: settingsTransfers, kind: 'screen', alt: 'The Transfers settings pane with the speed menu and notification options.' }} width={680} sizes="(max-width: 900px) 92vw, 40vw" class="nb-sheet" />
      </div>
    </section>

    <!-- Settings -->
    <section class="nb-band" aria-labelledby="nb-settings">
      <div class="wrap nb-split">
        <Shot shot={{ src: settingsGeneral, kind: 'screen', alt: 'The Nimbus Settings window in dark mode, laid out like System Settings.' }} width={1360} sizes="(max-width: 900px) 100vw, 58vw" />
        <div>
          <p class="nb-kicker">Settings</p>
          <h2 id="nb-settings" class="nb-h2">Modeled on<br><em>System Settings.</em></h2>
          <p class="nb-lede">
            Dense, sectioned, familiar. Engine status at a glance, Open at Login, the speed menu,
            and an Advanced pane for the rclone path and the people who want to see the wiring.
          </p>
          <dl class="nb-features nb-features--stack">
            {settings.map((f) => (
              <div><dt>{f.title}</dt><dd>{f.body}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Privacy -->
    <section class="nb-band nb-band--deep" aria-labelledby="nb-network">
      <div class="wrap wrap--narrow">
        <header class="nb-head nb-head--center">
          <p class="nb-kicker">Privacy</p>
          <h2 id="nb-network" class="nb-h2">The only process that<br>touches the network is rclone.</h2>
          <p class="nb-lede">No account. No sign-in with Nimbus. No telemetry. No update pinging. Here is the complete list of what talks to what.</p>
        </header>
        <div class="nb-table-wrap">
          <table class="nb-table">
            <thead class="ui">
              <tr><th scope="col">Who</th><th scope="col">When</th><th scope="col">Where</th></tr>
            </thead>
            <tbody>
              {network.map(([what, when, where]) => (
                <tr><td>{what}</td><td>{when}</td><td>{where}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="nb-note nb-note--center">Nimbus is GPL-3.0-or-later. You can read every line that runs on your Mac.</p>
      </div>
    </section>

    <!-- Under the hood -->
    <section class="nb-band" aria-labelledby="nb-hood">
      <div class="wrap">
        <header class="nb-head nb-head--center">
          <p class="nb-kicker">Under the hood</p>
          <h2 id="nb-hood" class="nb-h2">Built the way a Mac app<br>should be built.</h2>
          <p class="nb-lede">
            One engine, two clients. The
            <a class="textlink" href={`${repo}#how-it-works`} rel="noopener">README</a> and the
            <a class="textlink" href={`${repo}/tree/main/docs/superpowers/specs`} rel="noopener">design specs</a> go further.
          </p>
        </header>

        <div class="nb-stack"><NimbusStack /></div>

        <dl class="nb-features nb-features--2">
          {hood.map((f) => (
            <div><dt>{f.title}</dt><dd>{f.body}</dd></div>
          ))}
        </dl>

        <p class="nb-note nb-ai">
          Built with AI, in the open. Nimbus is developed with Claude Code: every feature starts
          as a written spec and plan in the repository, and what the AI writes is built, run and
          tested before it merges. The specs are public.
        </p>

        <h3 class="nb-h3 nb-h3--center">How it compares</h3>
        <div class="nb-table-wrap">
          <table class="nb-table nb-compare">
            <thead class="ui">
              <tr><th scope="col"><span class="visually-hidden">Feature</span></th><th scope="col">Nimbus</th><th scope="col">Mountain Duck</th><th scope="col">ExpanDrive</th><th scope="col">Cyberduck</th><th scope="col">rclone CLI</th></tr>
            </thead>
            <tbody>
              {compare.map(([label, ...cells]) => (
                <tr><th scope="row">{label}</th>{cells.map((c) => <td>{c}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="nb-note">* Not verified against a current release. Corrections welcome.</p>
      </div>
    </section>

    <!-- The apps that pay for it -->
