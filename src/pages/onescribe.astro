---
import AppPage from '../layouts/AppPage.astro';
import { apps } from '../data/apps';
import osBoarding from '../assets/onescribe/boarding.png';
import osReceipt from '../assets/onescribe/receipt.png';
import osHealth from '../assets/onescribe/health.png';
import osWine from '../assets/onescribe/wine.png';

const app = apps.find((a) => a.slug === 'onescribe')!;

const title = 'OneScribe — AI Document Scanner for iPhone';
const description =
  'OneScribe scans documents and gives you structured data back — boarding passes, receipts, prescriptions, wine labels. On-device VisionKit and CoreML, exports to Google Docs, OneNote and Markdown.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OneScribe',
  description,
  url: 'https://getonescribe.app',
  operatingSystem: 'iOS',
  applicationCategory: 'ProductivityApplication',
  author: {
    '@type': 'Organization',
    name: 'CasaVargas LLC',
    url: 'https://casavargas.app',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
};

const features = [
  {
    title: 'Structured data, not just text',
    desc: 'OneScribe recognises what a document is and pulls the fields that matter — flight number, gate and seat from a boarding pass; line items, subtotal and tax from a receipt. You get data back, not a wall of OCR text.',
  },
  {
    title: 'On-device processing',
    desc: "Scanning and recognition run locally using Apple's VisionKit and CoreML. No cloud uploads, no data collection — your documents never leave your phone.",
  },
  {
    title: 'An entity graph across your library',
    desc: 'It links people, places and businesses across every document you capture, so the same person or vehicle appearing in four documents becomes one thing you can open.',
  },
  {
    title: 'Multi-format export',
    desc: 'Export to Google Docs, OneNote, Markdown, PDF and plain text, or push a date straight into Calendar from a document that has one.',
  },
  {
    title: 'Smart document detection',
    desc: 'Automatically finds document edges, corrects perspective and enhances contrast. Point the camera and OneScribe handles the rest.',
  },
  {
    title: 'Built in SwiftUI',
    desc: 'A native iOS app written entirely in SwiftUI and Swift 6 — fast, fluid, and designed to feel like it belongs on your iPhone.',
  },
];
---

<AppPage
  app={app}
  title={title}
  description={description}
  ogImage="/OneScribe.png"
  tagline="AI document scanner for iPhone"
  intro="OneScribe turns your iPhone into a document scanner that understands what it is looking at. It extracts structured fields from boarding passes, receipts, prescriptions and wine labels, links the people and places it finds across your whole library, and does all of it on-device."
  features={features}
  shots={[osBoarding, osReceipt, osHealth, osWine]}
  schema={schema}
  cta={{
    heading: 'Scan smarter',
    body: 'Download OneScribe from the App Store.',
    label: 'App Store',
    url: 'https://apps.apple.com/us/app/onescribe-ai-scanner-ocr/id6756506734',
    secondary: { label: 'getonescribe.app', url: 'https://getonescribe.app' },
  }}
/>
