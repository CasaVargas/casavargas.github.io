---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered width budget, used to pick the emitted sizes. */
  width?: number;
  sizes?: string;
  eager?: boolean;
  /** Show a macOS titlebar. Off for TV/full-bleed captures. */
  chrome?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width = 1100,
  sizes = '(max-width: 900px) 100vw, 60vw',
  eager = false,
  chrome = true,
  class: className = '',
} = Astro.props;

const widths = [Math.round(width / 2), width, Math.min(width * 2, src.width)].filter(
  (w, i, a) => w <= src.width && a.indexOf(w) === i,
);
---

<figure class:list={['frame', className]}>
  {chrome && <div class="frame__chrome" aria-hidden="true"><i></i><i></i><i></i></div>}
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={74}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</figure>

<style>
  /* A screen set into a lit room: dark glass, a warm ring, a specular lip. */
  .frame {
    position: relative;
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-screen);
    box-shadow: 0 0 0 1px var(--well-ring), var(--well-shadow);
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 var(--well-lip);
  }

  .frame__chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 11px;
    background: #1b1714;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .frame__chrome i {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(244, 237, 227, 0.2);
  }
</style>
