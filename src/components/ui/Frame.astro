---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered width budget, used to pick the emitted sizes. */
  width?: number;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width = 1100,
  sizes = '(max-width: 900px) 100vw, 55vw',
  eager = false,
  class: className = '',
} = Astro.props;
---

<figure class={`frame ${className}`}>
  <div class="chrome" aria-hidden="true"><i></i><i></i><i></i></div>
  <Image
    src={src}
    alt={alt}
    widths={[Math.round(width / 2), width, width * 2]}
    sizes={sizes}
    format="webp"
    quality={72}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</figure>

<style>
  /* A dark app UI on a dark page has no boundary. Window chrome supplies a
     bright horizontal edge at the top; the inset lip finishes the other three. */
  .frame {
    position: relative;
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--shot-ring);
    box-shadow: var(--shot-shadow);
    background: #0a0a0c;
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 var(--shot-lip);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px;
    background: var(--color-chrome);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .chrome i {
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .chrome i:nth-child(1) { background: #ff5f57; }
  .chrome i:nth-child(2) { background: #febc2e; }
  .chrome i:nth-child(3) { background: #28c840; }
</style>
