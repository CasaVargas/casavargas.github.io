---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes = '(max-width: 900px) 60vw, 22vw',
  eager = false,
  class: className = '',
} = Astro.props;

const widths = [300, 500, 800].filter((w) => w <= src.width);
---

<figure class:list={['reader', className]}>
  <div class="reader__face">
  <Image
    src={src}
    alt={alt}
    widths={widths.length ? widths : [src.width]}
    sizes={sizes}
    format="webp"
    quality={78}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
  </div>
</figure>

<style>
  /* An e-reader: a matte slab with an even bezel, a little deeper at the
     foot, around a paper-white screen. Deliberately generic: no maker's
     marks, no device UI. */
  .reader {
    position: relative;
    margin: 0;
    border-radius: clamp(12px, 1.6vw, 22px);
    background: linear-gradient(170deg, #34302c, #191714 70%);
    box-shadow: 0 0 0 1px var(--well-ring), var(--well-shadow);
  }

  /* Padding lives here: a percentage resolves against the parent's width,
     and this element's parent is the frame itself. */
  .reader__face { padding: 7% 6.5% 10%; }

  .reader :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    background: #f2f0eb;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35);
  }

  .reader::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 var(--well-lip);
  }
</style>
