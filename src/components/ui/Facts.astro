---
interface Props {
  rows: [string, string][];
  class?: string;
}

const { rows, class: className = '' } = Astro.props;
---

<dl class:list={['facts', className]}>
  {rows.map(([label, value]) => (
    <div class="facts__row">
      <dt class="ui">{label}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</dl>

<style>
  /* A catalogue entry's specification: structured, never a middle-dot string. */
  .facts {
    margin: 0;
    border-top: 1px solid var(--color-line);
  }

  .facts__row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-line);
  }

  dt {
    color: var(--color-ink-3);
    padding-top: 0.2rem;
  }

  dd {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--color-ink);
  }

  @media (max-width: 420px) {
    .facts__row { grid-template-columns: 6rem minmax(0, 1fr); }
  }
</style>
