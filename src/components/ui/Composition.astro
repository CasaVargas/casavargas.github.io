---
import Shot from './Shot.astro';
import type { Plate } from '../../data/work';

interface Props {
  plate: Plate;
  /** The first image on a case study is above the fold. */
  eager?: boolean;
  class?: string;
}

const { plate, eager = false, class: className } = Astro.props;
---

<div class:list={['comp', `comp--${plate.layout}`, className]}>
  {plate.layout === 'feature' && (
    <>
      <Shot shot={plate.shots[0]} width={1600} sizes="(max-width: 900px) 100vw, 78vw" eager={eager} />
      {plate.shots[1] && <Shot shot={plate.shots[1]} class="comp__aside" sizes="(max-width: 900px) 30vw, 15vw" />}
    </>
  )}

  {(plate.layout === 'phones' || plate.layout === 'readers') &&
    plate.shots.map((shot, i) => (
      <Shot shot={shot} class={`comp__phone comp__phone--${i}`} eager={eager && i === 1} sizes={plate.layout === 'readers' ? '(max-width: 900px) 34vw, 26vw' : undefined} />
    ))}

  {plate.layout === 'compact' && (
    <Shot shot={plate.shots[0]} width={1100} sizes="(max-width: 900px) 100vw, 60vw" eager={eager} />
  )}
</div>
{plate.credit && <p class="comp__credit">{plate.credit}</p>}

<style>
  .comp { position: relative; }
  .comp__credit {
    margin: 1.4rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    text-align: center;
  }

  /* feature: a large display, a phone standing in front of its corner. */
  .comp--feature { padding-right: 9%; padding-bottom: 5%; }
  .comp--feature :global(.comp__aside) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 17%;
  }

  /* phones: devices stand in a row, the middle one forward. */
  .comp--phones {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-top: 1.5rem;
  }
  .comp--phones :global(.comp__phone) { width: min(24%, 290px); }
  .comp--phones :global(.comp__phone--1) {
    width: min(27%, 320px);
    transform: translateY(-1.5rem);
  }

  /* readers: the same row, wider devices for 3:4 pages. */
  .comp--readers {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(0.75rem, 2.5vw, 2.25rem);
    padding-top: 1.5rem;
  }
  .comp--readers :global(.comp__phone) { width: min(28%, 360px); }
  .comp--readers :global(.comp__phone--1) {
    width: min(33%, 420px);
    transform: translateY(-1.5rem);
  }

  @media (max-width: 900px) {
    .comp--feature { padding-right: 14%; padding-bottom: 10%; }
    .comp--feature :global(.comp__aside) { width: 26%; }

    .comp--phones { gap: 0.75rem; }
    .comp--phones :global(.comp__phone) { width: 31%; }
    .comp--phones :global(.comp__phone--1) { width: 35%; transform: translateY(-0.75rem); }
    .comp--readers { gap: 0.6rem; }
    .comp--readers :global(.comp__phone) { width: 31%; }
    .comp--readers :global(.comp__phone--1) { width: 36%; transform: translateY(-0.75rem); }
  }
</style>
