---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  sizes = '(max-width: 900px) 55vw, 18vw',
  class: className = '',
} = Astro.props;

const widths = [240, 400, 600].filter((w) => w <= src.width);
---

<figure class:list={['phone', className]}>
  <Image
    src={src}
    alt={alt}
    widths={widths.length ? widths : [src.width]}
    sizes={sizes}
    format="webp"
    quality={80}
    loading="lazy"
  />
</figure>

<style>
  /* The image is already set in Apple's own bezel (scripts/bezel-shots.mjs).
     Apple's rules for product images: nothing added on or around them, so no
     ring, shadow or background here. */
  .phone { margin: 0; }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
