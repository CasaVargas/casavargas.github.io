---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  sizes = '(max-width: 900px) 55vw, 18vw',
  class: className = '',
} = Astro.props;

const widths = [240, 400, 600].filter((w) => w <= src.width);
---

<figure class:list={['phone', className]}>
  <Image
    src={src}
    alt={alt}
    widths={widths.length ? widths : [src.width]}
    sizes={sizes}
    format="webp"
    quality={72}
    loading="lazy"
  />
</figure>

<style>
  /* A near-black screen needs something lighter around it to read as a
     device: a thin lit bezel, then the warm ring. */
  .phone {
    position: relative;
    margin: 0;
    padding: 5px;
    border-radius: 30px;
    background: linear-gradient(165deg, #3a332d, #1c1815 60%);
    box-shadow: 0 0 0 1px var(--well-ring), var(--well-shadow);
  }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 25px;
  }

  .phone::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 var(--well-lip);
  }
</style>
