---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** 'front' is the emphasised centre device; 'back' flanks it. */
  depth?: 'front' | 'back';
  class?: string;
}

const { src, alt, depth = 'front', class: className = '' } = Astro.props;
---

<figure class={`phone phone--${depth} ${className}`}>
  <Image
    src={src}
    alt={alt}
    widths={[220, 440, 660]}
    sizes="(max-width: 900px) 40vw, 16vw"
    format="webp"
    quality={70}
    loading="lazy"
  />
</figure>

<style>
  /* A black screen on a near-black page merges with it. The bezel is a lighter
     physical object placed between the two so the screen reads as a screen. */
  .phone {
    position: relative;
    margin: 0;
    flex: 0 0 auto;
    padding: 5px;
    border-radius: 24px;
    overflow: hidden;
    background: linear-gradient(160deg, #35353f, #1a1a21 55%);
    border: 1px solid var(--shot-ring);
    box-shadow: var(--shot-shadow);
  }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 19px;
  }

  .phone::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .phone--front { width: 34%; z-index: 2; }
  .phone--back  { width: 29%; opacity: 0.92; }

  /* On narrow screens the row becomes a snap rail (see AppBand), so phones take
     a fixed legible width instead of a percentage that would overflow. */
  @media (max-width: 900px) {
    .phone--front,
    .phone--back {
      width: 58vw;
      max-width: 260px;
      opacity: 1;
      scroll-snap-align: center;
    }
  }
</style>
