---
const path = Astro.url.pathname;

const links = [
  { label: 'Work', href: '/work/', match: '/work' },
  { label: 'Notes', href: '/blog/', match: '/blog' },
  { label: 'Studio', href: '/#studio', match: null },
];
---

<header class="masthead">
  <div class="masthead__inner wrap">
    <a href="/" class="brand" aria-label="CasaVargas, home">
      <svg class="brand__mark" width="28" height="28" viewBox="0 0 512 512" aria-hidden="true">
        <defs>
          <linearGradient id="mark-g" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#EF9F27" />
            <stop offset="100%" stop-color="#D85A30" />
          </linearGradient>
        </defs>
        <g transform="translate(256, 240)">
          <path d="M0,-160 L-122,-51 L-98,-51 L0,-139 L98,-51 L122,-51 Z" fill="url(#mark-g)" />
          <rect x="-88" y="-51" width="176" height="152" rx="7" fill="url(#mark-g)" opacity="0.9" />
          <path d="M-30,-8 L-54,25 L-30,59" fill="none" stroke="#231c16" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M30,-8 L54,25 L30,59" fill="none" stroke="#231c16" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
          <line x1="14" y1="-8" x2="-14" y2="59" stroke="#231c16" stroke-width="7.5" stroke-linecap="round" opacity="0.8" />
        </g>
      </svg>
      <span class="brand__name">CasaVargas</span>
    </a>

    <nav class="navlinks ui" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class="navlink"
          aria-current={l.match && path.startsWith(l.match) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
      <a href="mailto:hello@casavargas.app" class="navlink">Contact</a>
    </nav>
  </div>
</header>

<style>
  .masthead {
    position: relative;
    z-index: 10;
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-block: 1.6rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-ink);
  }

  .brand__mark { flex-shrink: 0; }

  .brand__name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 480;
    letter-spacing: -0.01em;
  }

  .navlinks {
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2.4vw, 2.1rem);
    font-size: 0.9375rem;
  }

  .navlink {
    position: relative;
    color: var(--color-ink-2);
    text-decoration: none;
    padding-block: 0.3rem;
    transition: color 0.18s ease;
  }
  .navlink:hover { color: var(--color-ink); }

  .navlink[aria-current='page'] { color: var(--color-ink); }
  .navlink[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.05rem;
    height: 1px;
    background: var(--color-amber);
  }

  /* Links wrap under the wordmark instead of disappearing. */
  @media (max-width: 560px) {
    .masthead__inner { padding-block: 1.1rem; row-gap: 0.6rem; }
    .navlinks { width: 100%; justify-content: space-between; }
  }
</style>
