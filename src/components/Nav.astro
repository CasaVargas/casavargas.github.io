---
const path = Astro.url.pathname;

const links = [
  { label: 'Apps', href: '/work/', match: '/work' },
  { label: 'Notes', href: '/blog/', match: '/blog' },
  { label: 'About', href: '/#about', match: null },
  { label: 'GitHub', href: 'https://github.com/CasaVargas', match: null },
];
---

<header class="masthead">
  <div class="masthead__inner wrap">
    <a href="/" class="brand" aria-label="CasaVargas, home">
      <svg class="brand__mark" width="26" height="26" viewBox="0 0 512 512" aria-hidden="true">
        <defs>
          <linearGradient id="mark-g" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#EF9F27" />
            <stop offset="100%" stop-color="#D85A30" />
          </linearGradient>
        </defs>
        <g transform="translate(256, 240)">
          <path d="M0,-160 L-122,-51 L-98,-51 L0,-139 L98,-51 L122,-51 Z" fill="url(#mark-g)" />
          <rect x="-88" y="-51" width="176" height="152" rx="7" fill="url(#mark-g)" opacity="0.9" />
          <path d="M-30,-8 L-54,25 L-30,59" fill="none" stroke="#1d1d1f" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M30,-8 L54,25 L30,59" fill="none" stroke="#1d1d1f" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
          <line x1="14" y1="-8" x2="-14" y2="59" stroke="#1d1d1f" stroke-width="7.5" stroke-linecap="round" opacity="0.8" />
        </g>
      </svg>
      <span class="brand__name">CasaVargas</span>
    </a>

    <nav class="navlinks" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class="navlink"
          aria-current={l.match && path.startsWith(l.match) ? 'page' : undefined}
          rel={l.href.startsWith('http') ? 'noopener' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .masthead { border-bottom: 1px solid var(--color-line); }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.9rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--color-ink);
  }
  .brand__mark { flex-shrink: 0; }
  .brand__name {
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .navlinks {
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2.4vw, 1.9rem);
    font-size: 0.9375rem;
  }

  .navlink {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .navlink:hover { color: var(--color-ink); }
  .navlink[aria-current='page'] { color: var(--color-ink); font-weight: 600; }

  /* Links wrap under the name instead of disappearing. */
  @media (max-width: 480px) {
    .masthead__inner { padding-block: 0.4rem; row-gap: 0; }
    .navlinks { width: 100%; justify-content: space-between; }
  }
</style>
