---
import { caseStudies } from '../data/work';

const year = new Date().getFullYear();
---

<footer class="colophon">
  <div class="wrap colophon__grid">
    <div class="colophon__lead">
      <p class="colophon__line">
        Write to <a class="textlink" href="mailto:hello@casavargas.app">hello@casavargas.app</a>.
        Every message is read by the person who wrote the software.
      </p>
    </div>

    <nav class="colophon__col" aria-label="Work">
      <h2 class="colophon__head ui">Work</h2>
      <ul>
        {caseStudies.map((w) => (
          <li><a href={`/work/${w.slug}/`}>{w.name}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="colophon__col" aria-label="Studio">
      <h2 class="colophon__head ui">Studio</h2>
      <ul>
        <li><a href="/blog/">Notes</a></li>
        <li><a href="/#studio">About</a></li>
        <li><a href="https://github.com/CasaVargas" rel="noopener">GitHub</a></li>
        <li><a href="https://github.com/sponsors/prjoni99" rel="noopener">Sponsor on GitHub</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap colophon__base ui">
    <p>© {year} CasaVargas LLC, North Carolina</p>
    <p>Set in Newsreader and Hanken Grotesk. Built with Astro.</p>
  </div>
</footer>

<style>
  .colophon {
    background: var(--color-ground-deep);
    border-top: 1px solid var(--color-line);
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  .colophon__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
  }

  .colophon__line {
    margin: 0;
    max-width: 26ch;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 330;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .colophon__head {
    margin: 0 0 0.9rem;
    font-weight: 500;
    color: var(--color-ink-3);
  }

  .colophon__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .colophon__col a {
    color: var(--color-ink-2);
    text-decoration: none;
    font-size: 1.0625rem;
    transition: color 0.18s ease;
  }
  .colophon__col a:hover { color: var(--color-amber); }

  .colophon__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-block: 1.6rem 2rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-3);
  }
  .colophon__base p { margin: 0; }

  @media (max-width: 820px) {
    .colophon__grid { grid-template-columns: 1fr 1fr; }
    .colophon__lead { grid-column: 1 / -1; }
  }
</style>
