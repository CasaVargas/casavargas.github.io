---
import { caseStudies } from '../data/work';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__grid">
    <nav aria-label="Apps">
      <h2 class="foot__head ui">Apps</h2>
      <ul>
        {caseStudies.map((w) => (
          <li><a href={`/work/${w.slug}/`}>{w.name}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="CasaVargas">
      <h2 class="foot__head ui">CasaVargas</h2>
      <ul>
        <li><a href="/#about">About</a></li>
        <li><a href="/blog/">Notes</a></li>
        <li><a href="https://github.com/CasaVargas" rel="noopener">GitHub</a></li>
        <li><a href="https://github.com/sponsors/prjoni99" rel="noopener">Sponsor on GitHub</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="foot__head ui">Contact</h2>
      <p class="foot__contact">
        <a class="textlink" href="mailto:hello@casavargas.app">hello@casavargas.app</a><br />
        Every message is read by the person who wrote the software.
      </p>
    </div>
  </div>

  <p class="wrap foot__base ui">© {year} Casa Vargas LLC, North Carolina</p>
</footer>

<style>
  .foot {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    background: var(--color-ground-deep);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .foot__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .foot__head {
    margin: 0 0 0.6rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .foot ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 1.5rem;
  }
  .foot nav + nav ul { columns: 1; }
  .foot li { break-inside: avoid; }

  .foot li a {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--color-ink-2);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .foot li a:hover { color: var(--color-ink); text-decoration: underline; }

  .foot__contact {
    margin: 0;
    padding-top: 0.3rem;
    max-width: 22em;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }

  .foot__base {
    margin-top: clamp(2rem, 4vw, 3rem);
    margin-bottom: 0;
    padding-block: 1.25rem 1.75rem;
    color: var(--color-ink-3);
  }

  @media (max-width: 760px) {
    .foot__grid { grid-template-columns: 1fr 1fr; }
    .foot ul { columns: 1; }
  }
</style>
