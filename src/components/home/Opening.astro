---
import { work, groups } from '../../data/work';

const hrefFor = (slug: string) => `/work/${slug}/`;

// "Available now: Beltr, Beltr Remote and OneScribe." — a sentence, not a stat strip.
const list = (items: { name: string; slug: string }[]) =>
  items.map((w, i) => ({
    ...w,
    sep: i === items.length - 1 ? '' : i === items.length - 2 ? (items.length > 2 ? ', and ' : ' and ') : ', ',
  }));

const byGroup = groups.map((g) => ({
  ...g,
  items: list(work.filter((w) => w.group === g.id).map((w) => ({ name: w.name, slug: w.slug }))),
}));
---

<section class="opening" aria-labelledby="opening-title">
  <div class="lamp" aria-hidden="true"></div>

  <div class="wrap opening__inner">
    <h1 id="opening-title" class="statement">
      CasaVargas makes software you own — apps for the Mac, iPhone, iPad, Apple&nbsp;TV,
      Windows and Linux, paid for once, if at all, and kept for good.
    </h1>

    <div class="opening__foot">
      <p class="byline">
        A one-person studio in North Carolina, run by Jon Vargas.
      </p>

      <p class="opening__contents">
        {byGroup.map((g) => (
          <span class="opening__group">
            <span class="opening__label">{g.label}:</span>{' '}
            {g.items.map((w) => (
              <>
                <a class="textlink" href={hrefFor(w.slug)}>{w.name}</a>{w.sep}
              </>
            ))}.{' '}
          </span>
        ))}
      </p>
    </div>
  </div>
</section>

<style>
  .opening {
    position: relative;
    isolation: isolate;
    /* Clip sideways only: the lamp must spill up behind the masthead. */
    overflow-x: clip;
    padding-block: clamp(3rem, 9vw, 8rem) clamp(4rem, 9vw, 7.5rem);
  }

  /* The desk lamp. One warm pool of light above the statement — the only
     atmosphere on the page. */
  .lamp {
    position: absolute;
    z-index: -1;
    top: -62%;
    left: -12%;
    width: min(1100px, 110vw);
    aspect-ratio: 1.35;
    background: radial-gradient(
      closest-side,
      rgba(239, 159, 39, 0.2),
      rgba(239, 159, 39, 0.07) 55%,
      transparent
    );
    pointer-events: none;
    animation: lamp-on 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .statement {
    margin: 0;
    max-width: 19.5em;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.25rem, 5.3vw, 5rem);
    line-height: 1.06;
    letter-spacing: -0.021em;
    color: var(--color-ink);
    text-wrap: balance;
    animation: settle 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both;
  }

  .opening__foot {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2rem 3rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-line);
    animation: settle 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.35s both;
  }

  .byline {
    margin: 0;
    font-size: 1.125rem;
    color: var(--color-ink-2);
  }

  .opening__contents {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-ink-2);
  }
  .opening__label { color: var(--color-ink-3); font-style: italic; }

  @keyframes lamp-on {
    from { opacity: 0; transform: scale(0.94); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes settle {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  @media (max-width: 760px) {
    .opening__foot { grid-template-columns: 1fr; gap: 1rem; }
    .lamp { top: -20%; left: -40%; width: 160vw; }
  }
</style>
