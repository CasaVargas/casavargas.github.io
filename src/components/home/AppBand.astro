---
import { Image } from 'astro:assets';
import Frame from '../ui/Frame.astro';
import Phone from '../ui/Phone.astro';
import { statusLabel, type App } from '../../data/apps';

interface Props {
  app: App;
}

const { app } = Astro.props;
const isCompact = app.weight === 'compact';
const [primaryLink, ...otherLinks] = app.links;
---

<article
  class:list={[
    'band',
    isCompact && 'band--compact',
    app.reverse && 'band--reverse',
  ]}
>
  <div class="band__copy">
    <div class="band__id">
      <Image
        src={app.icon}
        alt=""
        widths={[52, 104]}
        sizes="52px"
        format="webp"
        quality={80}
        loading="lazy"
        class="appicon"
      />
      <div class="band__naming">
        <p class="kicker">{app.category}</p>
        <h3><a href={`/${app.slug}`}>{app.name}</a></h3>
      </div>
      <span class:list={['pill', `pill--${app.status}`]}>{statusLabel[app.status]}</span>
    </div>

    <p class="band__desc">{app.description}</p>

    {app.specs.length > 0 && (
      <ul class="specs">
        {app.specs.map((spec) => <li>{spec}</li>)}
      </ul>
    )}

    <div class="band__tags">
      {app.platforms.map((p) => <span class="tag">{p}</span>)}
    </div>

    <div class="band__links">
      <a href={primaryLink.url} class="link" target="_blank" rel="noopener">
        {primaryLink.label} &rarr;
      </a>
      {otherLinks.map((l) => (
        <a href={l.url} class="link link--muted" target="_blank" rel="noopener">
          {l.label} &rarr;
        </a>
      ))}
    </div>
  </div>

  {app.shotKind === 'phone' ? (
    <div class="art art--phones">
      {app.shots.map((shot, i) => (
        <Phone
          src={shot}
          alt={`${app.name} screenshot`}
          depth={app.shots.length === 1 || i === Math.floor(app.shots.length / 2) ? 'front' : 'back'}
        />
      ))}
    </div>
  ) : (
    <div class="art art--stack">
      <div class="art__main">
        <Frame src={app.shots[0]} alt={`${app.name} screenshot`} width={isCompact ? 760 : 1100} />
      </div>
      {app.shots[1] && (
        <div class="art__inset">
          <Frame src={app.shots[1]} alt={`${app.name} screenshot`} width={620} sizes="26vw" />
        </div>
      )}
    </div>
  )}
</article>

<style>
  .band {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 4rem;
    align-items: center;
    max-width: 84rem;
    margin: 0 auto;
    padding: 4rem 2.5rem 6rem;
    border-top: 1px solid var(--color-border-soft);
  }

  /* Alternating grounds keep consecutive screenshots off identical values. */
  .band--reverse {
    background: var(--color-bg-alt);
  }
  .band--reverse .band__copy { order: 2; }
  .band--reverse .art { order: 1; }

  .band--compact {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2.5rem 2.5rem 3rem;
    background: var(--color-bg-alt);
  }

  .band__id {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.2rem;
  }
  .band__naming { min-width: 0; }

  .band__id :global(.appicon) {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    flex-shrink: 0;
  }
  .band--compact .band__id :global(.appicon) {
    width: 44px;
    height: 44px;
    border-radius: 10px;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin: 0 0 0.2rem;
  }

  .band__id h3 {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .band--compact .band__id h3 { font-size: 1.35rem; }

  .band__id h3 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .band__id h3 a:hover { color: var(--color-accent); }

  .pill {
    margin-left: auto;
    flex-shrink: 0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .pill--live   { background: rgba(74, 222, 128, 0.14); color: var(--color-accent-green); }
  .pill--coming { background: rgba(239, 159, 39, 0.16); color: var(--color-accent); }
  .pill--oss    { background: rgba(160, 160, 185, 0.14); color: var(--color-text-secondary); }

  .band__desc {
    margin: 0;
    font-size: 1rem;
    line-height: 1.62;
    color: var(--color-text-secondary);
    max-width: 34rem;
  }
  .band--compact .band__desc { font-size: 0.92rem; }

  .specs {
    list-style: none;
    padding: 0;
    margin: 1.3rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  .specs li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
  }
  .specs li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .band__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.4rem;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-tertiary);
  }

  .band__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 1.4rem;
  }
  .link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }
  .link:hover { opacity: 0.75; }
  .link--muted { color: var(--color-text-tertiary); }

  .art--stack { position: relative; }

  .art__inset {
    position: absolute;
    right: -1.25rem;
    bottom: -2.75rem;
    width: 46%;
  }

  .art--phones {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
  }

  @media (max-width: 900px) {
    .band,
    .band--compact {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 3rem 1.5rem 3.5rem;
    }
    .band--reverse .band__copy,
    .band--reverse .art { order: unset; }
    .art__inset {
      position: static;
      width: 72%;
      margin: 1rem auto 0;
    }

    /* Three phones at percentage widths overflow a phone-sized viewport.
       Scroll them instead of shrinking them below legibility. */
    .art--phones {
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.75rem;
      margin-inline: -1.5rem;
      padding-inline: 1.5rem;
      scrollbar-width: none;
    }
    .art--phones::-webkit-scrollbar { display: none; }
  }
</style>
