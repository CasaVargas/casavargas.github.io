---
import { Image } from 'astro:assets';
import { work } from '../../data/work';

// Work in development is described, not pictured: no screenshot here would be
// both honest and publishable yet. See PLAN.md §8.
// Products with a plate already appear in Selected work above.
const items = work.filter((w) => w.group === 'workshop' && !w.plate);
const count = ['No', 'One', 'Two', 'Three', 'Four', 'Five'][items.length] ?? String(items.length);
---

<section class="workshop" aria-labelledby="workshop-title">
  <header class="workshop__head">
    <h2 id="workshop-title" class="section-title">In the workshop</h2>
    <p class="workshop__intro">
      {count} more in development. They're named here because the work is real;
      no dates are promised until they ship.
    </p>
  </header>

  <ul class="workshop__list">
    {items.map((w) => (
      <li class="bench">
        <h3 class="bench__name">
          {w.icon && (
            <Image src={w.icon} alt="" widths={[40, 80]} sizes="40px" format="webp" quality={82} class="bench__icon" loading="lazy" />
          )}
          <a href={`/work/${w.slug}/`}>{w.name}</a>
        </h3>
        <p class="bench__tagline">{w.tagline}</p>
        {w.highlight && <p class="bench__detail">{w.highlight}</p>}
        <p class="bench__meta ui">{w.runsOn.join(', ')}</p>
        <a class="textlink bench__link" href={`/work/${w.slug}/`}>Read the <span class="visually-hidden">{w.name} </span>case study</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .workshop {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-top: 1px solid var(--color-line);
  }

  .workshop__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: clamp(2.25rem, 4vw, 3.25rem);
  }
  .workshop__intro {
    margin: 0;
    max-width: 32em;
    color: var(--color-ink-2);
  }

  .workshop__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .bench {
    display: flex;
    flex-direction: column;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-line-strong);
  }

  .bench__name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-weight: 380;
    font-size: clamp(1.75rem, 2.4vw, 2.125rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .bench__name a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .bench__name a:hover { color: var(--color-amber); }

  :global(.bench__icon) {
    width: 40px;
    height: 40px;
    border-radius: 9px;
    box-shadow: 0 0 0 1px var(--well-ring);
  }

  .bench__tagline {
    margin: 1rem 0 0;
    color: var(--color-ink);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .bench__detail {
    margin: 0.9rem 0 0;
    color: var(--color-ink-2);
    font-size: 1.0625rem;
    line-height: 1.55;
    font-style: italic;
  }

  .bench__meta {
    margin: 1.2rem 0 0;
    color: var(--color-ink-3);
  }

  .bench__link {
    margin-top: auto;
    padding-top: 1.1rem;
    align-self: flex-start;
    font-size: 1rem;
    color: var(--color-ink-2);
  }

  @media (max-width: 900px) {
    .workshop__head { grid-template-columns: 1fr; }
    .workshop__list { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
