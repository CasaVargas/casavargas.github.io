---
import Frame from '../ui/Frame.astro';
import heroShot from '../../assets/beltr/library.webp';
---

<header class="hero">
  <div class="hero__copy">
    <p class="eyebrow">CasaVargas LLC — North Carolina</p>
    <h1>Software you own.</h1>
    <p class="lede">
      An indie studio building native apps for Apple platforms and the desktop.
      Bought once, yours for good — no subscriptions, no rentals, no features
      held hostage.
    </p>
    <div class="hero__actions">
      <a href="#apps" class="btn btn--primary">Browse the apps</a>
      <a href="/blog" class="btn btn--ghost">Read the notes</a>
    </div>
  </div>

  <div class="hero__art">
    <Frame src={heroShot} alt="Beltr music library" width={1200} sizes="(max-width: 900px) 100vw, 58vw" eager />
  </div>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: 3.5rem;
    align-items: center;
    max-width: 84rem;
    margin: 0 auto;
    padding: 5.5rem 2.5rem 4.5rem;
  }

  /* Gives the hero screenshot's edges something to sit against. */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    right: 0;
    top: 6%;
    width: 56%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(239, 159, 39, 0.13) 0%, transparent 62%);
    pointer-events: none;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1.1rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 6.2vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .lede {
    margin: 1.5rem 0 0;
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 34rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.4rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn--primary { background: var(--color-accent); color: #17161a; }
  .btn--ghost {
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 3.5rem 1.5rem 3rem;
    }
    .hero::before { display: none; }
  }
</style>
