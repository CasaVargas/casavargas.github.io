---
import Facts from '../ui/Facts.astro';

const workshop: [string, string][] = [
  ['Apple platforms', 'Swift 6, SwiftUI, SwiftData, Foundation Models'],
  ['Desktop', 'Tauri and Rust; Electron and Python where the job needs them'],
  ['Builds', 'Self-hosted runners on a Mac mini, a Windows PC and a Linux server'],
  ['Infrastructure', 'Docker, Traefik and Tailscale, run in-house'],
  ['Sales', 'The App Store, and Lemon Squeezy for the desktop'],
];
---

<section id="studio" class="studio" aria-labelledby="studio-title">
  <div class="wrap studio__grid">
    <div class="studio__copy">
      <h2 id="studio-title" class="section-title">The studio</h2>
      <p>
        Casa Vargas LLC is Jon Vargas, working from North Carolina. By day, Jon works
        in IT for a public school district. The rest of the time goes into the
        software on this page, from the first specification to the signed installer.
      </p>
      <p>
        There's no team to hand things to, so the whole chain is owned end to end:
        design, code, release engineering, the build machines, the product sites and
        the support inbox.
      </p>
    </div>

    <div class="studio__workshop">
      <h3 class="ui studio__label">The workshop</h3>
      <Facts rows={workshop} />
    </div>
  </div>
</section>

<style>
  .studio {
    border-top: 1px solid var(--color-line);
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .studio__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 3rem clamp(2rem, 6vw, 6rem);
  }

  .studio__copy p {
    margin: 1.4rem 0 0;
    max-width: 33em;
    color: var(--color-ink-2);
  }
  .studio__copy .section-title + p { margin-top: 2rem; }

  .studio__label {
    margin: 0 0 0.9rem;
    font-weight: 500;
    color: var(--color-ink-3);
  }

  .studio__workshop { padding-top: 0.6rem; }

  @media (max-width: 860px) {
    .studio__grid { grid-template-columns: 1fr; }
  }
</style>
