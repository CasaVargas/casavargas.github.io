---
const stack: [string, string][] = [
  ['Apple native', 'SwiftUI · Swift 6 · SwiftData'],
  ['Cross-platform', 'Tauri · Rust · React'],
  ['Infrastructure', 'Docker · Traefik · Tailscale'],
  ['Monetization', 'StoreKit 2 · Lemon Squeezy'],
  ['CI/CD', 'GitHub Actions · Self-hosted'],
];
---

<section id="studio" class="studio">
  <div class="studio__head">
    <p class="eyebrow">The studio</p>
    <h2>One developer, shipping in the open</h2>
  </div>

  <div class="studio__grid">
    <div class="studio__bio">
      <p>
        CasaVargas LLC is a solo studio founded by Jon Vargas in North Carolina.
        Every project starts as a written spec before a line of code gets
        written — the thinking happens up front so the building flows.
      </p>
      <p>
        By day it's K-12 IT for a public school district. By night it's SwiftUI,
        Rust, and a home lab that runs the whole operation. The through-line is
        the same either way: build the thing properly, charge once, and don't
        rent people their own software back to them.
      </p>
    </div>

    <div class="studio__stack">
      <h3>The stack</h3>
      {stack.map(([label, detail]) => (
        <div class="stackrow">
          <span>{label}</span>
          <span class="stackrow__detail">{detail}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .studio {
    padding: 4.5rem 0 5rem;
    border-top: 1px solid var(--color-border-soft);
  }
  .studio__head {
    max-width: 84rem;
    margin: 0 auto;
    padding: 0 2.5rem 2.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1.1rem;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 3.6vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .studio__grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 4rem;
    max-width: 84rem;
    margin: 0 auto;
    padding: 0 2.5rem;
  }
  .studio__bio p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--color-text-secondary);
  }
  .studio__bio p + p { margin-top: 1.1rem; }

  .studio__stack {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.6rem;
    align-self: start;
  }
  .studio__stack h3 {
    margin: 0 0 1rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }
  .stackrow {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.62rem 0;
    border-bottom: 1px solid var(--color-border-soft);
    font-size: 0.85rem;
  }
  .stackrow:last-child { border-bottom: none; }
  .stackrow__detail {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-tertiary);
    text-align: right;
  }

  @media (max-width: 900px) {
    .studio__head { padding: 0 1.5rem 2rem; }
    .studio__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 0 1.5rem;
    }
  }
</style>
