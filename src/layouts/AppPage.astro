---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';
import Frame from '../components/ui/Frame.astro';
import Phone from '../components/ui/Phone.astro';
import { statusLabel, type App } from '../data/apps';

interface Feature {
  title: string;
  desc: string;
}

interface Props {
  app: App;
  title: string;
  description: string;
  ogImage?: string;
  tagline: string;
  intro: string;
  /** Overrides app.platforms when a page needs a longer list. */
  platforms?: string[];
  features: Feature[];
  steps?: Feature[];
  /** Overrides app.shots — the landing pages often show more than the homepage. */
  shots?: ImageMetadata[];
  cta: {
    heading: string;
    body: string;
    label: string;
    url: string;
    secondary?: { label: string; url: string };
  };
  schema: unknown;
}

const {
  app,
  title,
  description,
  ogImage,
  tagline,
  intro,
  platforms = app.platforms,
  features,
  steps,
  shots = app.shots,
  cta,
  schema,
} = Astro.props;
---

<Layout title={title} description={description} ogImage={ogImage}>
  <JsonLd data={schema} />
  <Nav />

  <main>
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: app.name }]} />

      <header class="head">
        <Image
          src={app.icon}
          alt=""
          widths={[80, 160]}
          sizes="80px"
          format="webp"
          quality={80}
          loading="eager"
          class="head__icon"
        />
        <div class="head__text">
          <span class:list={['pill', `pill--${app.status}`]}>{statusLabel[app.status]}</span>
          <h1>{app.name}</h1>
          <p class="tagline">{tagline}</p>
        </div>
      </header>

      <p class="intro">{intro}</p>

      <div class="tags">
        {platforms.map((p) => <span class="tag">{p}</span>)}
      </div>

      <a href={cta.url} class="btn" target="_blank" rel="noopener">{cta.label} &rarr;</a>
    </div>

    {shots.length > 0 && (
      <section class="shots-section">
        <div class="wrap"><h2>Screenshots</h2></div>
        <div class:list={['rail', app.shotKind === 'phone' && 'rail--phones']}>
          {shots.map((shot) =>
            app.shotKind === 'phone' ? (
              <Phone src={shot} alt={`${app.name} screenshot`} />
            ) : (
              <div class="rail__frame">
                <Frame src={shot} alt={`${app.name} screenshot`} width={900} sizes="(max-width: 900px) 88vw, 620px" />
              </div>
            )
          )}
        </div>
      </section>
    )}

    <div class="wrap">
      <section class="block">
        <h2>Features</h2>
        <div class="features">
          {features.map((f) => (
            <div class="feature">
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))}
        </div>
      </section>

      {steps && steps.length > 0 && (
        <section class="block">
          <h2>How it works</h2>
          <ol class="steps">
            {steps.map((s, i) => (
              <li>
                <span class="steps__num">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      <section class="cta">
        <h2>{cta.heading}</h2>
        <p>{cta.body}</p>
        <div class="cta__actions">
          <a href={cta.url} class="btn" target="_blank" rel="noopener">{cta.label} &rarr;</a>
          {cta.secondary && (
            <a href={cta.secondary.url} class="btn btn--ghost" target="_blank" rel="noopener">
              {cta.secondary.label} &rarr;
            </a>
          )}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  main { padding: 7rem 0 6rem; }

  .wrap {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  /* ── Header ── */
  .head {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin: 1.5rem 0 2rem;
  }
  .head :global(.head__icon) {
    width: 80px;
    height: 80px;
    border-radius: 18px;
    flex-shrink: 0;
  }
  .head__text { min-width: 0; }

  .pill {
    display: inline-block;
    margin-bottom: 0.6rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .pill--live   { background: rgba(74, 222, 128, 0.14); color: var(--color-accent-green); }
  .pill--coming { background: rgba(239, 159, 39, 0.16); color: var(--color-accent); }
  .pill--oss    { background: rgba(160, 160, 185, 0.14); color: var(--color-text-secondary); }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .tagline {
    margin: 0.5rem 0 0;
    font-size: 1.05rem;
    color: var(--color-text-secondary);
  }

  .intro {
    margin: 0 0 1.8rem;
    font-size: 1.12rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 42rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 2rem;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-tertiary);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.4rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #17161a;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .btn:hover { transform: translateY(-1px); }

  /* ── Screenshots ── */
  .shots-section {
    margin: 4rem 0;
    padding: 3rem 0;
    background: var(--color-bg-alt);
    border-block: 1px solid var(--color-border-soft);
  }
  .rail {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    /* Align the first item with the .wrap text column, but let the rail
       itself run full-bleed so there is a visible "more to the right". */
    padding-block: 1.5rem 1rem;
    padding-inline: max(2.5rem, calc((100% - 64rem) / 2 + 2.5rem)) 2.5rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail :global(.phone) {
    width: 210px;
    scroll-snap-align: center;
  }
  .rail__frame {
    flex: 0 0 auto;
    width: 620px;
    max-width: 88vw;
    scroll-snap-align: center;
  }

  /* ── Blocks ── */
  .block { margin-bottom: 4rem; }

  h2 {
    margin: 0 0 1.6rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .feature {
    padding: 1.4rem;
    border-radius: 14px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
  }
  .feature h3 {
    margin: 0 0 0.5rem;
    font-size: 0.98rem;
    font-weight: 600;
  }
  .feature p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }
  .steps li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .steps__num {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.85rem;
    font-weight: 600;
    background: rgba(239, 159, 39, 0.12);
    color: var(--color-accent);
  }
  .steps h3 {
    margin: 0 0 0.3rem;
    font-size: 0.98rem;
    font-weight: 600;
  }
  .steps p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .cta {
    text-align: center;
    padding: 2.6rem 2rem;
    border-radius: 16px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
  }
  .cta h2 { margin-bottom: 0.6rem; }
  .cta p {
    margin: 0 0 1.6rem;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .btn--ghost {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    main { padding: 5.5rem 0 4rem; }
    .wrap { padding: 0 1.5rem; }
    .head { gap: 1rem; }
    .head :global(.head__icon) { width: 60px; height: 60px; border-radius: 14px; }
    .features { grid-template-columns: 1fr; }
    .rail { padding-inline: 1.5rem; }
    .rail :global(.phone) { width: 58vw; max-width: 260px; }
  }
</style>
